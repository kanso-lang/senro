import "../web"
import "std/base64"
import "std/list"
import "std/os"
import "std/sha256"
import "std/text"

# Passwords kept the way a database should hold them: never the password,
# only a PBKDF2-SHA-256 digest of it under a salt of sixteen bytes from the
# operating system's secure source. The stored text names everything a later
# check needs, so the rounds can change without breaking the digests already
# kept:
#
#   pbkdf2-sha256$<rounds>$<salt, base64>$<digest, base64>
#
# `digested` is a description, because drawing the salt is an effect. It
# stretches the password by `SENRO_PASSWORD_ROUNDS` rounds when the
# environment sets it, and by `default_rounds` when it does not. A
# development setup or a spec lowers it to sign in quickly; the digests it
# writes say so, and are checked at their own rounds.
pub fn digested password
  os/env "SENRO_PASSWORD_ROUNDS" .> (r -> digested_at (rounds_of r) password)

# The same, at rounds the caller names.
pub fn digested_at rounds password
  os/random_bytes 16 .> (salt -> stored rounds password (list/to_list salt))

# OWASP asks 600,000 rounds of PBKDF2-SHA-256 (2023). A release build of
# kanso stretches 100,000 in 0.22 s, where OpenSSL takes 0.025 s, so 600,000
# would hold a sign-in for well over a second; the default is a sixth of that
# until kanso catches up (kanso#2304). `kanso run` builds at the development
# tier, which takes 3.0 s for 100,000, so a development setup sets the rounds
# lower.
pub default_rounds = 100000

fn rounds_of none
  default_rounds

fn rounds_of r
  given (text/to_int r)

fn given none
  default_rounds

fn given n
  if (n < 1) default_rounds n

fn stored rounds password salt
  d = sha256/pbkdf2 (text/bytes password) salt rounds 32
  "pbkdf2-sha256${rounds}${base64/encode salt}${base64/encode d}"

# A digest whose bytes are all zero, which no password's is, to check a
# password against when there is no account to check it against. It is a
# description, like `digested`, and names the same rounds, so the check costs
# what a real one costs and how long a refusal takes does not say whether the
# account exists.
pub stand_in = os/env "SENRO_PASSWORD_ROUNDS"
  .> (r -> effect (stand_in_at (rounds_of r)))

# The same, at rounds the caller names.
pub fn stand_in_at rounds
  "pbkdf2-sha256${rounds}${zeros 16}${zeros 32}"

fn zeros n
  base64/encode (list/to_list (list/take (list/repeat 0) n))

# Whether `password` is the one `kept` was digested from. A digest this
# module did not write matches nothing. The two digests are compared over
# every byte, whichever differs first, so the time a refusal takes says
# nothing about how much of a guess was right.
pub fn matches? password kept
  parts = text/split kept "$"
  return false if length parts != 4
  return false if parts[1] != "pbkdf2-sha256"
  rounds = text/to_int parts[2]
  salted? password rounds (base64/decode parts[3]) parts[4]

fn salted? _ _ none _
  false

fn salted? password rounds salt want
  wanted? password rounds (list/to_list salt) (base64/decode want)

fn wanted? _ _ _ none
  false

fn wanted? password rounds salt want
  agree? password rounds salt (list/to_list want)

fn agree? password rounds salt want
  return false if rounds < 1 or length want == 0
  got = sha256/pbkdf2 (text/bytes password) salt rounds (length want)
  pairs = list/to_list (list/zip got want)
  list/count pairs (p -> p[1] != p[2]) == 0

# A token that lets whoever reads an account's mail choose a new password,
# as Rails 8's `generates_token_for :password_reset` makes one. It names the
# account, the moment it stops working, and a signature over both and the
# digest the account keeps now:
#
#   <id>.<expiry, in milliseconds since the epoch>.<HMAC-SHA-256, in hex>
#
# Nothing is stored. Setting a new password changes the digest, so a token
# works once, and it stops working `reset_minutes` after it was made. It is
# made of digits, dots and hex, so it sits in a URL's path as it is.
pub reset_minutes = 15

pub fn reset_token secret id kept t
  until = t + reset_minutes * 60000
  "{id}.{until}.{reset_signature secret id until kept}"

fn reset_signature secret id until kept
  said = text/bytes "reset {id} {until} {kept}"
  web/hexed (sha256/hmac (text/bytes secret) said)

# The account a token names, to look up its digest, or none for text that is
# no token. It says nothing about whether the token is good.
pub fn reset_id token
  parts = text/split token "."
  return none if length parts != 3
  text/to_int (list/first parts)

# Whether `token` was made under `secret` for the account whose digest is
# `kept` now, and is still in time at `t`. The signatures are compared over
# every byte, as `matches?` compares digests.
pub fn reset_valid? secret token kept t
  parts = text/split token "."
  return false if length parts != 3
  id = number_of (text/to_int (list/first parts))
  middle = list/first (list/to_list (list/drop parts 1))
  until = number_of (text/to_int middle)
  return false if t > until
  want = list/to_list (text/bytes (reset_signature secret id until kept))
  got = list/to_list (text/bytes (signature_of (list/last parts)))
  return false if length want != length got
  list/count (list/to_list (list/zip want got)) (p -> p[1] != p[2]) == 0

# A part that is no number reads as 0: as an expiry it has passed, and as an
# id it names no account the signature was made for.
fn number_of none
  0

fn number_of n
  n

fn signature_of none
  ""

fn signature_of s
  s
