takes topics viewer reading
if viewer.name != ""
  p.hello Signed in as {viewer.name}
== reading
ul.topics
  each topics t ->
    li.topic id="topic-{t.id}"
      h2
        a href="/topics/{t.id}" = t.title
      p.by by {t.author.name} ({t.author.karma}) on {t.posted}
      p.excerpt = t.excerpt
      if t.pinned
        em pinned
      span.replies {t.replies} replies
      ul.tags
        each t.tags g ->
          li = g
p.count {length topics} topics
