import "std/list"
import "std/text"

# A template line: where it sits in the file, how deep it is indented, and
# what follows the indent.
type row
  line
  depth
  body

# One piece of a generated string literal. Markup arrives a character at a
# time, already escaped for a kanso string; a hole splices an expression in
# and remembers its template line, so the generated file can point back.
type unit
  text
  line
  hole

# What a run of rows compiles to: the pieces of its string, and the helper
# functions its control lines asked for.
type woven
  units
  helpers

# A step answers what it wove and the row the walk resumes at.
type stepped
  done
  next

# A helper function's call, without parentheses, and every helper function
# written on the way to it, its own source among them.
type helped
  call
  helpers

# An `if` expression a branch compiles to, the helpers its arms became, the
# row after the last of its branches, and the test and the two arms apart,
# for a branch too long to sit in its line.
type forked
  test
  helpers
  next
  asked
  shown
  other

# The test and the first arm of a branch, carried into the `else if` after it.
type arm
  asked
  shown

# A `when` under a `case`: the value it matches, the call its rows became,
# the helpers they asked for, and its template line.
type chosen
  pattern
  call
  helpers
  line

type packing
  chunks
  current
  width

# A tag's name, the start of its opening tag with any id its shorthand
# spelled, and the shorthand's classes, which a `class` attribute joins.
type shaped
  name
  open
  classes

# The template's name, which prefixes every helper; the file it came from,
# which the generated comments cite; and whether this compile reads its
# values as JSON decoded them, with each record a map of its fields.
type origin
  name
  file
  keyed

# What a scan of an expression found: its text with every field read written
# as `(kata_at e "name")`, and each chain of reads it rewrote, such as
# `post.author.name`. Only code is read; the text of a string literal is
# copied, though the code in its `{}` holes is not.
type reading
  text
  chains

# The template line each path is first read on, while the compiled source is
# scanned: the paths so far and the line the last `# from` comment named.
type sited
  lines
  at

# Those first lines, and the template file they are lines of.
type lined
  lines
  file

# How a value travels (kanso#2416): the function that writes one onto the
# bytes, the function that reads one back, and every type and helper those
# two lean on, as source: the packer's helpers, the reader's, and the types
# of the records the reader builds.
type borne
  pack
  read
  packers
  readers
  kinds

# The kanso source for template `name`, read from `file`, whose text is
# `src`. The first line may say what the template takes, which become the
# function's parameters in the order written.
pub fn compiled name file src
  written "pub fn" name (origin name file false) src

# The same template compiled to read what JSON decoded: `{name}_keyed`, a
# private function of the same parameters, in which `e.name` reads the key
# `name` of a map. The browser renders a page with it from the data the
# server sent, and the server renders the first request with it too. Its
# helpers are named `{name}_k` and a line number, kept short because each
# hole must fit on a line of the source kata writes.
pub fn keyed name file src
  written "fn" "{name}_keyed" (origin "{name}_k" file true) src

fn written kind head o src
  rows = rows_of src
  declared = takes_of rows
  from = if (length declared == 0) 1 2
  w = walk rows from (length rows + 1) declared o (woven [] [])
  main = emitted "{kind} {head} {params_of declared}" w.units o
  # The parameters come from the `takes` line, the template's first.
  headed = if (length declared == 0) main "# from {o.file}:1\n{main}"
  "{text/join (push w.helpers headed) "\n\n"}\n"

fn rows_of src
  numbered (text/split src "\n") 1 []

fn numbered lines i acc
  return acc if i < 1 or length lines < i
  numbered lines (i + 1) (kept_row acc lines[i] i)

fn kept_row acc l i
  trimmed = text/trim l
  return acc if trimmed == ""
  push acc (row i (spaces (text/chars l) 1) trimmed)

fn spaces cs i
  return i - 1 if i < 1 or length cs < i
  if (cs[i] == " ") (spaces cs (i + 1)) (i - 1)

fn takes_of rows
  return [] if length rows < 1
  first_body = rows[1].body
  return [] if not text/starts_with? first_body "takes "
  words (after first_body 6)

fn words s
  list/to_list (list/select (text/split s " ") (w -> w != ""))

fn after b n
  remainder (text/slice b (n + 1) (length b))

fn remainder none
  ""

fn remainder s
  s

fn params_of names
  if (length names == 0) "_" (text/join names " ")

fn walk rows i stop scope o acc
  return acc if stop <= i or i < 1 or length rows < i
  r = rows[i]
  last = block_end rows (i + 1) stop r.depth
  s = step rows r i last stop scope o acc
  walk rows s.next stop scope o s.done

fn block_end rows j stop d
  return j if stop <= j or j < 1 or length rows < j
  if (rows[j].depth <= d) j (block_end rows (j + 1) stop d)

fn step rows r i last stop scope o acc
  b = r.body
  at = r.line
  return stepped acc last if b == "#" or text/starts_with? b "# "
  doctype = lit acc "<!DOCTYPE html>" at
  return stepped doctype last if b == "doctype html"
  if_line = text/starts_with? b "if "
  return branched rows r i last stop scope o acc if if_line
  case_line = text/starts_with? b "case "
  return stepped (cased rows r i last scope o acc) last if case_line
  each_line = text/starts_with? b "each "
  return stepped (looped rows r i last scope o acc) last if each_line
  for_line = text/starts_with? b "for "
  return stepped (no_for rows r i last scope o acc) last if for_line
  raw_line = text/starts_with? b "== "
  return stepped (spliced acc (raw (after b 3) o) at) last if raw_line
  out_line = text/starts_with? b "= "
  return stepped (spliced acc (escaped (after b 2)) at) last if out_line
  return stepped (texted acc (after b 2) at) last if text/starts_with? b "| "
  stepped (tagged rows r i last scope o acc) last

# `if` takes the rows indented under it. An `else if` at its own depth right
# after them chains another test, and an `else` takes what is left.
fn branched rows r i last stop scope o acc
  f = forked_at rows r i last stop scope o
  helpers = list/concat acc.helpers f.helpers
  hole = unit "\{{f.test}}" r.line true
  fits = length hole.text <= 74
  return stepped (woven (push acc.units hole) helpers) f.next if fits
  apart = branch_apart f scope o r.line
  units = push acc.units (unit "\{{apart.call}}" r.line true)
  stepped (woven units (push helpers apart.helpers)) f.next

# A branch too long for the line its string gives it, as a function of the
# names it reads: the test and each arm bound on a line of their own, so the
# derived code keeps to 80 columns. `apart.call` calls it.
fn branch_apart f scope o line
  args = free_in [(unit "\{{f.test}}" line true)] scope
  called = "{o.name}_{line}_if"
  given = if (length args == 0) "none" (text/join args " ")
  lines = [
    "fn {called} {params_of args}"
    "  kata_test = {f.asked}"
    "  kata_yes = {f.shown}"
    "  kata_no = {f.other}"
    "  if kata_test kata_yes kata_no"
  ]
  helped "{called} {given}" (text/join lines "\n")

fn forked_at rows r i last stop scope o
  from = if (text/starts_with? r.body "else if ") 8 3
  yes = helper rows (i + 1) last scope o r.line
  asked = after r.body from
  head = "if {wrapped asked} {wrapped yes.call}"
  kind = follower rows last r
  bare = "\"\""
  yes_only = forked "{head} {bare}" yes.helpers last asked yes.call bare
  return yes_only if kind == ""
  past = block_end rows (last + 1) stop r.depth
  arms = arm asked yes.call
  return chained rows last past stop scope o head yes arms if kind == "else if"
  no = helper rows (last + 1) past scope o (rows_line rows last)
  both = list/concat yes.helpers no.helpers
  forked "{head} {wrapped no.call}" both past asked yes.call no.call

fn chained rows j past stop scope o head yes a
  bare = "\"\""
  last_arm = forked "{head} {bare}" yes.helpers j a.asked a.shown bare
  return last_arm if j < 1 or length rows < j
  sub = forked_at rows rows[j] j past stop scope o
  both = list/concat yes.helpers sub.helpers
  short = forked "{head} ({sub.test})" both sub.next a.asked a.shown sub.test
  return short if length sub.test <= 60
  apart = branch_apart sub scope o (rows_line rows j)
  called = "({apart.call})"
  helpers = push both apart.helpers
  forked "{head} {called}" helpers sub.next a.asked a.shown apart.call

fn follower rows j r
  return "" if j < 1 or length rows < j
  return "" if rows[j].depth != r.depth
  b = rows[j].body
  return "else" if b == "else"
  if (text/starts_with? b "else if ") "else if" ""

fn rows_line rows j
  return 0 if j < 1 or length rows < j
  rows[j].line

# `case expr` takes `when value` rows indented under it, each with the rows
# under it, and an `else` that takes any other value. A value is matched as
# a function's argument is: a string, a number, true, false or none. A value
# no `when` names writes the `else` rows, or nothing when there is none. The
# case compiles to a function with an arm for each `when`, which binds only
# the names that arm's rows read.
fn cased rows r i last scope o acc
  arms = whens rows (i + 1) last scope o []
  called = "{o.name}_{r.line}_case"
  calls = list/map arms (a -> unit "\{{a.call}}" r.line true)
  args = free_in (list/to_list calls) scope
  open = list/any? arms (a -> a.pattern == "_")
  closing = if open [] [(chosen "_" "\"\"" [] r.line)]
  every = list/concat arms closing
  arm_lines = list/to_list (list/map every (a -> case_arm called args a o))
  source = text/join arm_lines "\n\n"
  helpers = list/fold arms acc.helpers (h a -> list/concat h a.helpers)
  subject = wrapped (after r.body 5)
  given = list/fold args "{called} {subject}" (c n -> "{c} {n}")
  hole = unit "\{{given}}" r.line true
  fits = length hole.text <= 74
  return woven (push acc.units hole) (push helpers source) if fits
  apart = case_apart called subject args o r.line
  units = push acc.units (unit "\{{apart.call}}" r.line true)
  woven units (list/concat helpers [source apart.helpers])

# A case whose call is too long for its line, as a function of the names it
# reads, with the value it matches bound on a line of its own.
fn case_apart called subject args o line
  outer = "{o.name}_{line}_on"
  given = if (length args == 0) "none" (text/join args " ")
  inner = list/fold args "{called} kata_on" (c n -> "{c} {n}")
  held = "  kata_on = {subject}"
  lines = ["fn {outer} {params_of args}" held "  {inner}"]
  helped "{outer} {given}" (text/join lines "\n")

fn whens rows j last scope o acc
  return acc if last <= j or j < 1 or length rows < j
  w = rows[j]
  past = block_end rows (j + 1) last w.depth
  body = helper rows (j + 1) past scope o w.line
  this = chosen (matched_by w.body) body.call body.helpers w.line
  next = push acc this
  whens rows past last scope o next

fn matched_by "else"
  "_"

# A row under a `case` is a `when` or the `else`. Any other is written as a
# name its arm never reads, which kanso refuses at that row's template line.
fn matched_by b
  return after b 5 if text/starts_with? b "when "
  "a_row_under_case_is_when_or_else"

# One arm, under the template line of its `when`: the value, then each name
# the case reads, bound when this arm's rows read it and left unbound when
# they do not.
fn case_arm called args a o
  read = text/split a.call " "
  bound = list/map args (n -> if (list/any? read (w -> w == n)) n "_")
  head = text/join (list/concat [called a.pattern] (list/to_list bound)) " "
  "# from {o.file}:{a.line}\nfn {head}\n  {a.call}"

# `each xs x ->` writes the rows under it once for each element of `xs`,
# with `x` in scope: kanso's `each xs (x -> ...)`, with the rows as the
# function's body.
fn looped rows r i last scope o acc
  ws = words (after r.body 5)
  n = length ws
  return acc if n < 3 or ws[n] != "->"
  over = text/join (list/to_list (list/take ws (n - 2))) " "
  walked "each" (named ws[n - 1]) over rows r i last scope o acc

fn named none
  "_"

fn named word
  word

fn walked by name over rows r i last scope o acc
  body = helper rows (i + 1) last (push scope name) o r.line
  bound = if (list/any? (text/split body.call " ") (w -> w == name)) name "_"
  listed = if o.keyed "(kata_items {wrapped over})" (wrapped over)
  hole = "\{{by} {listed} ({bound} -> {body.call})}"
  helpers = list/concat acc.helpers body.helpers
  woven (push acc.units (unit hole r.line true)) helpers

# kanso has no `for`, and neither has kata. A `for x in xs` row is written
# as a call to a name nothing defines, which kanso refuses at that row's
# template line.
fn no_for rows r i last scope o acc
  ws = words (after r.body 4)
  return acc if length ws < 3
  over = text/join (list/to_list (list/drop ws 2)) " "
  wrong = "kata_has_no_for_write_each_xs_x"
  walked wrong (named ws[1]) over rows r i last scope o acc

# The rows from `from` up to `to` become a function of the names in scope
# they mention, so a branch or a loop body reads exactly what it uses. Rows
# that mention none become a constant.
fn helper rows from to scope o line
  body = walk rows from to scope o (woven [] [])
  args = free_in body.units scope
  called = "{o.name}_{line}"
  head = if (length args == 0) "{called} =" "fn {called} {params_of args}"
  source = emitted head body.units o
  helped (call_of called args) (push body.helpers source)

fn call_of called args
  if (length args == 0) called "{called} {text/join args " "}"

fn lit acc s at
  woven (list/concat acc.units (marked s at)) acc.helpers

fn marked s at
  list/to_list (list/map (text/chars s) (c -> unit (quoted c) at false))

fn quoted "\\"
  "\\\\"

fn quoted "\""
  "\\\""

fn quoted "\{"
  "\\\{"

fn quoted c
  c

fn spliced acc hole at
  woven (push acc.units (unit hole at true)) acc.helpers

# Markup spliced in as it is, through `kata_raw`, which draws a page within
# the page, such as a layout's body, where it is spliced.
fn raw e _
  "\{kata_raw {wrapped e}}"

fn escaped e
  "\{escape {wrapped e}}"

# An expression passed as an argument needs parentheses when it has a space
# outside every bracket and string literal, and is refused with them when it
# does not.
fn wrapped e
  if (spaced? (text/chars e) 1 ["code"]) "({e})" e

fn spaced? cs i modes
  return false if i < 1 or length cs < i
  c = cs[i]
  next = i + 1
  text_mode = top modes == "text"
  return spaced? cs (i + 2) modes if text_mode and c == "\\"
  return spaced? cs next (push modes "code") if text_mode and c == "\{"
  return spaced? cs next (popped modes) if text_mode and c == "\""
  return spaced? cs next modes if text_mode
  return true if c == " " and length modes == 1
  opens = c == "(" or c == "[" or c == "\{"
  return spaced? cs next (push modes "code") if opens
  closes = c == ")" or c == "]" or c == "}"
  return spaced? cs next (popped modes) if closes
  return spaced? cs next (push modes "text") if c == "\""
  spaced? cs next modes

# Text with `{expr}` in it, as a kanso string has: the markup is copied and
# each expression is escaped into the page. `\{` is a brace.
fn texted acc s at
  parts = text/split s "\\\{"
  return acc if length parts < 1
  start = holed acc parts[1] at
  list/fold (list/drop parts 1) start (a p -> holed (lit a "\{" at) p at)

fn holed acc s at
  pieces = text/split s "\{"
  return acc if length pieces < 1
  start = lit acc pieces[1] at
  list/fold (list/drop pieces 1) start (a p -> interpolated a p at)

fn interpolated acc p at
  halves = text/split p "}"
  return lit acc "\{{p}" at if length halves < 2
  tail = text/join (list/to_list (list/drop halves 1)) "}"
  lit (spliced acc (escaped halves[1]) at) tail at

# A tag line: `tag.class#id attr=value attr="text"`, then `= expr`,
# `== expr` or text on the same line, then the rows indented under it.
fn tagged rows r i last scope o acc
  ws = text/split r.body " "
  return acc if length ws < 1
  head = shorthand ws[1]
  tail = text/join (list/to_list (list/drop ws 1)) " "
  started = lit acc head.open r.line
  opened = attributes tail head.classes started r.line o
  inner = walk rows (i + 1) last scope o opened
  closing = if (void? head.name) "" "</{head.name}>"
  lit inner closing r.line

fn shorthand h
  pieces = text/split (text/join (text/split h "#") ".#") "."
  return shaped "div" "<div" [] if length pieces < 1
  tag = if (pieces[1] == "") "div" pieces[1]
  marks = list/to_list (list/drop pieces 1)
  ids = list/to_list (list/select marks (m -> text/starts_with? m "#"))
  classes = list/to_list (list/select marks (m -> not id? m))
  shaped tag "<{tag}{named "id" (stripped ids)}" classes

fn id? m
  text/starts_with? m "#"

fn stripped ids
  list/to_list (list/map ids (m -> after m 1))

fn named key vals
  return "" if length vals == 0
  " {key}=\"{text/join vals " "}\""

voids = ["area" "base" "br" "col" "hr" "img" "input" "link" "meta" "source"]

fn void? name
  list/any? voids (v -> v == name)

# The words after a tag's head: attributes while they last, then the tag's
# own content. A `class` attribute is joined onto the shorthand's classes,
# and classes nothing joined are written when the tag closes.
fn attributes rest classes acc at o
  s = text/trim rest
  first = first_word s
  shut_tag = lit acc "{named "class" classes}>" at
  return content s shut_tag at o if not attribute? first
  halves = text/split s "="
  return acc if length halves < 1
  key = halves[1]
  value = text/join (list/to_list (list/drop halves 1)) "="
  return event key value classes acc at o if text/starts_with? key "on-"
  joins = key == "class" and length classes > 0
  lead = if joins "{text/join classes " "} " ""
  left = if joins [] classes
  opened = lit acc " {key}=\"{lead}" at
  return lettered value left opened at o if text/starts_with? value "\""
  word = first_word value
  shut = lit (spliced opened (escaped word) at) "\"" at
  attributes (after value (length word)) left shut at o

# `on-click=increment` binds an event to an action of the component, by
# name: the page's script reads `data-on-click` and asks the component's
# `act` for `increment`.
fn event key value classes acc at o
  word = first_word value
  named_it = lit acc " data-{key}=\"{word}\"" at
  attributes (after value (length word)) classes named_it at o

# The actions a template binds, each once, in the order first written.
pub fn actions src
  pieces = text/split (text/join (text/split src "\n") " ") " "
  bound_words = list/select pieces (w -> text/starts_with? w "on-")
  names = list/map bound_words (w -> action_of (text/split w "="))
  list/fold names [] (acc n -> if (n == "" or has? acc n) acc (push acc n))

fn action_of parts
  if (length parts < 2) "" parts[2]

fn has? xs x
  list/any? xs (y -> y == x)

# What a template takes, as its first line says.
pub fn takes src
  takes_of (rows_of src)

# A quoted value is text, with `{expr}` holes like any other.
fn lettered value classes acc at o
  pieces = text/split (after value 1) "\""
  return acc if length pieces < 1
  shut = lit (texted acc pieces[1] at) "\"" at
  tail = text/join (list/to_list (list/drop pieces 1)) "\""
  attributes tail classes shut at o

fn first_word s
  ws = text/split s " "
  return "" if length ws < 1
  ws[1]

fn attribute? w
  halves = text/split w "="
  return false if length halves < 2
  halves[1] != "" and list/all? (text/chars halves[1]) (c -> key_char? c)

fn key_char? c
  length (text/split "abcdefghijklmnopqrstuvwxyz-" c) > 1

fn content "" acc _ _
  acc

fn content s acc at o
  return spliced acc (raw (after s 3) o) at if text/starts_with? s "== "
  return spliced acc (escaped (after s 2)) at if text/starts_with? s "= "
  texted acc s at

# A function's source: its head, then its units packed into string literals
# short enough for the line, each preceded by the template lines its holes
# came from.
fn emitted head units o
  chunks = packed (list/to_list (list/map units (u -> read_as u o)))
  return constant_of head chunks o if text/ends_with? head " ="
  "{head}\n{body_of chunks o}"

fn constant_of head chunks o
  return "{head} \"\"" if length chunks < 1
  one = "{head} {literal chunks[1]}"
  fits = length chunks == 1 and length one <= 80
  return "{cited chunks[1] o ""}{one}" if fits
  lines = list/to_list (list/map chunks (c -> element c o "  "))
  "{head} joined [\n{text/join lines "\n"}\n]"

fn body_of chunks o
  return "  \"\"" if length chunks < 1
  return "{cited chunks[1] o "  "}  {literal chunks[1]}" if length chunks == 1
  lines = list/to_list (list/map chunks (c -> element c o "    "))
  "  joined [\n{text/join lines "\n"}\n  ]"

fn element c o indent
  "{cited c o indent}{indent}{literal c}"

fn literal chunk
  "\"{text/join (list/to_list (list/map chunk (u -> u.text))) ""}\""

# The template line a literal's holes came from, in the form kanso reads
# back when it reports a mistake in one (kanso#2380). A literal holds the
# holes of one line, because packing breaks between lines.
fn cited chunk o indent
  holes = list/to_list (list/select chunk (u -> u.hole))
  return "" if length holes == 0
  "{indent}# from {o.file}:{holes[1].line}\n"

fn distinct ns acc
  list/fold ns acc (a n -> if (list/any? a (m -> m == n)) a (push a n))

fn packed units
  p = list/fold units (packing [] [] 0) (p u -> packed_one p u)
  if (length p.current == 0) p.chunks (push p.chunks p.current)

# A full chunk breaks after its last tag, space or hole, so a word is not cut
# in two; a chunk with none of those breaks where it is. A hole from another
# template line than a hole already in the chunk starts a chunk of its own,
# so each literal is cited to one line.
fn packed_one p u
  w = length u.text
  return packing (push p.chunks p.current) [u] w if crossed? p.current u
  return packing p.chunks (push p.current u) (p.width + w) if p.width + w <= 72
  return packing p.chunks [u] w if length p.current == 0
  k = break_at p.current (length p.current)
  kept = list/to_list (list/take p.current k)
  carried = push (list/to_list (list/drop p.current k)) u
  packing (push p.chunks kept) carried (width_of carried)

fn crossed? cs u
  u.hole and list/any? cs (c -> c.hole and c.line != u.line)

fn break_at cs i
  return length cs if i < 1 or length cs < i
  u = cs[i]
  if (u.hole or u.text == ">" or u.text == " ") i (break_at cs (i - 1))

fn width_of us
  list/fold us 0 (n u -> n + length u.text)

# The names in `scope` that the holes mention, in scope order.
fn free_in units scope
  holes = list/to_list (list/select units (u -> u.hole))
  seen = list/fold holes [] (a u -> list/concat a (idents u.text))
  list/to_list (list/select scope (n -> list/any? seen (m -> m == n)))

fn idents s
  scanned (text/chars s) 1 "" "" ["code"] []

# `cur` is the name being read and `before` the character in front of it, so
# a field after `.` and a module before `/` are not taken for names. `modes`
# says what the scan is inside, innermost last: code, or a string literal,
# whose `{` opens code again until its `}`.
fn scanned cs i cur before modes acc
  return ended acc cur before "" if i < 1 or length cs < i
  return in_text cs i modes acc if top modes == "text"
  c = cs[i]
  next = i + 1
  return scanned cs next "{cur}{c}" before modes acc if name_char? c
  closed_name = ended acc cur before c
  return scanned cs next "" "" (push modes "text") closed_name if c == "\""
  return scanned cs next "" c (push modes "code") closed_name if c == "\{"
  return scanned cs next "" c (popped modes) closed_name if c == "}"
  scanned cs next "" c modes closed_name

# Inside a string literal a `\` escapes the character after it, `{` opens
# code, and `"` closes the literal.
fn in_text cs i modes acc
  return acc if i < 1 or length cs < i
  c = cs[i]
  return scanned cs (i + 2) "" "" modes acc if c == "\\"
  return scanned cs (i + 1) "" "\{" (push modes "code") acc if c == "\{"
  return scanned cs (i + 1) "" "" (popped modes) acc if c == "\""
  scanned cs (i + 1) "" "" modes acc

fn top modes
  return "code" if length modes < 1
  modes[length modes]

fn popped modes
  return ["code"] if length modes < 2
  list/to_list (list/take modes (length modes - 1))

fn ended acc "" _ _
  acc

fn ended acc cur before after_it
  skip = before == "." or before == "/" or after_it == "/"
  if (skip or digit? cur) acc (push acc cur)

fn digit? s
  cs = text/chars s
  return false if length cs < 1
  length (text/split "0123456789" cs[1]) > 1

fn name_char? c
  letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?!"
  length (text/split letters c) > 1

# In the keyed compile a hole's field reads become reads of a map's keys.
fn read_as u o
  return u if not o.keyed or not u.hole
  unit (scanned_reads u.text).text u.line true

fn scanned_reads s
  rewritten (text/chars s) 1 ["code"] (reading "" [])

fn rewritten cs i modes acc
  return acc if i < 1 or length cs < i
  c = cs[i]
  next = i + 1
  return in_literal cs i modes acc if top modes == "text"
  return chained cs i modes acc if starts_name? c and not after_name? cs i
  return rewritten cs next (push modes "code") (on acc c) if c == "\{"
  return rewritten cs next (popped modes) (on acc c) if c == "}"
  return rewritten cs next (push modes "text") (on acc c) if c == "\""
  rewritten cs next modes (on acc c)

# Inside a string literal a `\` escapes the character after it, `{` opens
# code, and `"` closes the literal.
fn in_literal cs i modes acc
  return acc if i < 1 or length cs < i
  c = cs[i]
  next = i + 1
  pair = "{c}{char_at cs next}"
  return rewritten cs (i + 2) modes (on acc pair) if c == "\\"
  return rewritten cs next (push modes "code") (on acc c) if c == "\{"
  return rewritten cs next (popped modes) (on acc c) if c == "\""
  rewritten cs next modes (on acc c)

fn on acc s
  reading "{acc.text}{s}" acc.chains

fn chained cs i modes acc
  j = name_end cs i
  name = word_from cs i j
  fields_after cs i j modes acc name name

# A read stands bare where it is the whole of a hole, a bracket or a group,
# or an operand of a binary operator there, since a call binds tighter than
# any operator. Anywhere else, such as an argument, it is in parentheses.
fn fields_after cs i j modes acc expr chain
  more = char_at cs j == "." and starts_name? (char_at cs (j + 1))
  return rewritten cs j modes (on acc expr) if not more and chain == expr
  whole = alone? cs i j
  shown = if whole expr "({expr})"
  ended_here = reading "{acc.text}{shown}" (push acc.chains chain)
  return rewritten cs j modes ended_here if not more
  k = name_end cs (j + 1)
  f = word_from cs (j + 1) k
  read = "kata_at {wrapped expr} \"{f}\""
  fields_after cs i k modes acc read "{chain}.{f}"

fn alone? cs i j
  before = char_at cs (i - 1)
  opened = list/any? ["" "\{" "(" "["] (c -> c == before)
  closed = list/any? ["" "}" ")" "]"] (c -> c == char_at cs j)
  left = opened or operator? (word_before cs (i - 2))
  left and (closed or operator? (word_after cs (j + 1)))

binary_operators = ["==" "!=" "<" "<=" ">" ">=" "+" "-" "*" "/" "and" "or"]

fn operator? word
  list/any? binary_operators (o -> o == word)

# The word that ends at `i`, after a space, or "" when the space is missing.
fn word_before cs i
  return "" if char_at cs (i + 1) != " "
  word_from cs (spaced_from cs i) (i + 1)

fn spaced_from cs i
  return i + 1 if i < 1 or cs[i] == " "
  spaced_from cs (i - 1)

# The word that starts at `j`, before a space, or "" when the space is
# missing.
fn word_after cs j
  return "" if char_at cs (j - 1) != " "
  ends = spaced_to cs j
  return "" if char_at cs ends != " "
  word_from cs j ends

fn spaced_to cs j
  return j if length cs < j or cs[j] == " "
  spaced_to cs (j + 1)

fn name_end cs i
  return i if i < 1 or length cs < i
  if (name_char? cs[i]) (name_end cs (i + 1)) i

fn word_from cs i j
  text/join (list/to_list (list/take (list/drop cs (i - 1)) (j - i))) ""

fn char_at cs i
  return "" if i < 1 or length cs < i
  cs[i]

fn starts_name? c
  c != "" and length (text/split name_starts c) > 1

name_starts = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

fn after_name? cs i
  before = char_at cs (i - 1)
  before == "." or before == "/" or (before != "" and name_char? before)

# The fields a template reads from each value it takes, as paths:
# `post.title` for a field of a record and `posts.[].title` for a field of
# each record in a list. A loop's name stands for an element of what it
# walks, so `each signatures e ->` and then `e.name` read
# `signatures.[].name`. The reads are found in the template compiled, where
# markup is string text and only expressions are code.
pub fn reads src
  rows = rows_of src
  declared = takes_of rows
  loops = list/fold rows {} looped_over
  code = list/reject (text/split (compiled "kata" "" src) "\n") commented?
  found = (scanned_reads (text/join (list/to_list code) "\n")).chains
  paths = list/map found (c -> resolved c loops declared 0)
  distinct (list/to_list (list/reject paths (p -> p == ""))) []

fn commented? l
  text/starts_with? (text/trim l) "#"

# The template line each path in `reads` is first read on. The compiled
# source cites its lines in `# from` comments (kanso#2380), so each line of
# code is scanned under the last line such a comment named.
fn read_lines src
  rows = rows_of src
  declared = takes_of rows
  loops = list/fold rows {} looped_over
  code = text/split (compiled "kata" "" src) "\n"
  (list/fold code (sited {} 1) (s l -> sited_on s l loops declared)).lines

fn sited_on s l loops declared
  t = text/trim l
  return sited s.lines (cited_line t) if text/starts_with? t "# from "
  return s if commented? l
  found = (scanned_reads l).chains
  paths = list/map found (c -> resolved c loops declared 0)
  sited (list/fold paths s.lines (m p -> first_at m p s.at)) s.at

fn first_at m "" _
  m

fn first_at m p at
  if (m[p] == none) (put m p at) m

fn cited_line t
  ws = text/split t ":"
  number_of ws[length ws]

fn number_of none
  1

fn number_of s
  or_one (text/to_int s)

fn or_one none
  1

fn or_one n
  n

fn looped_over acc r
  return acc if not text/starts_with? r.body "each "
  ws = words (after r.body 5)
  return acc if length ws != 3 or ws[3] != "->"
  put acc ws[2] ws[1]

# A chain of reads as a path from what the template takes, or "" when it
# starts from a name the template neither takes nor binds in a loop.
fn resolved chain loops declared depth
  parts = text/split chain "."
  return "" if length parts < 1
  root = parts[1]
  rest = list/to_list (list/drop parts 1)
  return chain if has? declared root
  return "" if depth > length loops
  looped_from loops[root] rest loops declared depth

fn looped_from none _ _ _ _
  ""

fn looped_from over rest loops declared depth
  base = resolved over loops declared (depth + 1)
  return "" if base == ""
  text/join (list/concat ["{base}.[]"] rest) "."

# The paths under `name`, with `name.` taken off.
fn under paths name
  lead = "{name}."
  inside = list/select paths (p -> text/starts_with? p lead)
  list/to_list (list/map inside (p -> after p (length lead)))

fn first_step p
  (text/split p ".")[1]

fn rest_of p
  text/join (list/to_list (list/drop (text/split p ".") 1)) "."

# The `# from` line above a field's binding: the first template line that
# reads the field or anything beneath it.
fn first_cited subs f at path
  mine = list/select subs (s -> first_step s == f)
  found = list/map mine (s -> at.lines["{path}.{s}"])
  ns = list/to_list (list/reject found (n -> n == none))
  return "" if length ns == 0
  "  # from {at.file}:{list/fold ns ns[1] (a n -> if (n < a) n a)}\n"

# A map literal on one line when it fits in 80 columns, and an entry to a
# line when it does not, as the formatter asks.
fn map_literal pairs lead indent
  line = "{lead}\{ {text/join pairs " "} }"
  return "{lead}\{}" if length pairs == 0
  return line if length line <= 80
  "{lead}\{\n{indent}  {text/join pairs "\n{indent}  "}\n{indent}}"

# A value nothing is read beneath travels behind a tag, whatever it is.
leaf = borne "wire/add" "wire/at" [] [] []

# A page's shape as kata reads it from the template: what it takes, in the
# order written, and every path it reads beneath them. Two compiles agree on
# a module's bytes exactly when they agree on this for each of its pages.
pub fn shape name src
  "{name}({text/join (takes src) " "}){text/join (list/sort (reads src)) ","}"

# `{name}_view` takes what the template takes and answers the page: how it
# is written onto bytes, and how it is drawn as markup from the records the
# action built. Written onto bytes it is `number`, the page's place among
# its module's pages, and then each value by its shape: a record as the
# fields the template reads, in order, and a list of records as a count and
# the records. Reading those fields from the action's records is what checks
# them.
pub fn viewed name file src number
  declared = takes src
  each = borne_all name file src
  helpers = list/fold each [] (acc b -> list/concat acc b.packers)
  given = params_of declared
  passed = if (length declared == 0) "\"\"" (text/join declared " ")
  pack = "  kata_pack = (acc -> {name}_pack acc {passed})"
  draw = "  kata_draw = (_ -> {name} {passed})"
  made = "  wire/paged kata_pack kata_draw"
  view = "pub fn {name}_view {given}\n{pack}\n{draw}\n{made}"
  first = "wire/add_count acc {number}"
  body = threaded first (list/to_list (list/map each (b -> b.pack))) declared
  packer = "fn {name}_pack acc {given}\n{body}"
  "{text/join (list/concat helpers [packer view]) "\n\n"}\n"

# The readers of a page's values and `{name}_shown`, which reads a page from
# bytes at a position and draws it with the template, or draws nothing when
# the bytes are not this page and nothing else.
pub fn read_page name file src
  declared = takes src
  each = borne_all name file src
  helpers = list/fold each [] (acc b -> list/concat acc b.readers)
  readers = list/to_list (list/map each (b -> b.read))
  steps = read_steps readers 1 "p" []
  last = if (length declared == 0) "p" "r{length declared}.next"
  found = values_of (length declared)
  call = if (length declared == 0) "{name} \"\"" "{name} {text/join found " "}"
  guard = "  return \"\" if {last} != length bs + 1"
  lines = list/concat steps [guard "  {call}"]
  page = "fn {name}_shown bs p\n{text/join lines "\n"}"
  "{text/join (list/concat helpers [page]) "\n\n"}\n"

# The types of the records a page's reader builds, one for each record the
# template reads fields from, each a definition of its own.
pub fn kinds name file src
  each = borne_all name file src
  list/fold each [] (acc b -> list/concat acc b.kinds)

fn borne_all name file src
  declared = takes src
  paths = reads src
  at = lined (read_lines src) file
  list/to_list (list/map declared (d -> borne_by name d (under paths d) at d))

# What each of `n` reads in a row found: `r1.value`, `r2.value` and on.
fn values_of n
  list/to_list (list/map (list/take list/naturals n) (i -> "r{i}.value"))

# One line a value, each written onto what the line before answered.
fn threaded first packs names
  return "  {first}" if length packs == 0
  lines = thread packs names 1 first []
  text/join lines "\n"

fn thread packs names i from acc
  return acc if i < 1 or length packs < i or length names < i
  last = i == length packs
  call = "{packs[i]} {wrapped from} {names[i]}"
  line = if last "  {call}" "  a{i} = {call}"
  thread packs names (i + 1) "a{i}" (push acc line)

# One line a value, each read from where the line before stopped.
fn read_steps readers i from acc
  return acc if i < 1 or length readers < i
  line = "  r{i} = {readers[i]} bs {from}"
  read_steps readers (i + 1) "r{i}.next" (push acc line)

# How the value read by the paths `subs` beneath it travels: behind a tag
# when nothing is read from it, as a count and its elements when it is a
# list whose elements are read from, and as its fields when it is a record.
fn borne_by name slug subs at path
  return leaf if length subs == 0
  each = list/to_list (list/select subs (s -> first_step s == "[]"))
  return list_borne name slug each at path if length each > 0
  record_borne name slug subs at path

fn list_borne name slug each at path
  inner = list/to_list (list/reject (list/map each rest_of) (s -> s == ""))
  return leaf if length inner == 0
  one = borne_by name "{slug}_each" inner at "{path}.[]"
  p = "{name}_pack_{slug}"
  r = "{name}_read_{slug}"
  counted = "(wire/add_count acc (length xs))"
  packer = "fn {p} acc xs\n  list/fold xs {counted} {one.pack}"
  reader = "fn {r} bs p\n  wire/listed bs p {one.read}"
  borne p r (push one.packers packer) (push one.readers reader) one.kinds

fn record_borne name slug subs at path
  fields = list/to_list (list/sort (distinct (firsts subs) []))
  one = (f -> field_borne name slug subs f at path)
  each = list/to_list (list/map fields one)
  packers = list/fold each [] (acc b -> list/concat acc b.packers)
  readers = list/fold each [] (acc b -> list/concat acc b.readers)
  rows = list/fold each [] (acc b -> list/concat acc b.kinds)
  kind_name = "{name}_row_{slug}"
  kind = "type {kind_name}\n  {text/join fields "\n  "}"
  p = "{name}_pack_{slug}"
  r = "{name}_read_{slug}"
  cites = list/to_list (list/map fields (f -> first_cited subs f at path))
  packs = list/to_list (list/map each (b -> b.pack))
  lines = fielded packs fields cites 1 "acc" []
  packer = "fn {p} acc x\n{text/join lines "\n"}"
  steps = read_steps (list/to_list (list/map each (b -> b.read))) 1 "p" []
  found = values_of (length fields)
  made = call_lines "  made = " kind_name found
  got = "  wire/got made r{length fields}.next"
  reader = "fn {r} bs p\n{text/join (list/concat steps [made got]) "\n"}"
  borne p r (push packers packer) (push readers reader) (push rows kind)

fn firsts subs
  list/to_list (list/map subs first_step)

fn field_borne name slug subs f at path
  below = list/select subs (s -> first_step s == f and s != f)
  rests = list/to_list (list/map below rest_of)
  borne_by name "{slug}_{f}" rests at "{path}.{f}"

# A field a line, each under the template line that first reads it, so a
# field the record lacks is reported at that line.
fn fielded packs fields cites i from acc
  return acc if i < 1 or length packs < i or length fields < i
  return acc if length cites < i
  last = i == length packs
  call = "{packs[i]} {from} x.{fields[i]}"
  line = if last "  {call}" "  a{i} = {call}"
  fielded packs fields cites (i + 1) "a{i}" (push acc "{cites[i]}{line}")

# A call on one line when it fits in 80 columns, and an argument to a line
# after the first when it does not, as the formatter asks.
fn call_lines lead called args
  line = "{lead}{called} {text/join args " "}"
  return line if length line <= 80 or length args < 2
  rest = list/to_list (list/drop args 1)
  "{lead}{called} {args[1]}\n    {text/join rest "\n    "}"
