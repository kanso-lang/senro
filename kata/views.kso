import "std/derive"
import "std/list"
import "std/text"

# The derivation an app names to have its templates compiled:
#
#   import "./views"
#   derive kata/views
#
# Every `.kata` file in a module the entry imports becomes a pub function of
# that module, named after the file, so `views/signed.kata` is called as
# `views/signed`. A directory of templates holds no kanso source of its own;
# its functions are written here while the program compiles.
pub fn views p
  list/fold p.modules [] (acc m -> list/concat acc (templates m))

fn templates m
  server = served? m
  found = list/fold (keys m.files) [] (acc f -> added acc m server f)
  return [] if length found == 0
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  head = if (length bound == 0) leaned_on "import \"std/json\"\n{leaned_on}"
  acts = if (length bound == 0) [] (acting m bound)
  list/concat (list/concat [(derive/define m.name head)] found) acts

fn added acc m server f
  wrote acc m.name server f m.files[f]

fn wrote acc _ _ _ none
  acc

fn wrote acc m server f src
  return acc if not text/ends_with? f ".kata"
  name = text/join (text/split f ".kata") ""
  return push acc (derive/define m (compiled name f src)) if bare? src
  push acc (component m server f name src)

fn bare? src
  length (actions src) == 0

# A template that binds actions is a component. Its state is the one value
# it takes, and the function named after the file wraps what the template
# renders in an element that says which component it is, what its state is,
# as JSON, and whether its actions run on the server, so the page's script
# can hand the state to `act` in the browser or post it to the server.
fn component m server f name src
  taken = takes src
  return derive/refuse m (one_state f) if length taken != 1
  s = taken[1]
  inner = compiled "{name}_body" f src
  runs = if server " data-runs=\\\"server\\\"" ""
  wrap = [
    "pub fn {name} {s}"
    "  kata_state = escape (json/encode {s})"
    "  kata_inside = {name}_body {s}"
    "  kata_open = \"<div data-component=\\\"{m}\\\"{runs}\""
    "  \"\{kata_open} data-state=\\\"\{kata_state}\\\">\{kata_inside}</div>\""
  ]
  derive/define m "{inner}\n{text/join wrap "\n"}\n"

fn one_state f
  said = "binds actions, so it is a component, and a component takes one value"
  "`{f}` {said}: its state"

fn bound_in acc _ none
  acc

fn bound_in acc f src
  return acc if not text/ends_with? f ".kata"
  list/fold (actions src) acc (a n -> if (has? a n) a (push a n))

# `act` runs an action by the name a template bound it under, on the
# component's state, and answers the next state. An action whose parameters
# ask for the request, a database session or the viewer needs the server,
# and so does every action of a component that has one. Its `act` takes
# what the server hands an action, the request, a session and the viewer as
# the `req`, `db` and `viewer` fields of one value, before the state, and
# answers none for a name no template binds, which the server answers as a
# 404. A browser component's `act` leaves the state as it was for such a
# name.
fn acting m names
  return [(derive/define m.name (in_browser names))] if not served? m
  refused = list/to_list (list/fold names [] (acc n -> misplaced acc m n))
  return refused if length refused > 0
  [(derive/define m.name (on_server m names))]

fn in_browser names
  arms = list/to_list (list/map names browser_arm)
  "{text/join arms "\n"}\npub fn act _ state\n  state\n"

fn browser_arm n
  "pub fn act \"{n}\" state\n  {n} state\n"

fn on_server m names
  arms = list/to_list (list/map names (n -> server_arm m n))
  "{text/join arms "\n"}\npub fn act _ _ _\n  none\n"

# The arm names only what its action takes, and leaves the rest unbound.
fn server_arm m n
  given = handed m n
  from = if (list/any? given (g -> g != "state")) "kata_given" "_"
  "pub fn act \"{n}\" {from} state\n  {n} {text/join given " "}\n"

# What an action is handed, parameter by parameter: the request, the
# session and the viewer by name, and the state last.
fn handed m n
  params = params_of m n
  list/to_list (list/map params (p -> given_as p.name))

fn given_as "req"
  "kata_given.req"

fn given_as "db"
  "kata_given.db"

fn given_as "viewer"
  "kata_given.viewer"

fn given_as _
  "state"

fn params_of m n
  f = list/find m.functions (f -> f.name == n)
  if (f == none) [] f.params

fn served? m
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  list/any? bound (n -> server? (params_of m n))

fn server? params
  list/any? params (p -> handed? p.name)

fn handed? name
  name == "req" or name == "db" or name == "viewer"

# Only the request, a session, the viewer and the state can be handed to an
# action, and the state comes last.
fn misplaced acc m n
  params = params_of m n
  return acc if length params == 0
  early = list/to_list (list/take params (length params - 1))
  odd = list/to_list (list/reject early (p -> handed? p.name))
  return acc if length odd == 0
  push acc (derive/refuse "{m.name}/{n}" (handed_only n odd[1].name))

fn handed_only n p
  only = "an action is handed only req, db, viewer and its state"
  "the action `{n}` takes `{p}` before its state, and {only}"

# What every compiled template leans on, written once into each module that
# holds templates: the escape that keeps a value from being read as markup, a
# loop body joined once per element, and the join of a function's parts.
leaned_on = """
  import "std/list"
  import "std/text"

  fn escape x
    s = "\{x}"
    amp = text/join (text/split s "&") "&amp;"
    lt = text/join (text/split amp "<") "&lt;"
    gt = text/join (text/split lt ">") "&gt;"
    quot = text/join (text/split gt "\\"") "&quot;"
    text/join (text/split quot "'") "&#39;"

  fn each xs f
    text/join (list/to_list (list/map xs f)) ""

  fn joined parts
    text/join parts ""
"""
