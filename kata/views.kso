import "std/derive"
import "std/list"
import "std/text"

# The derivation an app names to have its templates compiled:
#
#   import "./views"
#   derive kata/views
#
# Every `.kata` file in a module the entry imports becomes a pub function of
# that module, named after the file, so `views/signed.kata` is called as
# `views/signed`. A directory of templates holds no kanso source of its own;
# its functions are written here while the program compiles.
pub fn views p
  list/fold p.modules [] (acc m -> list/concat acc (templates p m))

fn templates p m
  return [] if not list/any? (keys m.files) (f -> text/ends_with? f ".kata")
  calls = list/fold p.modules [] (acc x -> list/concat acc x.calls)
  asked = list/fold calls [] named_in
  use = used asked m
  keep = (n -> use != "render" or has? asked "{m.name}/{n}")
  server = served? m
  found = list/fold (keys m.files) [] (acc f -> added acc m server f keep)
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  head = derive/define m.name (head_of (length bound > 0) use)
  acts = if (length bound == 0) [] (acting m bound)
  pages = if (use == "") [] (pages_of m use keep)
  list/concat (list/concat (list/concat [head] found) acts) pages

fn added acc m server f keep
  wrote acc m.name server f m.files[f] keep

fn wrote acc _ _ _ none _
  acc

# A program that only renders pages, such as the app's browser module, holds
# none of the records its pages read, so it gets a page's own function only
# when it names it.
fn wrote acc m server f src keep
  return acc if not text/ends_with? f ".kata"
  name = text/join (text/split f ".kata") ""
  return push acc (derive/refuse m (reserved f name)) if taken? name
  return acc if bare? src and not keep name
  return push acc (derive/define m (compiled name f src)) if bare? src
  push acc (component m server f name src)

fn bare? src
  length (actions src) == 0

# A template that binds actions is a component. Its state is the one value
# it takes, and the function named after the file wraps what the template
# renders in an element that says which component it is, what its state is,
# as JSON, and whether its actions run on the server, so the page's script
# can hand the state to `act` in the browser or post it to the server.
fn component m server f name src
  taken = takes src
  return derive/refuse m (one_state f) if length taken != 1
  s = taken[1]
  inner = compiled "{name}_body" f src
  runs = if server " data-runs=\\\"server\\\"" ""
  wrap = [
    "pub fn {name} {s}"
    "  kata_state = escape (json/encode {s})"
    "  kata_inside = {name}_body {s}"
    "  kata_open = \"<div data-component=\\\"{m}\\\"{runs}\""
    "  \"\{kata_open} data-state=\\\"\{kata_state}\\\">\{kata_inside}</div>\""
  ]
  derive/define m "{inner}\n{text/join wrap "\n"}\n"

fn one_state f
  said = "binds actions, so it is a component, and a component takes one value"
  "`{f}` {said}: its state"

fn bound_in acc _ none
  acc

fn bound_in acc f src
  return acc if not text/ends_with? f ".kata"
  list/fold (actions src) acc (a n -> if (has? a n) a (push a n))

# `act` runs an action by the name a template bound it under, on the
# component's state, and answers the next state. An action whose parameters
# ask for the request, a database session or the viewer needs the server,
# and so does every action of a component that has one. Its `act` takes
# what the server hands an action, the request, a session and the viewer as
# the `req`, `db` and `viewer` fields of one value, before the state, and
# answers none for a name no template binds, which the server answers as a
# 404. A browser component's `act` leaves the state as it was for such a
# name.
fn acting m names
  return [(derive/define m.name (in_browser names))] if not served? m
  refused = list/to_list (list/fold names [] (acc n -> misplaced acc m n))
  around = list/to_list (list/select m.calls (c -> around? names c))
  bypass = list/to_list (list/map around (c -> derive/refuse_call c (direct c)))
  return list/concat refused bypass if length refused + length bypass > 0
  [(derive/define m.name (on_server m names))]

# A server action writes through a model, whose policy checks the write
# (`models/updated`, `models/destroyed`), and never with SQL of its own. The
# check reads the action's own calls.
fn around? names c
  bound = list/any? names (n -> n == c.caller)
  bound and (c.callee == "pg/query" or c.callee == "pg/run")

fn direct c
  through = "write through a model, so its policy checks the write"
  "`{c.caller}` is a server action and calls `{c.callee}` itself: {through}"

fn in_browser names
  arms = list/to_list (list/map names browser_arm)
  "{text/join arms "\n"}\npub fn act _ state\n  state\n"

fn browser_arm n
  "pub fn act \"{n}\" state\n  {n} state\n"

fn on_server m names
  arms = list/to_list (list/map names (n -> server_arm m n))
  "{text/join arms "\n"}\npub fn act _ _ _\n  none\n"

# The arm names only what its action takes, and leaves the rest unbound.
fn server_arm m n
  given = handed m n
  from = if (list/any? given (g -> g != "state")) "kata_given" "_"
  "pub fn act \"{n}\" {from} state\n  {n} {text/join given " "}\n"

# What an action is handed, parameter by parameter: the request, the
# session and the viewer by name, and the state last.
fn handed m n
  params = params_of m n
  list/to_list (list/map params (p -> given_as p.name))

fn given_as "req"
  "kata_given.req"

fn given_as "db"
  "kata_given.db"

fn given_as "viewer"
  "kata_given.viewer"

fn given_as _
  "state"

fn params_of m n
  f = list/find m.functions (f -> f.name == n)
  if (f == none) [] f.params

fn served? m
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  list/any? bound (n -> server? (params_of m n))

fn server? params
  list/any? params (p -> handed? p.name)

fn handed? name
  name == "req" or name == "db" or name == "viewer"

# Only the request, a session, the viewer and the state can be handed to an
# action, and the state comes last.
fn misplaced acc m n
  params = params_of m n
  return acc if length params == 0
  early = list/to_list (list/take params (length params - 1))
  odd = list/to_list (list/reject early (p -> handed? p.name))
  return acc if length odd == 0
  push acc (derive/refuse "{m.name}/{n}" (handed_only n odd[1].name))

fn handed_only n p
  only = "an action is handed only req, db, viewer and its state"
  "the action `{n}` takes `{p}` before its state, and {only}"

# What every compiled template leans on, written once into each module that
# holds templates: the escape that keeps a value from being read as markup, a
# loop body joined once per element, and the join of a function's parts.
leaned_on = """
  fn escape none
    ""

  fn escape x
    s = "\{x}"
    amp = text/join (text/split s "&") "&amp;"
    lt = text/join (text/split amp "<") "&lt;"
    gt = text/join (text/split lt ">") "&gt;"
    quot = text/join (text/split gt "\\"") "&quot;"
    text/join (text/split quot "'") "&#39;"

  fn each xs f
    text/join (list/to_list (list/map xs f)) ""

  fn joined parts
    text/join parts ""
"""

# The names of the functions a module of pages answers with, which no
# template may take.
fn taken? name
  list/any? ["answer" "answer_as" "rendered"] (n -> n == name)

fn reserved f name
  "`{f}` would be the function `{name}`, which kata writes for every page"

# A module's pages are written for the browser when the app asks for them: a
# server that answers with `views/answer`, or a browser module that renders
# with `views/rendered`, whether it calls the function or hands it on. An app
# that does neither compiles as it did.
fn used asked m
  serving = has? asked "{m.name}/answer" or has? asked "{m.name}/answer_as"
  return "serve" if serving
  if (has? asked "{m.name}/rendered") "render" ""

fn named_in acc c
  list/concat (push acc c.callee) c.arguments

# The imports and helpers every compiled template leans on, and those the
# pages compiled to read JSON lean on too.
fn head_of bound use
  json = bound or use == "serve"
  extra = if (use == "serve") ["std/net/http"] []
  listed = list/concat (if json ["std/json" "std/list"] ["std/list"]) extra
  all = push listed "std/text"
  lines = list/to_list (list/map all (i -> "import \"{i}\""))
  body = if (use == "") leaned_on "{leaned_on}\n{keyed_helpers}"
  "{text/join lines "\n"}\n\n{body}"

# Each page of the module as data and rendered from it: `{name}_view`,
# which describes the page, the template compiled to read JSON, and
# `rendered`, which renders a page `{name}_view` described with that
# compile. A server also gets `answer`.
fn pages_of m use keep
  files = list/to_list (list/sort (keys m.files))
  pages = list/to_list (list/select files (f -> page? f m.files[f]))
  keyed_all = list/to_list (list/map pages (f -> keyed_of m f m.files[f]))
  arms = list/to_list (list/map pages (f -> shown_arm f m.files[f]))
  dispatch = "{rendering}\n{text/join arms "\n"}\nfn kata_shown _ _\n  \"\"\n"
  drawn = push keyed_all (derive/define m.name dispatch)
  asked_for = list/select pages (f -> keep "{page_name f}_view")
  described = list/to_list (list/map asked_for (f -> viewed_of m f m.files[f]))
  both = list/concat drawn described
  if (use == "serve") (push both (derive/define m.name answering)) both

fn page? _ none
  false

fn page? f src
  text/ends_with? f ".kata" and bare? src

fn page_name f
  text/join (text/split f ".kata") ""

fn keyed_of m f none
  derive/refuse m.name "`{f}` could not be read"

fn keyed_of m f src
  derive/define m.name (keyed (page_name f) f src)

fn viewed_of m f none
  derive/refuse m.name "`{f}` could not be read"

fn viewed_of m f src
  derive/define m.name (viewed (page_name f) f src)

fn shown_arm _ none
  ""

fn shown_arm f src
  n = page_name f
  declared = takes src
  return "fn kata_shown \"{n}\" _\n  {n}_keyed \"\"\n" if length declared == 0
  bound = list/map declared (d -> "  {d} = kata_at kata_l \"{d}\"")
  call = "  {n}_keyed {text/join declared " "}"
  lines = list/concat (list/to_list bound) [call]
  "fn kata_shown \"{n}\" kata_l\n{text/join lines "\n"}\n"

rendering = """
  pub fn rendered node
    kata_shown (kata_at node "view") (kata_at node "locals")
"""

# A page answers a request a browser made itself as HTML, rendered here. The
# page's script asks with a `senro-view` header, and gets the page's data as
# JSON, which it renders with the app's browser module. `answer_as` answers
# with a status of the action's choosing, such as 422 for a form sent back
# with its problems.
answering = """
  pub fn answer req node
    answer_as req 200 node

  pub fn answer_as req code node
    kata_answered req.headers["senro-view"] code node

  fn kata_answered none code node
    page = ["content-type: text/html; charset=utf-8"]
    http/respond code page (rendered node)

  fn kata_answered _ code node
    heard = [
      "cache-control: no-store"
      "content-type: application/json"
      "senro-view: 1"
    ]
    http/respond code heard (json/encode node)
"""

# What JSON decoded is read through these: a key a map lacks reads as "", a
# value that is not a list loops over nothing, and a page within the page
# renders where it is spliced.
keyed_helpers = """
  fn kata_at none _
    ""

  fn kata_at m k
    kata_present m[k]

  fn kata_present none
    ""

  fn kata_present v
    v

  fn kata_items xs:[]some
    xs

  fn kata_items _
    []

  fn kata_raw none
    "<none>"

  fn kata_raw node:map[string some]
    rendered node

  fn kata_raw x
    "\{x}"
"""
