import "std/bits"
import "std/derive"
import "std/list"
import "std/text"

# The derivation an app names to have its templates compiled:
#
#   import "./views"
#   derive kata/views
#
# Every `.kata` file in a module the entry imports becomes a pub function of
# that module, named after the file, so `views/signed.kata` is called as
# `views/signed`. A directory of templates holds no kanso source of its own;
# its functions are written here while the program compiles.
pub fn views p
  list/fold p.modules [] (acc m -> list/concat acc (templates p m))

fn templates p m
  return [] if not list/any? (keys m.files) (f -> text/ends_with? f ".kata")
  calls = list/fold p.modules [] (acc x -> list/concat acc x.calls)
  asked = list/fold calls [] named_in
  use = used asked m
  keep = (n -> use != "render" or has? asked "{m.name}/{n}")
  server = served? m
  found = list/fold (keys m.files) [] (acc f -> added acc m server f)
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  acts = if (length bound == 0) [] (acting m bound)
  bytes_read = has? asked "{m.name}/rendered"
  head = derive/define m.name (head_of (length bound > 0) use bytes_read)
  pages = if (use == "") [] (pages_of m use keep bytes_read)
  types = if (use == "") [] (types_of m use keep bytes_read)
  rest = list/concat (list/concat (list/concat [head] found) acts) pages
  list/concat types rest

fn added acc m server f
  wrote acc m.name server f m.files[f]

fn wrote acc _ _ _ none
  acc

fn wrote acc m server f src
  return acc if not text/ends_with? f ".kata"
  name = text/join (text/split f ".kata") ""
  return push acc (derive/refuse m (reserved f name)) if taken? name
  return push acc (derive/define m (compiled name f src)) if bare? src
  push acc (component m server f name src)

fn bare? src
  length (actions src) == 0

# A template that binds actions is a component. Its state is the one value
# it takes, and the function named after the file wraps what the template
# renders in an element that says which component it is, what its state is,
# as its bytes in base64, and whether its actions run on the server, so the
# page's script can hand the state to `act` in the browser or post it to the
# server.
fn component m server f name src
  taken = takes src
  return derive/refuse m (one_state f) if length taken != 1
  s = taken[1]
  inner = compiled "{name}_body" f src
  runs = if server " data-runs=\\\"server\\\"" ""
  wrap = [
    "pub fn {name} {s}"
    "  kata_state = wire/as_text (wire/packed {s})"
    "  kata_inside = {name}_body {s}"
    "  kata_open = \"<div data-component=\\\"{m}\\\"{runs}\""
    "  \"\{kata_open} data-state=\\\"\{kata_state}\\\">\{kata_inside}</div>\""
  ]
  derive/define m "{inner}\n{text/join wrap "\n"}\n"

fn one_state f
  said = "binds actions, so it is a component, and a component takes one value"
  "`{f}` {said}: its state"

fn bound_in acc _ none
  acc

fn bound_in acc f src
  return acc if not text/ends_with? f ".kata"
  list/fold (actions src) acc (a n -> if (has? a n) a (push a n))

# `act` runs an action by the name a template bound it under, on the
# component's state, and answers the next state. An action whose parameters
# ask for the request, a database session or the viewer needs the server,
# and so does every action of a component that has one. Its `act` takes
# what the server hands an action, the request, a session and the viewer as
# the `req`, `db` and `viewer` fields of one value, before the state, and
# answers none for a name no template binds, which the server answers as a
# 404. A browser component's `act` leaves the state as it was for such a
# name.
fn acting m names
  return [(derive/define m.name (in_browser names))] if not served? m
  refused = list/to_list (list/fold names [] (acc n -> misplaced acc m n))
  around = list/to_list (list/select m.calls (c -> around? names c))
  bypass = list/to_list (list/map around (c -> derive/refuse_call c (direct c)))
  return list/concat refused bypass if length refused + length bypass > 0
  [(derive/define m.name (on_server m names))]

# A server action writes through a model, whose policy checks the write
# (`models/updated`, `models/destroyed`), and never with SQL of its own. The
# check bytes_read the action's own calls.
fn around? names c
  bound = list/any? names (n -> n == c.caller)
  bound and (c.callee == "pg/query" or c.callee == "pg/run")

fn direct c
  through = "write through a model, so its policy checks the write"
  "`{c.caller}` is a server action and calls `{c.callee}` itself: {through}"

fn in_browser names
  arms = list/to_list (list/map names browser_arm)
  "{text/join arms "\n"}\npub fn act _ state\n  state\n"

fn browser_arm n
  "pub fn act \"{n}\" state\n  {n} state\n"

fn on_server m names
  arms = list/to_list (list/map names (n -> server_arm m n))
  "{text/join arms "\n"}\npub fn act _ _ _\n  none\n"

# The arm names only what its action takes, and leaves the rest unbound.
fn server_arm m n
  given = handed m n
  from = if (list/any? given (g -> g != "state")) "kata_given" "_"
  "pub fn act \"{n}\" {from} state\n  {n} {text/join given " "}\n"

# What an action is handed, parameter by parameter: the request, the
# session and the viewer by name, and the state last.
fn handed m n
  params = params_of m n
  list/to_list (list/map params (p -> given_as p.name))

fn given_as "req"
  "kata_given.req"

fn given_as "db"
  "kata_given.db"

fn given_as "viewer"
  "kata_given.viewer"

fn given_as _
  "state"

fn params_of m n
  f = list/find m.functions (f -> f.name == n)
  if (f == none) [] f.params

fn served? m
  bound = list/fold (keys m.files) [] (acc f -> bound_in acc f m.files[f])
  list/any? bound (n -> server? (params_of m n))

fn server? params
  list/any? params (p -> handed? p.name)

fn handed? name
  name == "req" or name == "db" or name == "viewer"

# Only the request, a session, the viewer and the state can be handed to an
# action, and the state comes last.
fn misplaced acc m n
  params = params_of m n
  return acc if length params == 0
  early = list/to_list (list/take params (length params - 1))
  odd = list/to_list (list/reject early (p -> handed? p.name))
  return acc if length odd == 0
  push acc (derive/refuse "{m.name}/{n}" (handed_only n odd[1].name))

fn handed_only n p
  only = "an action is handed only req, db, viewer and its state"
  "the action `{n}` takes `{p}` before its state, and {only}"

# What every compiled template leans on, written once into each module that
# holds templates: the escape that keeps a value from being read as markup, a
# loop body joined once per element, and the join of a function's parts.
# Most values hold none of the five characters that need escaping, so the
# escape looks for them first, two bytes to a search (`&` `<`, `>` `"`, and
# `'`), and hands a value with none back as it came.
leaned_on = """
  fn escape none
    ""

  fn escape x
    s = "\{x}"
    cs = text/bytes s
    past = length cs
    marks = text/find2 cs 1 38 60 <= past or text/find2 cs 1 62 34 <= past
    return s if not marks and text/find2 cs 1 39 39 > past
    amp = text/join (text/split s "&") "&amp;"
    lt = text/join (text/split amp "<") "&lt;"
    gt = text/join (text/split lt ">") "&gt;"
    quot = text/join (text/split gt "\\"") "&quot;"
    text/join (text/split quot "'") "&#39;"

  fn each xs f
    text/join (list/to_list (list/map xs f)) ""

  fn joined parts
    text/join parts ""
"""

# The names of the functions a module of pages answers with, which no
# template may take.
fn taken? name
  list/any? ["answer" "answer_as" "rendered" "packed"] (n -> n == name)

fn reserved f name
  "`{f}` would be the function `{name}`, which kata writes for every page"

# A module's pages are written for the browser when the app asks for them: a
# server that answers with `views/answer`, or a browser module that renders
# with `views/rendered`, whether it calls the function or hands it on. An app
# that does neither compiles as it did.
fn used asked m
  serving = has? asked "{m.name}/answer" or has? asked "{m.name}/answer_as"
  return "serve" if serving
  drawn = has? asked "{m.name}/rendered" or has? asked "{m.name}/packed"
  if drawn "render" ""

fn named_in acc c
  list/concat (push acc c.callee) c.arguments

# The imports every compiled template leans on, those a component's state
# travels with, and those a module of pages leans on too. `../wire` is
# written from this module, as a derivation's imports are.
fn head_of bound use bytes_read
  paged = use != ""
  wired = if (bound or paged) ["../wire"] []
  extra = if (use == "serve") ["std/net/http"] []
  std = list/concat ["std/list"] extra
  all = list/concat wired (push std "std/text")
  lines = list/to_list (list/map all (i -> "import \"{i}\""))
  splice = if bytes_read read_splice (if paged page_splice plain_splice)
  "{text/join lines "\n"}\n\n{leaned_on}\n{splice}"

# Each page of the module as bytes and drawn from them (kanso#2416).
# `{name}_view`, which answers the page a server sends, is written for a
# server, and for any program that names it, with `packed`, which answers a
# page's bytes. A server also gets `answer`. A program that names `rendered`
# draws pages from bytes, so it gets each page's reader, `{name}_shown`, and
# `rendered` itself: the app's browser module is one. A server does not,
# and that is what keeps a field a record lacks a compile error there: the
# reader's record types hold every field a template bytes_read, so a program
# with them has some record with any field a template names.
fn pages_of m use keep bytes_read
  files = list/to_list (list/sort (keys m.files))
  pages = list/to_list (list/select files (f -> page? f m.files[f]))
  numbers = list/to_list (list/take list/naturals (length pages))
  marks = marked (shapes_of m pages)
  opened = derive/define m.name "kata_marks = {listed_marks marks}\n"
  wanted = list/select numbers (i -> viewing? use keep pages[i])
  answers = list/to_list (list/map wanted (i -> view_of m pages[i] i))
  packs = if (length answers == 0) [] [(derive/define m.name packed_source)]
  serves = if (use == "serve") [(derive/define m.name answering)] []
  sent = list/concat (list/concat answers packs) serves
  drawn = if bytes_read (readers_of m pages numbers marks) []
  list/concat (push drawn opened) sent

fn readers_of m pages numbers marks
  readers = list/to_list (list/map pages (f -> reader_of m f m.files[f]))
  arms = list/to_list (list/map numbers (i -> shown_arm i pages[i]))
  dispatch = "{read_source marks}\n{text/join arms "\n"}\n{shown_else}"
  push readers (derive/define m.name dispatch)

# The types the module's pages lean on: the records its readers build, when
# it bytes_read pages, and what each view holds, when it answers them. A type
# comes before any function in the file a module's definitions share, so
# these are answered first.
fn types_of m use keep bytes_read
  files = list/to_list (list/sort (keys m.files))
  pages = list/to_list (list/select files (f -> page? f m.files[f]))
  numbers = list/to_list (list/take list/naturals (length pages))
  typed = (acc f -> list/concat acc (kinds_of m f m.files[f]))
  rows = if bytes_read (list/fold pages [] typed) []
  wanted = list/select numbers (i -> viewing? use keep pages[i])
  held = list/fold wanted [] (acc i -> held_of acc m pages[i])
  list/concat rows held

fn held_of acc _ none
  acc

fn held_of acc m f
  holder acc m (page_kind_of f m.files[f])

fn page_kind_of _ none
  none

fn page_kind_of f src
  page_kind (page_name f) src

fn holder acc _ none
  acc

fn holder acc m kind
  push acc (derive/define m.name "{kind}\n")

fn viewing? _ _ none
  false

fn viewing? use keep f
  use == "serve" or keep "{page_name f}_view"

fn page? _ none
  false

fn page? f src
  text/ends_with? f ".kata" and bare? src

fn page_name f
  text/join (text/split f ".kata") ""

fn kinds_of _ _ none
  []

fn kinds_of m f src
  each = kata_kinds (page_name f) f src
  list/to_list (list/map each (k -> derive/define m.name "{k}\n"))

fn kata_kinds name f src
  kinds name f src

fn reader_of m f none
  derive/refuse m.name "`{f}` could not be read"

fn reader_of m f src
  derive/define m.name (read_page (page_name f) f src)

fn view_of m none _
  derive/refuse m.name "a page could not be read"

fn view_of m f i
  written_view m f m.files[f] i

fn written_view m f none _
  derive/refuse m.name "`{f}` could not be read"

fn written_view m f src i
  derive/define m.name (viewed (page_name f) f src i)

fn shown_arm _ none
  ""

fn shown_arm i f
  "fn kata_shown {i} bs p\n  {page_name f}_shown bs p\n"

shown_else = """
  fn kata_shown none _ _
    ""

  fn kata_shown _ _ _
    ""
"""

# The module's shapes as four bytes, which open every page it sends. A page
# is read only when it opens with the reader's own four, so bytes from
# another compile, whose pages may take other values or read other fields,
# are refused whole and never misread. The mark is the FNV-1a hash of each
# page's shape in turn.
fn shapes_of m pages
  each = list/to_list (list/map pages (f -> shape_of f m.files[f]))
  text/join each ";"

fn shape_of _ none
  ""

fn shape_of f src
  shape (page_name f) src

fn marked s
  h = list/fold (list/to_list (text/bytes s)) 2166136261 hashed
  [(byte_of h 24) (byte_of h 16) (byte_of h 8) (byte_of h 0)]

fn hashed h b
  bits/xor h b * 16777619 & 4294967295

fn byte_of h shift
  bits/shr h shift & 255

fn listed_marks marks
  "[{marks[1]} {marks[2]} {marks[3]} {marks[4]}]"

fn read_source marks
  first = "bs[1] == {marks[1]} and bs[2] == {marks[2]}"
  second = "bs[3] == {marks[3]} and bs[4] == {marks[4]}"
  lines = [
    "pub fn rendered p:wire/page"
    "  wire/drawn p"
    ""
    "pub fn rendered bs"
    "  kata_drawn bs (wire/count_at bs (kata_opened bs))"
    ""
    "fn kata_opened bs"
    "  first = {first}"
    "  second = {second}"
    "  if (first and second) 5 0"
    ""
    "fn kata_drawn bs r"
    "  kata_shown r.value bs r.next"
    ""
  ]
  text/join lines "\n"

packed_source = """
  pub fn packed page
    wire/written (text/to_bytes kata_marks) page
"""

# A page answers a request a browser made itself as HTML, drawn here from
# the records. The page's script asks with a `senro-view` header, and gets
# the page as bytes, which it draws with the app's browser module.
# `answer_as` answers with a status of the action's choosing, such as 422
# for a form sent back with its problems.
answering = """
  pub fn answer req page
    answer_as req 200 page

  pub fn answer_as req code page
    kata_answered req.headers["senro-view"] code page

  fn kata_answered none code page
    html = ["content-type: text/html; charset=utf-8"]
    http/respond code html (wire/drawn page)

  fn kata_answered _ code page
    heard = [
      "cache-control: no-store"
      "content-type: application/octet-stream"
      "senro-view: 1"
    ]
    http/respond code heard (packed page)
"""

# What a template splices in as it is: markup, or a page within the page,
# which is drawn where it is spliced. On a server that is the page the
# action built, and where pages are read from bytes it is that page's bytes.
page_splice = """
  fn kata_raw none
    "<none>"

  fn kata_raw p:wire/page
    wire/drawn p

  fn kata_raw x
    "\{x}"
"""

read_splice = """
  fn kata_raw none
    "<none>"

  fn kata_raw p:wire/page
    wire/drawn p

  fn kata_raw b:wire/blob
    kata_drawn b.bytes (wire/count_at b.bytes 1)

  fn kata_raw x
    "\{x}"
"""

# The same for a module with no pages, where what is spliced is markup.
plain_splice = """
  fn kata_raw none
    "<none>"

  fn kata_raw x
    "\{x}"
"""
