import "../web"
import "./app"
import "std/list"
import "std/text"

# What `generate authentication` writes, as Rails 8's authentication
# generator does: an account an address and a password make, signing in and
# out, a password reset by mail, and a spec of signing in. The files are
# copied from generate/authentication, where they are written as an app two
# directories below senro would hold them, and each import of senro is
# pointed at the app's own path back to it.
pub copied = [
  "password_mailer.kso"
  "registration.kso"
  "resets.kso"
  "session.kso"
  "session_test.kso"
  "user.kso"
  "views/door.kata"
  "views/reset_asked.kata"
  "views/reset_chosen.kata"
]

# The modules of those the entry imports: the three resources, and the
# model, which a derivation reads only when the entry names it.
imported = ["registration" "resets" "session" "user"]

pub source = "generate/authentication"

# A template's text as the app at `senro` holds it, signing its sessions
# with `secret`.
pub fn localized t senro secret
  pointed = swapped t "import \"../../" "import \"{senro}/"
  swapped pointed "pub secret = \"SECRET\"" "pub secret = \"{secret}\""

fn swapped t old new
  text/replace t old new

# A secret of 32 random bytes, written as hex.
pub fn secret_of bytes
  web/hexed bytes

# The fields of the `users` table, as `scaffold` reads them.
pub fields = ["email:text:uniq" "digest:text"]

# The entry `generate new` wrote, signed: every action asks for a sign-in
# unless its module says otherwise. None when the entry no longer reads as
# `new` wrote it.
pub fn entry_signed main
  lines = text/split main "\n"
  return none if not list/any? lines run?
  served = list/to_list (list/map lines signed_line)
  own = text/join served "\n"
  list/fold imported own (e n -> with e n)

# The line `new` ends the entry with, whatever the app is named.
fn run? line
  text/starts_with? line "app/run \"" and text/ends_with? line unsigned

unsigned = " routes connected derived"

fn with entry name
  answered (app/entry_with entry name) entry

fn answered none entry
  entry

fn answered changed _
  changed

fn signed_line line
  return walled line if run? line
  return "{line}\n{text/replace line "/pg\"" "/web\""}" if senro_pg? line
  line

# The entry's import of senro's `pg`, which `web`, the module that signs,
# goes after.
fn senro_pg? line
  own = text/starts_with? line "import \"./"
  imports = text/starts_with? line "import \""
  imports and text/ends_with? line "/pg\"" and not own

fn walled line
  lines = [
    "# Every action asks for a sign-in unless its module lists it in"
    "# `without_sign_in`."
    signing
    ""
    (text/replace line unsigned " signed connected derived")
  ]
  text/join lines "\n"

signing = text/join signing_words " "

signing_words = [
  "signed = web/requiring_sign_in routes session/secret"
  "session/signed_against"
]
