import "../models"
import "std/list"
import "std/text"

# What `generate scaffold` writes for a resource, as Rails' generator writes
# it: a migration that makes the table, a module whose actions list, show,
# make, change and remove rows through the model, and three views. Each
# function answers a file's text, so a spec can read what would be written
# without writing it.
#
# A field is written `name:kind` on the command line. A kind is `text` or
# `int`, the two a form's fields read back as without a parser of their own;
# `references`: `note:references` is a column `note_id` holding a row of
# `notes`, and the resource is nested under them, as Rails' generator reads
# it; or `attachment`: `cover:attachment` is a file chosen in the form, kept
# by senro under a key, and the column holds the key. `name:kind:uniq`
# gives the column a unique index, as Rails' generator reads `uniq`.
pub type field
  name
  kind
  unique

# The fields a command line names, or the first that cannot be read, and
# why it cannot.
pub type unreadable
  word
  why

# A comment being wrapped: the lines it has filled, and the one it is on.
type wrap
  lines
  line

pub fn fields_of words
  read = list/to_list (list/map words field_of)
  first_bad = list/first (list/to_list (list/select read bad?))
  nested_once words (unread first_bad read)

# A route nests one level deep, so a resource names one parent.
fn nested_once _ f:unreadable
  f

fn nested_once words read
  refs = list/to_list (list/select words (w -> text/ends_with? w ":references"))
  one = "a resource nests under one parent"
  return unreadable (said refs[2]) one if length refs > 1
  read

fn unread none read
  read

fn unread f _
  f

fn bad? _:unreadable
  true

fn bad? _
  false

# Each of `xs` made a list by `f`, the lists joined end to end.
fn spread xs f
  list/fold xs [] (acc x -> list/concat acc (f x))

fn field_of word
  parts = text/split word ":"
  return unreadable word kinds if length parts < 2 or length parts > 3
  kind = column_kind parts[2]
  return unreadable word kinds if kind == ""
  return unreadable word uniq if length parts == 3 and parts[3] != "uniq"
  named = referred word (checked_name word parts[1] kind)
  indexed_if named (length parts == 3)

kinds = "a field is name:text, name:int, name:references or name:attachment"

uniq = "a field ends `:uniq` or has two parts"

fn indexed_if f:unreadable _
  f

fn indexed_if f unique
  field f.name f.kind unique

# A reference's field is the parent's id. Its name is kept short, since the
# nested actions write the id's name twice on some lines.
fn referred _ f:unreadable
  f

fn referred word f
  return f if f.kind != "references"
  long = "a reference's name is at most 12 characters"
  return unreadable word long if length f.name > 12
  field "{f.name}_id" f.kind f.unique

# A name the scaffold can write: a lowercase letter, then lowercase letters,
# digits and underscores; short enough that every line written with it fits
# in 80 columns; and not `id`, which every table has already.
fn checked_name word name kind
  return unreadable word "`id` is a column every table has" if name == "id"
  return unreadable word spelling if not spelled_well? name
  long = "a field's name is at most 24 characters"
  return unreadable word long if length name > 24
  field name kind false

spelling = "a field's name is a lowercase letter, then letters, digits and _"

# What is wrong with a resource's name, or "" when nothing is. It is spelled
# as a field's is, and short enough that the lines written with it, beside
# a parent's name and a field's, fit in 80 columns.
pub fn resource_named singular
  spelled = spelled_well? singular
  return "a resource's name is spelled as a field's is" if not spelled
  return "a resource's name is at most 16 characters" if length singular > 16
  ""

fn spelled_well? name
  cs = list/to_list (text/chars name)
  return false if length cs == 0
  lower? cs[1] and list/all? cs (c -> lower? c or digit? c or c == "_")

fn lower? c
  code = text/char_code c
  code >= 97 and code <= 122

fn digit? c
  code = text/char_code c
  code >= 48 and code <= 57

fn column_kind "text"
  "text"

fn column_kind "int"
  "integer"

fn column_kind "references"
  "references"

fn column_kind "attachment"
  "attachment"

fn column_kind _
  ""

# The reference among a resource's fields, or none when it is not nested.
pub fn parent_of fields
  list/first (list/to_list (list/select fields (f -> f.kind == "references")))

# The parent a reference names: `note_id` names `note`.
pub fn parent_name f
  said (text/slice f.name 1 (length f.name - 3))

# The fields a form shows. A nested resource's parent comes from its path.
fn own fields
  list/to_list (list/select fields (f -> f.kind != "references"))

fn said none
  ""

fn said s
  s

# The model's module, named for the record: its policies and its rules.
# The models derivation declares the record in it and answers for the table
# by the module's name.
pub fn model senro singular fields
  plural = models/plural singular
  rules = problems_of singular fields
  head = if (length rules == 0) [] ["import \"{senro}/models\"" ""]
  parts = [(record singular plural) (policies singular)]
  lines = list/concat (list/concat head parts) rules
  "{text/join lines "\n"}"

# The resource's module: the seven actions Rails' scaffold writes, each
# reading and writing through the model.
pub fn resource senro singular fields
  plural = models/plural singular
  parts = [
    (imports senro singular (parent_of fields))
    (actions_of singular plural fields (parent_of fields))
    (helpers_of singular plural fields (parent_of fields))
  ]
  "{text/join parts "\n"}\n"

fn names_of fields
  list/to_list (list/map fields (f -> f.name))

fn imports senro singular parent
  lines = [
    "import \"{senro}/models\""
    "import \"{senro}/web\""
    (model_imports singular parent)
    "import \"./views\""
    "import \"std/list\""
    "import \"std/net/http\""
    ""
  ]
  text/join lines "\n"

# The models an action reads: its own, and its parent's when it is nested,
# in the order kanso sorts imports.
fn model_imports singular none
  "import \"./{singular}\""

fn model_imports singular parent
  both = list/sort [singular (parent_name parent)]
  text/join (list/to_list (list/map both (n -> "import \"./{n}\""))) "\n"

# Words as `# ` lines of at most 76 columns, as a person would wrap them.
fn comment words
  w = list/fold (text/split words " ") (wrap [] "") wrapped
  lines = list/concat w.lines [w.line]
  text/join (list/to_list (list/map lines (l -> "# {l}"))) "\n"

fn wrapped acc word
  return wrap acc.lines word if acc.line == ""
  over = length acc.line + length word >= 74
  return wrap (list/concat acc.lines [acc.line]) word if over
  wrap acc.lines "{acc.line} {word}"

# The record is the table's: the module is named for it, so the models
# derivation declares it from the migrations, and the module says so.
fn record singular plural
  about = [
    "A {singular} is a row of the `{plural}` table. This module is named for"
    "it, so the models derivation declares `{singular}` here with a field"
    "for each column and answers for the table by this module's name:"
    "`{singular}/find db id`, `{singular}/paged db number per`,"
    "`{singular}/create db fields` and the rest."
  ]
  "{comment (text/join about " ")}\n#"

fn policies singular
  about = [
    "Anyone may make, change and remove a {singular}. The models module asks"
    "these before it writes; narrow them to the visitors who should."
  ]
  lines = [
    (comment (text/join about " "))
    "pub fn create? _ _"
    "  true"
    ""
    "pub fn update? _ _"
    "  true"
    ""
    "pub fn destroy? _ _"
    "  true"
    ""
  ]
  text/join lines "\n"

# The lines of the rules a record breaks when a number is not one its column
# takes, or none when the record has no number.
fn problems_of singular fields
  whole = list/to_list (list/select fields (f -> f.kind == "integer"))
  return [] if length whole == 0
  rules = list/to_list (list/map whole (f -> rule_of f))
  fit = "What makes a {singular} fit to keep:"
  about = "{fit} each number is one its column takes."
  listed = list_line "  models/problems" "  " rules
  [(comment about) "pub fn problems r" listed ""]

fn rule_of f
  "(models/whole_number \"{f.name}\" r.{f.name})"

# A list as one line when it fits, and one item to a line when it does not.
fn list_line head indent items
  one = "{head} [{text/join items " "}]"
  return one if length one <= 80
  each = list/to_list (list/map items (i -> "{indent}  {i}"))
  "{head} [\n{text/join each "\n"}\n{indent}]"

fn actions_of singular plural fields none
  actions singular plural fields

fn actions_of singular plural fields parent
  nested_actions singular plural fields parent

fn helpers_of singular plural fields none
  helpers singular plural fields

fn helpers_of singular plural fields parent
  nested_helpers singular plural fields parent

fn actions singular plural fields
  changed_then = ".> (w -> effect (changed req id w))"
  lines = [
    "pub fn index req db"
    "  number = models/page_number (web/value (web/query req) \"page\")"
    "  {singular}/paged db number per_page .> (p -> effect (listing req p))"
    ""
    (comment per_page_about)
    "per_page = 25"
    ""
    "pub fn show req db id:int"
    "  {singular}/find db id .> (r -> effect (shown req r))"
    ""
    "pub fn new req _"
    "  effect (form req \"/{plural}\" \"POST\" blank \{} 200)"
    ""
    "pub fn create req db"
    "  given = {made_with fields} (web/form req.body)"
    "  {singular}/create db given .> (w -> effect (made req w))"
    ""
    "pub fn edit req db id:int"
    "  {singular}/find db id .> (r -> effect (editing req id r))"
    ""
    "pub fn update req db id:int"
    "  given = picked (web/form req.body)"
    "  {singular}/update db id given {changed_then}"
    ""
    "pub fn destroy _ db id:int"
    "  {singular}/destroy db id .> (w -> effect (gone w))"
    ""
  ]
  text/join lines "\n"

fn helpers singular plural fields
  title = capitalized singular
  every_title = capitalized plural
  path = "\"/{plural}/\{id}\""
  lines = [
    "fn listing req p"
    "  as_json = {singular}/{singular}_attributes"
    "  mapped = list/to_list (list/map p.rows as_json)"
    "  return web/json 200 mapped if web/wants_json? req"
    "  page = views/{plural}_index_view p.rows p.number p.more"
    "  views/answer_as req 200 (views/layout_view \"{every_title}\" page)"
    ""
    "fn shown _ none"
    "  http/not_found"
    ""
    "fn shown req record"
    "  attributes = {singular}/{singular}_attributes record"
    "  return web/json 200 attributes if web/wants_json? req"
    "  page = views/{singular}_shown_view record"
    "  views/answer_as req 200 (views/layout_view \"{title}\" page)"
    ""
    "fn editing _ _ none"
    "  http/not_found"
    ""
    "fn editing req id record"
    "  form req {path} \"PATCH\" (filled record) \{} 200"
    ""
    "fn made req w:models/invalid"
    "  form req \"/{plural}\" \"POST\" (filled w.record) w.problems 422"
    ""
    "fn made _ w:web/denied"
    "  web/refusal w"
    ""
    "fn made _ w"
    "  web/redirect \"/{plural}/\{w.id}\""
    ""
    "fn changed req id w:models/invalid"
    "  form req {path} \"PATCH\" (filled w.record) w.problems 422"
    ""
    "fn changed _ _ w:web/denied"
    "  web/refusal w"
    ""
    "fn changed _ _ w:web/absent"
    "  web/refusal w"
    ""
    "fn changed _ id _"
    "  web/redirect \"/{plural}/\{id}\""
    ""
    "fn gone w:web/denied"
    "  web/refusal w"
    ""
    "fn gone w:web/absent"
    "  web/refusal w"
    ""
    "fn gone _"
    "  web/redirect \"/{plural}\""
    ""
    (comment (form_about singular))
    "fn form req path method fields problems code"
    "  page = views/{singular}_form_view path method fields problems"
    "  views/answer_as req code (views/layout_view \"{title}\" page)"
    ""
    (map_line "blank" "" fields (_ -> "\"\""))
    ""
    (map_line "fn filled r" "  " fields (f -> "\"\{r.{f.name}}\""))
    ""
    (picked_lines fields)
  ]
  text/join lines "\n"

# A nested resource's actions each take the parent's id after the request
# and the database, which places their routes under the parent's. A row is
# found only under its own parent, and a parent that is not there has none
# to list or make.
fn nested_actions singular plural fields parent
  k = parent.name
  name = parent_name parent
  parents = models/plural name
  about = [
    "A row of `{plural}` belongs to a {name}, so each action takes the"
    "{name}'s id and the routes nest under it: `index` answers"
    "GET /{parents}/:{k}/{plural}. A row is found only under its own {name},"
    "and a {name} that is not there has none to list or make."
  ]
  lines = [
    (comment (text/join about " "))
    "pub fn index req db {k}:int"
    "  number = models/page_number (web/value (web/query req) \"page\")"
    "  asked = {singular}/paged db \"{k}\" {k} number per_page"
    "  listing_of = (p -> effect (listing req {k} p))"
    "  within db {k} (asked .> listing_of)"
    ""
    (comment per_page_about)
    "per_page = 25"
    ""
    "pub fn show req db {k}:int id:int"
    "  under db {k} id .> (r -> effect (shown req r))"
    ""
    "pub fn new req db {k}:int"
    "  path = listed_path {k}"
    "  within db {k} (effect (form req path \"POST\" blank \{} 200))"
    ""
    "pub fn create req db {k}:int"
    "  given = put ({made_with fields} (web/form req.body)) \"{k}\" \"\{{k}}\""
    "  making = {singular}/create db given"
    "  made_of = (w -> effect (made req {k} w))"
    "  within db {k} (making .> made_of)"
    ""
    "pub fn edit req db {k}:int id:int"
    "  under db {k} id .> (r -> effect (editing req {k} id r))"
    ""
    "pub fn update req db {k}:int id:int"
    "  given = picked (web/form req.body)"
    "  under db {k} id"
    "    .> (r -> updating db id given r)"
    "    .> (w -> effect (changed req {k} id w))"
    ""
    "pub fn destroy _ db {k}:int id:int"
    "  under db {k} id"
    "    .> (r -> removing db id r)"
    "    .> (w -> effect (gone {k} w))"
    ""
    (comment "`then` when the {name} is there, and a 404 when it is not.")
    "fn within db id then"
    "  {name}/find db id .> (found -> held found then)"
    ""
    "fn held none _"
    "  effect http/not_found"
    ""
    "fn held _ then"
    "  then"
    ""
    (comment "The row with this id under this {name}, or none.")
    "fn under db {k} id"
    "  {singular}/find db id .> (r -> effect (owned {k} r))"
    ""
    "fn owned _ none"
    "  none"
    ""
    "fn owned {k} r"
    "  if (\"\{r.{k}}\" == \"\{{k}}\") r none"
    ""
    (comment "A write to a row under another {name} finds nothing.")
    "fn updating _ _ _ none"
    "  effect web/absent"
    ""
    "fn updating db id given _"
    "  {singular}/update db id given"
    ""
    "fn removing _ _ none"
    "  effect web/absent"
    ""
    "fn removing db id _"
    "  {singular}/destroy db id"
    ""
    "fn listed_path {k}"
    "  \"/{parents}/\{{k}}/{plural}\""
    ""
    "fn shown_path {k} id"
    "  \"\{listed_path {k}}/\{id}\""
    ""
  ]
  text/join lines "\n"

fn nested_helpers singular plural fields parent
  k = parent.name
  title = capitalized singular
  every_title = capitalized plural
  mine = own fields
  lines = [
    "fn listing req {k} p"
    "  as_json = {singular}/{singular}_attributes"
    "  mapped = list/to_list (list/map p.rows as_json)"
    "  return web/json 200 mapped if web/wants_json? req"
    "  page = views/{plural}_index_view {k} p.rows p.number p.more"
    "  views/answer_as req 200 (views/layout_view \"{every_title}\" page)"
    ""
    "fn shown _ none"
    "  http/not_found"
    ""
    "fn shown req record"
    "  attributes = {singular}/{singular}_attributes record"
    "  return web/json 200 attributes if web/wants_json? req"
    "  page = views/{singular}_shown_view record"
    "  views/answer_as req 200 (views/layout_view \"{title}\" page)"
    ""
    "fn editing _ _ _ none"
    "  http/not_found"
    ""
    "fn editing req {k} id record"
    "  form req (shown_path {k} id) \"PATCH\" (filled record) \{} 200"
    ""
    "fn made req {k} w:models/invalid"
    "  path = listed_path {k}"
    "  form req path \"POST\" (filled w.record) w.problems 422"
    ""
    "fn made _ _ w:web/denied"
    "  web/refusal w"
    ""
    "fn made _ {k} w"
    "  web/redirect (shown_path {k} w.id)"
    ""
    "fn changed req {k} id w:models/invalid"
    "  path = shown_path {k} id"
    "  form req path \"PATCH\" (filled w.record) w.problems 422"
    ""
    "fn changed _ _ _ w:web/denied"
    "  web/refusal w"
    ""
    "fn changed _ _ _ w:web/absent"
    "  web/refusal w"
    ""
    "fn changed _ {k} id _"
    "  web/redirect (shown_path {k} id)"
    ""
    "fn gone _ w:web/denied"
    "  web/refusal w"
    ""
    "fn gone _ w:web/absent"
    "  web/refusal w"
    ""
    "fn gone {k} _"
    "  web/redirect (listed_path {k})"
    ""
    (comment (form_about singular))
    "fn form req path method fields problems code"
    "  page = views/{singular}_form_view path method fields problems"
    "  views/answer_as req code (views/layout_view \"{title}\" page)"
    ""
    (map_line "blank" "" mine (_ -> "\"\""))
    ""
    (map_line "fn filled r" "  " mine (f -> "\"\{r.{f.name}}\""))
    ""
    (picked_lines mine)
  ]
  text/join lines "\n"

# The fields a form sends, as the change they make. A file input left empty
# sends "", and that keeps the file a row has, so its field is left out.
fn picked_lines fields
  value = (f -> "(web/value f \"{f.name}\")")
  files = attachments fields
  return map_line "fn picked f" "  " fields value if length files == 0
  quoted = list/to_list (list/map files (f -> "\"{f.name}\""))
  lines = [
    "fn picked f"
    (list_line "  without_empty_files (sent f)" "  " quoted)
    ""
    (map_line "fn sent f" "  " fields value)
    ""
    "fn without_empty_files given names"
    "  list/fold names given (m n -> if (m[n] == \"\") (delete m n) m)"
  ]
  text/join lines "\n"

# A new row takes every field as sent, an empty file field too, since it
# has no file to keep.
fn made_with fields
  if (length (attachments fields) == 0) "picked" "sent"

fn attachments fields
  list/to_list (list/select fields (f -> f.kind == "attachment"))

per_page_about = "How many rows a page of the list shows."

fn form_about singular
  about = [
    "The form a {singular} is made and changed with: its fields as typed,"
    "and the problem with each, if any."
  ]
  text/join about " "

# A map from each field's name, as a constant or a function's one line: on
# one line when it fits, and one entry to a line when it does not.
fn map_line head indent fields value
  ordered = list/sort (names_of fields)
  by_name = list/fold fields {} (m f -> put m f.name f)
  pairs = list/to_list (list/map ordered (n -> pair_of by_name[n] value))
  lead = lead_of head indent
  one = "{lead}\{ {text/join pairs " "} }"
  return one if length (last_line one) <= 80
  each = list/to_list (list/map pairs (p -> "{indent}  {p}"))
  "{lead}\{\n{text/join each "\n"}\n{indent}}"

fn pair_of none _
  ""

fn pair_of f value
  "\"{f.name}\":{value f}"

fn lead_of head ""
  "{head} = "

fn lead_of head indent
  "{head}\n{indent}"

fn last_line s
  parts = text/split s "\n"
  said parts[length parts]

fn capitalized word
  first = text/uppercase (said (text/slice word 1 1))
  "{first}{said (text/slice word 2 (length word))}"

# The views: a list, a record shown, and the form that makes and changes one.
pub fn index_view singular fields
  index_of singular fields (parent_of fields)

fn index_of singular fields none
  plural = models/plural singular
  first = (said_field (list/first fields)).name
  lines = [
    "takes rows number more"
    "header"
    "  h1 {capitalized plural}"
    "  p.lede"
    "    a href=\"/{plural}/new\" New {singular}"
    "ul.{plural}"
    "  each rows r ->"
    "    li"
    "      a href=\"/{plural}/\{r.id}\" = r.{first}"
  ]
  lines = list/concat lines (page_links "/{plural}")
  "{text/join lines "\n"}\n"

fn index_of singular fields parent
  plural = models/plural singular
  k = parent.name
  name = parent_name parent
  at = "/{models/plural name}/\{{k}}"
  first = (said_field (list/first (own fields))).name
  lines = [
    "takes {k} rows number more"
    "header"
    "  h1 {capitalized plural}"
    "  p.lede"
    "    a href=\"{at}/{plural}/new\" New {singular}"
    "    a href=\"{at}\" Back to the {name}"
    "ul.{plural}"
    "  each rows r ->"
    "    li"
    "      a href=\"{at}/{plural}/\{r.id}\" = r.{first}"
  ]
  lines = list/concat lines (page_links "{at}/{plural}")
  "{text/join lines "\n"}\n"

fn said_field none
  field "id" "" false

fn said_field f
  f

pub fn shown_view singular fields
  plural = models/plural singular
  shown_under singular fields (listed_at plural (parent_of fields))

# Where a resource's rows are listed: under the parent its row names, when
# it is nested.
fn listed_at plural none
  "/{plural}"

fn listed_at plural parent
  "/{models/plural (parent_name parent)}/\{row.{parent.name}}/{plural}"

fn shown_under singular fields at
  plural = models/plural singular
  each = spread (own fields) shown_lines
  head = [
    "takes row"
    "header"
    "  h1 {capitalized singular} \{row.id}"
    "  p.lede"
    "    a href=\"{at}\" All {plural}"
    "dl"
  ]
  lines = list/concat head each
  tail = [
    "p"
    "  a href=\"{at}/\{row.id}/edit\" Edit"
    "form method=\"post\" action=\"{at}/\{row.id}\""
    "  input type=\"hidden\" name=\"_method\" value=\"DELETE\""
    "  button Delete"
  ]
  "{text/join (list/concat lines tail) "\n"}\n"

# A field as the page shows it: its value, or a link to the file it keeps.
fn shown_lines f
  return ["  dt {f.name}" "  dd = row.{f.name}"] if f.kind != "attachment"
  [
    "  dt {f.name}"
    "  dd"
    "    if row.{f.name} != \"\""
    "      a href=\"/senro/blobs/\{row.{f.name}}\" open"
  ]

pub fn form_view singular fields
  plural = models/plural singular
  each = spread (own fields) field_lines
  head = [
    "takes path method fields problems"
    "header"
    "  h1 {capitalized singular}"
    "  p.lede"
    (back_link plural (parent_of fields))
    (form_line (attachments fields))
    "  input type=\"hidden\" name=\"_method\" value=method"
  ]
  lines = list/concat (list/concat head each) ["  button Save"]
  "{text/join lines "\n"}\n"

# A nested form's way back is the path it is sent to: the list it adds to,
# or the row it changes.
fn back_link plural none
  "    a href=\"/{plural}\" All {plural}"

fn back_link _ _
  "    a href=path Back"

# A form with a file in it is sent as multipart/form-data, which carries
# the file.
fn form_line files
  plain = "form method=\"post\" action=path"
  return plain if length files == 0
  "{plain} enctype=\"multipart/form-data\""

fn field_lines f
  return file_lines f if f.kind == "attachment"
  [
    "  label"
    "    | {f.name}"
    "    input name=\"{f.name}\" value=fields[\"{f.name}\"]"
    "  if problems[\"{f.name}\"] != none"
    "    p.problem = problems[\"{f.name}\"]"
  ]

# A file input shows no value, so the form says when the row keeps a file.
fn file_lines f
  [
    "  label"
    "    | {f.name}"
    "    input type=\"file\" name=\"{f.name}\""
    "  if fields[\"{f.name}\"] != \"\""
    "    p.kept Leave it empty to keep the file it has."
  ]

# The links to the pages either side of the one shown, each only when that
# page has rows.
fn page_links path
  [
    "nav.pages"
    "  if number > 1"
    "    a href=\"{path}?page=\{number - 1}\" Previous page"
    "  if more"
    "    a href=\"{path}?page=\{number + 1}\" Next page"
  ]
