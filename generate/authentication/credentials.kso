import "../../models"
import "../../passkeys"
import "../../routes"
import "../../web"
import "./credential"
import "./user"
import "std/net/http"

# An account's passkeys, added and removed from its page (`account`). A
# passkey is written by the app on the account's behalf, since its fields
# come from the authenticator, not a form; each action finds the account
# by the viewer the session names, so a visitor adds and removes only
# their own. One is added from the authenticator's answer to the challenge
# the account page was served with, checked as a sign-up's is.
pub fn create req db
  user/find_by db "email" (web/viewer req) .> (u -> adding req db u)

fn adding _ _ none
  effect http/not_found

fn adding req db u
  f = web/input req
  asked = said (web/session req)["passkey"]
  client = field_bytes f "passkey_client"
  data = field_bytes f "passkey_data"
  passkeys/expected_for req asked
    .> (want -> effect (passkeys/registered want client data))
    .> (c -> added db u c)

fn added _ _ r:passkeys/refusal
  told = "That passkey could not be added: {r.reason}."
  effect (web/redirect (routes/path_to "account/show") told)

fn added db u c
  key = {
    "counter":"{c.counter}"
    "key_id":c.id
    "user_id":"{u.id}"
    "x":(passkeys/url_spelled c.x)
    "y":(passkeys/url_spelled c.y)
  }
  credential/create (models/as_app db) key
    .> (_ -> effect (back "Passkey added."))

# A passkey removed, when it is the viewer's own. Another's is not there.
pub fn destroy req db id:int
  user/find_by db "email" (web/viewer req)
    .> (u -> credential/find db id .> (k -> removing db (owner_of u) k))

fn owner_of none
  "none"

fn owner_of u
  "{u.id}"

fn removing _ _ none
  effect http/not_found

fn removing db owner k
  return effect http/not_found if "{k.user_id}" != owner
  credential/destroy (models/as_app db) k.id
    .> (_ -> effect (back "Passkey removed."))

fn back told
  web/redirect (routes/path_to "account/show") told

fn field_bytes f name
  or_empty (passkeys/url_read (web/value f name))

fn or_empty none
  []

fn or_empty bytes
  bytes

fn said none
  ""

fn said s
  s
