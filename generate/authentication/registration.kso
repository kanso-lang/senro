import "../../models"
import "../../passwords"
import "../../routes"
import "../../web"
import "./account_mailer"
import "./user"
import "./views"
import "std/io"
import "std/text"

# Anyone may make an account, as Devise's registerable lets them, and the
# registration is a singular resource: /registration/new and /registration.
pub without_sign_in = ["create" "new"]

pub fn new req _
  effect (opened req "" {} 200)

# An account needs an address nobody holds and a password of eight
# characters or more. The address is looked up before the password is
# stretched, so a sign-up that cannot succeed costs no hashing.
pub fn create req db
  f = web/input req
  email = text/lowercase (text/trim (web/value f "email"))
  password = web/value f "password"
  user/find_by db "email" email
    .> (held -> joined req db email password (held != none))

fn joined req db email password taken
  short = "Use eight characters or more."
  found = models/problems [
    (models/email_address "email" email)
    (models/rule "email" taken "That address has an account.")
    (models/rule "password" (length password < 8) short)
  ]
  return effect (opened req email found 422) if models/problems? found
  passwords/digested password
    .> (d -> user/create db (fields_of email d))
    .> (w -> made req db w)

fn fields_of email digest
  { "digest":digest "email":email }

# A new account is mailed a link to confirm its address, and signs in once
# it has followed it, as Devise's confirmable asks.
fn made req db kept:user/user
  account_mailer/confirmation req db "{kept.id}" kept.email
    .? (u -> io/write_err "no confirmation mail: {u.reason}\n")
    .> (_ -> effect (web/redirect (routes/path_to "session/new") sent))

fn made _ _ _
  effect web/denied

sent = "Welcome. We have mailed you a link to confirm your address."

# The sign-up form shows the address as typed and the problem with each
# field, if any. A password is never sent back.
fn opened req email problems code
  heading = "Make an account"
  to = routes/path_to "registration/create"
  page = views/door_view heading to email problems "" false
  views/answer req code heading page
