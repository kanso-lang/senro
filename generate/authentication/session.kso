import "../../accounts"
import "../../models"
import "../../passwords"
import "../../routes"
import "../../web"
import "./user"
import "./views"
import "std/text"
import "std/time"

# What a sign-in checks of the account an address holds, and when and from
# where it last signed in. An address with no account holds the stand-in
# digest, which no password matches.
type holder
  id
  email
  digest
  locked
  was_at
  was_ip

# The key that signs every session, which senro reads by its name.
# `generate authentication` made it at random for development; a deployed
# app sets `SENRO_SECRET` instead, which senro reads in its place, so the
# real one stays out of the repository. Changing it signs every visitor out.
pub secret = "SECRET"

# One address may try to sign in ten times in three minutes, as Rails 8's
# generated sessions controller allows. Past that, `over_limit` answers the
# sign-in page again, saying why.
pub rate_limits = { "create":"10 per 3 minutes" }

pub without_sign_in = ["create" "new"]

# Five wrong passwords in a row lock an account for an hour, as Devise's
# `lockable` does. A right password ends the run of wrong ones, and each
# sign-in is counted and stamped, as its `trackable` does (`accounts`).
pub locks_after = 5

pub locked_minutes = 60

# What a sign-in rests on: the digest the account keeps now. A new password
# changes it, so a password reset signs out every session made before it.
pub signed_against = (db email -> user/find_by db "email" email .> kept_of)

fn kept_of u
  effect (digest_in u)

fn digest_in none
  ""

fn digest_in u
  u.digest

# Signing in and out. The session is the signed cookie `web` keeps, and
# signing in writes the account's address into it as the viewer.
pub fn new req _
  effect (opened req "" {} 200)

# An address with no account is checked against the stand-in at the same
# cost, so a refusal takes as long whether or not the account exists, and
# says the same thing.
pub fn create req db
  f = web/input req
  email = text/lowercase (text/trim (web/value f "email"))
  password = web/value f "password"
  user/find_by db "email" email
    .> (u -> held u)
    .> (a -> time/now .> (t -> entered req db email a password t))

fn held none
  passwords/stand_in .> (d -> effect (holder "" "" d "" "" ""))

fn held u
  at = u.current_sign_in_at
  effect (holder "{u.id}" u.email u.digest u.locked at u.current_sign_in_ip)

# A locked account answers a wrong password as any wrong password is
# answered, and tells only the holder of the right one that it is locked.
fn entered req db email a password t
  right = passwords/matches? password a.digest
  return effect (shut req email right) if still_locked? a t
  return missed req db email a t if not right
  accounts/arrived req db user/user_model a.id a.was_at a.was_ip t
    .> (_ -> signed req a)

fn still_locked? a t
  accounts/locked? a.locked locked_minutes t

fn shut req email true
  told = "This account is locked. Try again in {locked_minutes} minutes."
  opened req email { "password":told } 403

fn shut req email false
  refused req email

# A wrong password counts against the account, and the one that makes the
# run long enough locks it.
fn missed req db email a t
  return effect (refused req email) if a.id == ""
  accounts/missed db user/user_model a.id a.locked
    .> (counted -> locking req db email a counted t)

fn locking req _ email _ _:web/absent _
  effect (refused req email)

fn locking req db email a counted t
  return effect (refused req email) if counted.failures != locks_after
  accounts/locked_at db user/user_model a.id t
    .> (_ -> effect (refused req email))

fn signed req a
  s = web/session req
  back = web/return_to req (routes/path_to "home/index")
  home = web/redirect back "Signed in."
  effect (web/signed_in req home (delete s "return_to") a.email a.digest)

fn refused req email
  wrong = { "password":"That address and password do not match." }
  opened req email wrong 422

pub fn over_limit req
  wait = { "password":"Too many tries. Try again in a few minutes." }
  effect (opened req "" wait 429)

# Signing out keeps the rest of the session and forgets the sign-in.
pub fn destroy req _
  s = web/signed_out (web/session req)
  r = web/redirect (routes/path_to "session/new") "Signed out."
  effect (web/kept req r s)

# The sign-in form shows the address as typed, the problem if any, and the
# notice the request carries.
fn opened req email problems code
  notice = web/notice req
  to = routes/path_to "session/create"
  page = views/door_view "Sign in" to email problems notice true
  views/answer req code "Sign in" page
