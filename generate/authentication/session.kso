import "../../accounts"
import "../../models"
import "../../passkeys"
import "../../passwords"
import "../../routes"
import "../../web"
import "./account_mailer"
import "./credential"
import "./user"
import "./views"
import "std/io"
import "std/text"
import "std/time"

# What a sign-in checks of the account an address holds, and when and from
# where it last signed in. An address with no account holds the stand-in
# digest, which no password matches. An account signs in once its address
# is confirmed (`active`).
type holder
  id
  email
  digest
  locked
  was_at
  was_ip
  active

# The key that signs every session, which senro reads by its name.
# `generate authentication` made it at random for development; a deployed
# app sets `SENRO_SECRET` instead, which senro reads in its place, so the
# real one stays out of the repository. Changing it signs every visitor out.
pub secret = "SECRET"

# One address may try to sign in ten times in three minutes, as Rails 8's
# generated sessions controller allows. Past that, `over_limit` answers the
# sign-in page again, saying why.
pub rate_limits = { "create":"10 per 3 minutes" }

pub without_sign_in = ["create" "new"]

# Five wrong passwords in a row lock an account for an hour, or until the
# link mailed to its address unlocks it, as Devise's `lockable` does. A
# right password ends the run of wrong ones, and each sign-in is counted
# and stamped, as its `trackable` does (`accounts`).
pub locks_after = 5

pub locked_minutes = 60

# What a sign-in rests on: the digest the account keeps now. A new password
# changes it, so a password reset signs out every session made before it.
pub signed_against = (db email -> user/find_by db "email" email .> kept_of)

fn kept_of u
  effect (digest_in u)

fn digest_in none
  ""

fn digest_in u
  u.digest

# Signing in and out. The session is the signed cookie `web` keeps, and
# signing in writes the account's address into it as the viewer. The form
# offers a passkey first, and `?with=password` an address and a password.
pub fn new req _
  opened req "" {} 200

# With a passkey, the browser has asked the authenticator to sign the
# challenge the form was served with, and the credential it names checks
# the signature. Otherwise an address with no account is checked against
# the stand-in at the same cost, so a refusal takes as long whether or not
# the account exists, and says the same thing.
pub fn create req db
  f = web/input req
  return keyed req db f if web/value f "passkey_id" != ""
  email = text/lowercase (text/trim (web/value f "email"))
  password = web/value f "password"
  user/find_by db "email" email
    .> (u -> held u)
    .> (a -> time/now .> (t -> entered req db email a password t))

fn held none
  passwords/stand_in .> (d -> effect (holder "" "" d "" "" "" true))

fn held u
  at = u.current_sign_in_at
  from = u.current_sign_in_ip
  ready = u.confirmed != ""
  effect (holder "{u.id}" u.email u.digest u.locked at from ready)

# What a sign-in comes to is `accounts`' to decide: the password checked,
# the lock kept, and a right password counted and stamped. A locked account
# tells only the holder of the right password that it is locked, and the
# wrong password that locks it mails the link that unlocks it. The right
# password for an address not yet confirmed sends the confirmation again.
fn entered req db email a password t
  model = user/user_model
  accounts/attempt req db model a password locks_after locked_minutes t
    .> (v -> answered req db email a v)

fn answered req db email a v
  return signed req a if v.outcome == "signed"
  return unconfirmed req db email a if v.outcome == "inactive"
  return shut req email if v.outcome == "locked"
  return refused req email if v.stamp == ""
  account_mailer/unlock req db a.id a.email v.stamp
    .? (u -> io/write_err "no unlock mail: {u.reason}\n")
    .> (_ -> refused req email)

fn shut req email
  told = "This account is locked. Follow the link we mailed to unlock it."
  opened req email { "password":told } 403

fn unconfirmed req db email a
  first = "Confirm your address first. We have sent the link again."
  account_mailer/confirmation req db a.id a.email
    .? (u -> io/write_err "no confirmation mail: {u.reason}\n")
    .> (_ -> opened req email (put {} (field_of req) first) 403)

# Where a problem with a sign-in shows: under the password, or, on the
# passkey form, under its button.
fn field_of req
  if (web/value (web/input req) "passkey_id" == "") "password" "passkey"

# A passkey sign-in: the credential the authenticator names, its signature
# checked over what it signed, and its count moved on. A passkey proves
# what a password and a second factor would, so it is not counted against
# the lock that wrong passwords run up; its account must still be
# confirmed.
fn keyed req db f
  credential/find_by db "key_id" (web/value f "passkey_id")
    .> (row -> stored req db f row)

fn stored req _ _ none
  unknown = "That passkey is not one this app knows."
  opened req "" { "passkey":unknown } 422

fn stored req db f row
  asked = said (web/session req)["passkey"]
  x = or_empty (passkeys/url_read row.x)
  y = or_empty (passkeys/url_read row.y)
  key = passkeys/kept row.key_id x y row.counter
  client = field_bytes f "passkey_client"
  data = field_bytes f "passkey_data"
  signature = field_bytes f "passkey_signature"
  passkeys/expected_for req asked
    .> (want -> effect (passkeys/asserted want key client data signature))
    .> (n -> counted req db row n)

fn counted req _ _ r:passkeys/refusal
  told = { "passkey":"That passkey could not be used: {r.reason}." }
  opened req "" told 422

fn counted req db row n
  credential/update (models/as_app db) row.id { "counter":"{n}" }
    .> (_ -> user/find db row.user_id)
    .> (u -> keyed_in req db u)

fn keyed_in req _ none
  opened req "" { "passkey":"That passkey's account is gone." } 422

fn keyed_in req db u
  return signed req u if u.confirmed != ""
  unconfirmed req db u.email (holder "{u.id}" u.email u.digest "" "" "" false)

fn field_bytes f name
  or_empty (passkeys/url_read (web/value f name))

fn or_empty none
  []

fn or_empty bytes
  bytes

fn said none
  ""

fn said s
  s

fn signed req a
  s = web/session req
  back = web/return_to req (routes/path_to "home/index")
  home = web/redirect back "Signed in."
  effect (web/signed_in req home (delete s "return_to") a.email a.digest)

fn refused req email
  wrong = { "password":"That address and password do not match." }
  opened req email wrong 422

pub fn over_limit req
  wait = { "password":"Too many tries. Try again in a few minutes." }
  opened req "" wait 429

# Signing out keeps the rest of the session and forgets the sign-in.
pub fn destroy req _
  s = web/signed_out (web/session req)
  r = web/redirect (routes/path_to "session/new") "Signed out."
  effect (web/kept req r s)

# The sign-in form shows the address as typed, the problem if any, and the
# notice the request carries. Each showing makes a new challenge for a
# passkey, kept in the session for the answer to match. A problem with a
# password shows the password form again.
fn opened req email problems code
  asked_for = web/value (web/query req) "with" == "password"
  pw = asked_for or problems["password"] != none
  passkeys/challenge .> (c -> effect (offered req email problems code c pw))

fn offered req email problems code c pw
  notice = web/notice req
  to = routes/path_to "session/create"
  page = views/door_view to email problems notice true c pw ""
  s = put (web/session req) "passkey" c
  web/kept req (views/answer req code "Sign in" page) s
