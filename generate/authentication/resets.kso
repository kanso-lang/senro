import "../../bots"
import "../../models"
import "../../passwords"
import "../../routes"
import "../../tokens"
import "../../web"
import "./account_mailer"
import "./user"
import "./views"
import "std/io"
import "std/text"
import "std/time"

# A visitor who has lost a password asks for a link by email, follows it,
# and chooses a new one, as Rails 8's generated PasswordsController has it.
# The link carries a token `tokens/made` signs over the account and the
# digest it keeps, so nothing is stored, and a link works once and for
# fifteen minutes.
pub without_sign_in = ["create" "edit" "new" "update"]

# Each request sends a letter, so one client asks at most ten times an
# hour, and the form cannot be used to fill someone's inbox.
pub rate_limits = { "create":"10 per hour" }

# And every client together asks at most a hundred times a day.
pub everyone_limits = { "create":"100 per day" }

pub fn new req _
  asked req 200 {}

# The answer is the same whether or not the address has an account, and
# whether or not the mail could be queued, so the form says nothing about
# which addresses are registered. A failure to queue goes to standard error,
# and the worker logs a failure to send. A request Turnstile does not take
# for a person's (`bots`) sends nothing and is asked again.
pub fn create req db
  f = web/input req
  bots/verified req f .> (person -> requested req db f person)

fn requested req _ _ false
  asked req 422 { "bot":not_a_person }

fn requested req db f true
  email = text/lowercase (text/trim (web/value f "email"))
  user/find_by db "email" email
    .> (u -> sent req db u)
    .? (u -> io/write_err "no reset mail: {u.reason}\n")
    .> (_ -> effect (web/redirect (routes/path_to "session/new") on_its_way))

on_its_way = "If that address has an account, a link is on its way to it."

fn sent _ _ none
  effect ""

fn sent req db u
  account_mailer/reset req db u.id u.email u.digest

# The `id` a reset's member routes take is the token itself.
pub fn edit req db id
  checked req db id .> (good -> offered req id good)

fn offered req token true
  effect (chosen req token 200)

fn offered _ _ false
  effect (web/redirect (routes/path_to "resets/new") expired)

expired = "That link has expired or was used. Ask for another."

# A new password, which the app chooses and shows once (kanso#2515), set
# through a link that is still good. Following the link only shows a button,
# so a mail scanner that opens links changes nothing. Setting the password
# changes the digest, which is what retires the link and ends every sign-in
# made with the old password.
pub fn update req db id
  checked req db id .> (good -> chose req db id good)

fn chose _ _ _ false
  effect (web/redirect (routes/path_to "resets/new") expired)

fn chose req db token true
  id = id_text (tokens/id_of token)
  passwords/chosen .> (p -> renewed req db id p)

fn renewed req db id password
  passwords/digested password
    .> (d -> user/update (models/as_app db) id { "digest":d })
    .> (_ -> effect (shown req password))

fn shown req password
  heading = "Your new password"
  page = views/password_shown_view heading password changed
  views/answer req 200 heading page

changed = "Save this password in your password manager: it is shown once."

# Whether `token` is good now for the account it names.
fn checked req db token
  id = id_text (tokens/id_of token)
  user/find db id .> (u -> time/now .> (t -> effect (good? req token u t)))

fn good? _ _ none _
  false

fn good? req token u t
  tokens/valid? "reset" req token u.digest t

fn id_text none
  "0"

fn id_text n
  "{n}"

fn asked req code problems
  bots/site_key .> (k -> effect (asked_with req code problems k))

fn asked_with req code problems key
  page = views/reset_asked_view (web/notice req) problems key
  views/answer req code "Forgot your password" page

not_a_person = "We could not tell that a person sent this. Try again."

fn chosen req token code
  page = views/reset_chosen_view (routes/path_to "resets/update" token)
  views/answer req code "A new password" page
