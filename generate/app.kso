import "std/list"
import "std/text"

# What `generate new` writes for an app, as `rails new` does: an entry that
# connects to the Postgres the environment names and starts the app with
# `app/run`, which runs its migrations and serves its routes, with a worker
# beside the server for its jobs and one for its mail when it has them; a
# home page; a layout; and Bootstrap, with a theme, to style them. Its
# migrations go in `migrations/`, which starts empty. Each function answers
# a file's text.
pub fn entry senro name
  lines = [
    "import \"{senro}/app\""
    "import \"{senro}/pg\""
    "import \"./home\""
    "import \"./migrations\""
    "import \"./views\""
    ""
    "derive app/conventions"
    ""
    "# The database comes from PGHOST, PGPORT, PGUSER, PGDATABASE and"
    "# PGPASSWORD, as libpq reads them, so the app runs wherever its host"
    "# sets them."
    "connected = pg/from_env"
    ""
    "app/run \"{name}\" routes connected derived"
  ]
  "{text/join lines "\n"}\n"

pub fn home name
  lines = [
    "import \"./views\""
    ""
    "pub fn index req _"
    "  page = views/home_view \"{name}\""
    "  effect (views/answer req 200 \"{name}\" page)"
  ]
  "{text/join lines "\n"}\n"

# The layout every page is drawn in: Bootstrap's navbar with the app's name,
# and a container for the page.
pub fn layout name
  lines = [
    "takes title body"
    "doctype html"
    "html lang=\"en\""
    "  head"
    "    meta charset=\"utf-8\""
    "    meta name=\"viewport\" content=\"width=device-width, initial-scale=1\""
    "    title = title"
    "    link rel=\"stylesheet\" href=\"/stylesheets/application.css\""
    "    script src=\"/senro.js\" defer=\"defer\""
    "  body"
    "    nav.navbar.mb-5"
    "      div.container"
    "        a.navbar-brand href=\"/\" {name}"
    "    main.container.pb-5"
    "      == body"
  ]
  "{text/join lines "\n"}\n"

pub home_view = text/join home_lines "\n"

home_lines = [
  "takes name"
  "div.py-4"
  "  h1 = name"
  "  p.lede A senro app. Its resources are listed in main.kso."
  ""
]

# The packages the app's stylesheet imports, and jspm's generator, which
# `senro js install` runs from the app's own node_modules.
pub fn packages name
  lines = [
    "\{"
    "  \"name\": \"{name}\","
    "  \"private\": true,"
    "  \"dependencies\": \{"
    "    \"@fontsource-variable/inter\": \"5.1.1\","
    "    \"@fontsource-variable/space-grotesk\": \"5.1.1\","
    "    \"bootstrap\": \"5.3.3\""
    "  },"
    "  \"devDependencies\": \{"
    "    \"@jspm/generator\": \"2.18.0\""
    "  }"
    "}"
  ]
  "{text/join lines "\n"}\n"

pub script = text/join script_lines "\n"

script_lines = [
  "// The app's JavaScript. senro's page script loads this module on every"
  "// page; the app needs none of its own yet."
  ""
]

# The stylesheets `new` copies from senro's tree into the app's, which owns
# them from then on.
pub sheets = ["stylesheets/application.css" "stylesheets/theme.css"]

pub sheets_source = "generate"

local = "import \"./"

# An entry's text with `import "./<name>"` added among its own imports, in
# order, or none when it imports nothing of its own to sit beside.
pub fn entry_with old name
  lines = text/split old "\n"
  wanted = "import \"./{name}\""
  own = list/to_list (list/select lines (l -> text/starts_with? l local))
  return none if length own == 0
  return old if list/any? own (l -> l == wanted)
  after = list/to_list (list/select own (l -> l < wanted))
  placed (said_line (list/last after)) (said_line (list/first own)) lines wanted

fn placed "" first lines wanted
  joined (list/to_list (list/map lines (l -> before l first wanted)))

fn placed after _ lines wanted
  joined (list/to_list (list/map lines (l -> behind l after wanted)))

fn before line first wanted
  return "{wanted}\n{line}" if line == first
  line

fn behind line after wanted
  return "{line}\n{wanted}" if line == after
  line

fn joined lines
  text/join lines "\n"

fn said_line none
  ""

fn said_line l
  l
