import "../models"
import "./app"
import "./auth"
import "./controller"
import "./scaffold"
import "std/io"
import "std/list"
import "std/os"
import "std/text"

# senro's generators, run from senro's own directory:
#
#   kanso run generate -- new apps/notebook
#   kanso run generate -- scaffold apps/notebook note title:text body:int
#   kanso run generate -- authentication apps/notebook
#
# Each prints the files it writes, as Rails' generators do. Nothing is
# written over: a file that is there already stops the generator before it
# writes anything. The app's imports of senro climb from the app's
# directory to this one, so the app's path is taken relative to it.
pub fn run args
  rest = list/to_list (list/drop args 1)
  chosen (said (list/first args)) rest

fn chosen "new" rest
  made_new (said (list/first rest))

fn chosen "scaffold" rest
  app = said (list/first rest)
  singular = said (list/first (list/drop rest 1))
  words = list/to_list (list/drop rest 2)
  return usage if app == "" or singular == "" or length words == 0
  named = scaffold/resource_named singular
  return refused "cannot name a resource `{singular}`: {named}" if named != ""
  given (scaffold/fields_of words) app singular

fn chosen "controller" rest
  app = said (list/first rest)
  plural = said (list/first (list/drop rest 1))
  actions = list/to_list (list/drop rest 2)
  return usage if app == "" or plural == "" or length actions == 0
  named = scaffold/resource_named plural
  odd = list/to_list (list/select actions (a -> not controller/known? a))
  return refused "cannot name a controller `{plural}`: {named}" if named != ""
  return refused (controller/unknown odd[1]) if length odd > 0
  os/exists "{app}/{plural}.kso"
    .> (there -> controlled there app plural actions)

fn chosen "authentication" rest
  app = said (list/first rest)
  return usage if app == ""
  os/exists "{app}/main.kso" .> (there -> authenticated there app)

fn chosen _ _
  usage

usage = refused (text/join usage_lines "\n")

usage_lines = [
  "usage: kanso run generate -- new <app>"
  "       kanso run generate -- scaffold <app> <singular> <name:kind>..."
  "       kanso run generate -- controller <app> <plural> <action>..."
  "       kanso run generate -- authentication <app>"
  "a kind is text, int, references or attachment"
]

fn refused why
  io/write_err "generate: {why}\n" .> (_ -> os/exit 2)

# The path from an app's directory back up to senro's, one `..` for each
# directory the app's path names.
fn up_from app
  steps = list/to_list (list/select (text/split app "/") (s -> s != "."))
  ups = list/to_list (list/map steps (_ -> ".."))
  text/join ups "/"

fn last_of app
  steps = text/split app "/"
  said steps[length steps]

fn made_new ""
  usage

fn made_new app
  os/exists app .> (there -> new_app there app)

fn new_app true app
  refused "{app} is there already"

# Run as `senro new`, the command says where senro is (SENRO_HOME) and where
# it was run from, and the app imports senro by the path between the two.
# Run from senro's own directory, the path is the way back up from the app.
fn new_app false app
  os/env "SENRO_HOME"
    .> (home -> os/env "PWD" .> (here -> laid app (senro_from home here app)))

fn senro_from none _ app
  up_from app

fn senro_from home here app
  return up_from app if said here == ""
  between (parts_of (under (said here) app)) (parts_of home)

fn under here app
  return app if text/starts_with? app "/"
  "{here}/{app}"

fn parts_of path
  list/to_list (list/select (text/split path "/") (s -> s != "" and s != "."))

# The relative path from the directory `from` names to the one `to` names,
# both given as their parts from the root.
fn between from to
  same = shared from to 0
  ups = list/to_list (list/map (list/drop from same) (_ -> ".."))
  steps = list/concat ups (list/to_list (list/drop to same))
  return "." if length steps == 0
  text/join steps "/"

fn shared from to n
  return n if n >= length from or n >= length to
  return n if from[n + 1] != to[n + 1]
  shared from to (n + 1)

fn laid app senro
  name = last_of app
  os/make_dir app
    .> (_ -> os/make_dir "{app}/views")
    .> (_ -> written "{app}/main.kso" (app/entry senro name))
    .> (_ -> written "{app}/home.kso" (app/home name))
    .> (_ -> written "{app}/migrations.kso" app/migrations)
    .> (_ -> written "{app}/views/layout.kata" app/layout)
    .> (_ -> written "{app}/views/home.kata" app/home_view)

# Where an app that is there already keeps senro: the path its entry
# imports `models` by. An entry that imports none falls back to the way up
# from the app's path, which is right when the command runs in senro's
# directory.
fn senro_in main fallback
  lines = text/split main "\n"
  found = list/to_list (list/select lines senro_line?)
  return fallback if length found == 0
  said (text/slice found[1] 9 (length found[1] - 8))

fn senro_line? l
  text/starts_with? l "import \"" and text/ends_with? l "/models\""

fn controlled true app plural _
  refused "{app}/{plural}.kso is there already"

fn controlled false app plural actions
  os/read_file "{app}/main.kso" .> (m -> with_actions app plural actions m)

fn with_actions app _ _ _:os/file_not_found
  refused "{app}/main.kso is not there; make the app with `new` first"

fn with_actions app plural actions main
  os/env "PWD" .> (here -> acted app plural actions main (app_name app here))

fn acted app plural actions main name
  senro = senro_in main (up_from app)
  entry = app/entry_with main plural
  bare = "{app}/main.kso imports nothing of its own"
  return refused bare if entry == none
  shown = list/to_list (list/select actions controller/shows?)
  views = "{app}/views"
  os/is_dir views
    .> (there -> made_dir there views)
    .> (_ -> written "{app}/{plural}.kso" (module_of senro name plural actions))
    .> (_ -> list/fold shown (effect "") (viewed views plural))
    .> (_ -> changed "{app}/main.kso" (said entry))

fn module_of senro name plural actions
  controller/module senro name plural actions

fn viewed views plural
  (acc a -> acc .> (_ -> view_written views plural a))

fn view_written views plural a
  path = "{views}/{controller/view_file plural a}"
  written path (controller/view plural a)

# The app's name is its directory's: the last part of its path, or of where
# the command was run when the path is `.`.
fn app_name "." here
  last_of (said here)

fn app_name app _
  last_of app

fn written path content
  os/write_file path content .> (_ -> io/write "  create {path}\n")

fn given f:scaffold/unreadable _ _
  refused "cannot read `{f.word}`: {f.why}"

fn given fields app singular
  plural = models/plural singular
  module = "{app}/{plural}.kso"
  os/exists module .> (there -> fresh there app singular fields)

fn fresh true app singular _
  refused "{app}/{models/plural singular}.kso is there already"

fn fresh false app singular fields
  nested_in app singular fields (scaffold/parent_of fields)

# A nested resource's parent is a resource of the same app already.
fn nested_in app singular fields none
  read_main app singular fields

fn nested_in app singular fields parent
  parents = models/plural (scaffold/parent_name parent)
  module = "{app}/{parents}.kso"
  os/exists module .> (there -> parent_there there app singular fields parents)

fn parent_there false app singular _ parents
  refused "{app} has no {parents} to nest {models/plural singular} under"

fn parent_there true app singular fields _
  read_main app singular fields

fn read_main app singular fields
  os/read_file "{app}/main.kso" .> (main -> with_main app singular fields main)

fn with_main app _ _ _:os/file_not_found
  refused "{app}/main.kso is not there; make the app with `new` first"

fn with_main app singular fields main
  os/read_file "{app}/migrations.kso"
    .> (m -> wrote app singular fields main (text_of m))

fn text_of _:os/file_not_found
  ""

fn text_of m
  m

fn wrote app singular fields main old
  plural = models/plural singular
  senro = senro_in main (up_from app)
  entry = with_resource (app/entry_with main singular) plural
  migrations = migrated old senro plural fields
  bare = "{app}/main.kso imports nothing of its own"
  long = "{app}/migrations.kso has no `all` this can read"
  return refused bare if entry == none
  return refused long if migrations == none
  model = scaffold/model senro singular fields
  module = scaffold/resource senro singular fields
  index = scaffold/index_view singular fields
  shown = scaffold/shown_view singular fields
  form = scaffold/form_view singular fields
  views = "{app}/views"
  os/is_dir views
    .> (there -> made_dir there views)
    .> (_ -> written "{app}/{singular}.kso" model)
    .> (_ -> written "{app}/{plural}.kso" module)
    .> (_ -> written "{views}/{plural}_index.kata" index)
    .> (_ -> written "{views}/{singular}_shown.kata" shown)
    .> (_ -> written "{views}/{singular}_form.kata" form)
    .> (_ -> changed "{app}/migrations.kso" (said migrations))
    .> (_ -> changed "{app}/main.kso" (said entry))

# The entry imports the model's module and the resource's, since a
# derivation reads the modules the entry names.
fn with_resource none _
  none

fn with_resource entry plural
  app/entry_with entry plural

fn migrated "" senro plural fields
  scaffold/migrations_new senro plural fields

fn migrated old senro plural fields
  return scaffold/migrations_new senro plural fields if not changes? old
  scaffold/migrations_with old plural fields

# Whether a migrations module holds a change yet. One that holds none has
# no import of senro to build on.
fn changes? old
  list/any? (text/split old "\n") (l -> text/starts_with? l "import \"")

fn made_dir true _
  effect ""

fn made_dir false path
  os/make_dir path

fn changed path content
  os/write_file path content .> (_ -> io/write "  change {path}\n")

fn said none
  ""

fn said s
  s

fn authenticated false app
  refused "{app}/main.kso is not there; make the app with `new` first"

fn authenticated true app
  paths = list/to_list (list/map auth/copied (f -> "{app}/{f}"))
  list/fold paths (effect "") (acc p -> acc .> (seen -> first_there seen p))
    .> (there -> unwritten there app)

fn first_there "" path
  os/exists path .> (t -> effect (there_if t path))

fn first_there seen _
  effect seen

fn there_if true path
  path

fn there_if false _
  ""

fn unwritten "" app
  os/read_file "{app}/main.kso" .> (main -> with_migrations app main)

fn with_migrations app main
  os/read_file "{app}/migrations.kso" .> (m -> signing app main m)

fn unwritten there _
  refused "{there} is there already"

fn signing app main m
  senro = senro_in main (up_from app)
  entry = auth/entry_signed main senro
  migrations = migrated (text_of m) senro "users" users
  moved = "{app}/main.kso no longer serves as `new` wrote it"
  return refused moved if entry == none
  os/random_bytes 32
    .> (b -> copied app senro (auth/secret_of b))
    .> (_ -> changed "{app}/migrations.kso" (said migrations))
    .> (_ -> changed "{app}/main.kso" (said entry))

users = scaffold/fields_of auth/fields

fn copied app senro secret
  views = "{app}/views"
  os/is_dir views
    .> (there -> made_dir there views)
    .> (_ -> list/fold auth/copied (effect "") (later app senro secret))

fn later app senro secret
  (acc f -> acc .> (_ -> copy app senro secret f))

fn copy app senro secret f
  os/read_file "{app}/{senro}/{auth/source}/{f}"
    .> (t -> written "{app}/{f}" (auth/localized t senro secret))
