import "std/derive"
import "std/list"
import "std/text"

# What an action asks the server for before it can answer: the calls, each
# a provider's name and its arguments, and what to do with their answers.
# An action that reads data the browser does not hold answers one of these
# instead of its next state. The page sends every call in it to the server
# in one request, then runs the action again with the answers, and the
# action, which is a function of its state and those answers alone, comes
# to the same `asked` and goes on past it.
pub type asked
  calls
  rest

# What a module's `provided` is: each provider's answering half by its name,
# and beside it the modules whose pages may ask for it.
pub type provided_table
  answers
  pages

# A call to the provider `name` with `args`, whose answer is the value the
# provider gave.
pub fn ask name args
  asked [[name args]] (xs -> xs[1])

# `a`, then `f` of what it answers.
pub fn then a f
  later a f

fn later (asked calls rest) f
  asked calls (xs -> later (rest xs) f)

fn later v f
  f v

# Every one of `asks` in one request, answering the list of their answers.
# Calls that wait on no other are sent together, however many there are.
pub fn all asks
  list/fold asks (asked [] (_ -> [])) joined

fn joined acc a
  n = length acc.calls
  calls = list/concat acc.calls (calls_of a)
  asked calls (xs -> paired (acc.rest (first xs n)) (rest_of a (after xs n)))

fn calls_of (asked calls _)
  calls

fn calls_of _
  []

fn rest_of (asked _ rest) xs
  rest xs

fn rest_of v _
  v

fn paired so_far v
  later so_far (held -> later v (one -> push held one))

fn first xs n
  list/to_list (list/take xs n)

fn after xs n
  list/to_list (list/drop xs n)

# The value an action answered, carried through each round of answers the
# page has. It is an `asked` still when the rounds run out, and the page
# sends its calls for the next round.
pub fn settled v rounds
  through v rounds 1

fn through (asked calls rest) rounds i
  return asked calls rest if length rounds < i
  through (rest rounds[i]) rounds (i + 1)

fn through v _ _
  v

# Whether `v` still asks the server for something.
pub fn asking? (asked _ _)
  true

pub fn asking? _
  false

# The calls `v` asks for, each its provider's name and its arguments.
pub fn calls_in v
  calls_of v

# The derivation that lets an action call a provider as it calls any
# function:
#
#   derive data/providers
#
# A provider is a function whose first two parameters are the viewer and a
# database session, `viewer db` or `_` for either. Wherever the app calls
# one with two arguments fewer, as an action in the browser does with
# `stock/low 3`, the provider's module gets a function of that many, which
# asks the server for the provider's answer, and the provider's own body runs
# only on the server. The module also gets `provided`, the table the server
# answers those calls from (`web/providers routes stock/provided`), so
# a page can reach a provider only when the app's own code calls it that way,
# and only a page whose module leans on a module that does (`pages_of`).
# A server action, which takes the state after the viewer and the session and
# is never called short, is not reachable as a provider.
pub fn providers p
  calls = calls_of_program p
  list/fold p.modules [] (acc m -> list/concat acc (written p m calls))

# Every call the program's modules make, which `provided?` reads.
pub fn calls_of_program p
  list/fold p.modules [] (acc m -> list/concat acc m.calls)

# Whether `f` in `m` is a provider the app calls short, so that the server
# answers it at `/senro/data` and `providers` writes its asking half.
pub fn provided? m f calls
  provider? f.params and asked_short? m f calls

fn written p m calls
  called = list/to_list (list/select m.functions (f -> provided? m f calls))
  return [] if length called == 0
  pieces = list/to_list (list/map called (f -> pieces_of m f))
  answers = list/to_list (list/map called (f -> row m f))
  from = list/to_list (list/map called (f -> page_row m f))
  lists = list/to_list (list/map called (f -> pages_of p m f))
  tables = [
    "pub provided = data/answering provided_answers provided_pages"
    (spread "provided_answers =" "\{" answers "}")
    (spread "provided_pages =" "\{" from "}")
  ]
  parts = list/concat (list/concat pieces tables) lists
  [(derive/define m.name "{imported}{text/join parts "\n\n"}\n")]

imported = "import \"../data\"\n\n"

fn provider? params
  length params >= 2 and viewer? params[1].name and session? params[2].name

fn viewer? n
  n == "viewer" or n == "_"

fn session? n
  n == "db" or n == "_"

fn asked_short? m f calls
  wanted = length f.params - 2
  named = "{m.name}/{f.name}"
  list/any? calls (c -> c.callee == named and length c.arguments == wanted)

fn rest_names f
  rest = list/to_list (list/drop f.params 2)
  list/fold rest [] (acc _ -> push acc "arg_{length acc + 1}")

# The function an action calls, which asks, and the one the server calls
# with the arguments the page sent, which answers.
fn pieces_of m f
  names = rest_names f
  head = if (length names == 0) "_" (text/join names " ")
  question = "data/ask \"{m.name}/{f.name}\" [{text/join names " "}]"
  taken = (acc _ -> push acc "(data/nth args {length acc + 1})")
  each = list/fold names [] taken
  given = text/join (list/concat ["viewer" "db"] each) " "
  asking = "pub fn {f.name} {head}\n  {question}"
  answer = "pub fn {f.name}_from_page viewer db args\n  {f.name} {given}"
  "{asking}\n\n{answer}"

fn row m f
  "\"{m.name}/{f.name}\":{f.name}_from_page"

fn page_row m f
  "\"{m.name}/{f.name}\":{f.name}_pages"

# A provider answers a request from a page only when that page's module
# leans on a module that asks for it: the module itself, or one its calls
# reach, as a page's action reaches the component whose action asks. The
# list is those modules, so `web/providers` can tell a page that uses the
# provider from one that only names it.
fn pages_of p m f
  askers = askers_of p m f
  leaning = list/select p.modules (x -> leans_on? p x.name askers)
  names = list/to_list (list/map leaning (x -> "\"{x.name}\""))
  spread "{f.name}_pages =" "[" (list/sort names) "]"

# The modules that call the provider short.
fn askers_of p m f
  wanted = length f.params - 2
  named = "{m.name}/{f.name}"
  asks = (c -> c.callee == named and length c.arguments == wanted)
  asking = list/select p.modules (x -> list/any? x.calls asks)
  list/to_list (list/map asking (x -> x.name))

fn leans_on? p name askers
  reached = grown p [name]
  list/any? reached (r -> list/any? askers (a -> a == r))

# Every module `seen` leans on: those its calls name, and theirs in turn.
fn grown p seen
  next = list/fold seen seen (acc n -> with_called p acc n)
  return seen if length next == length seen
  grown p next

fn with_called p acc name
  found = list/to_list (list/select p.modules (m -> m.name == name))
  return acc if length found == 0
  list/fold found[1].calls acc (a c -> with_module p a (module_of c.callee))

fn with_module p acc name
  ours = list/any? p.modules (m -> m.name == name)
  return acc if not ours or list/any? acc (a -> a == name)
  list/concat acc [name]

# The module of `planner/view` is `planner`.
fn module_of callee
  parts = list/to_list (text/split callee "/")
  text/join (list/to_list (list/take parts (length parts - 1))) "/"

# A list or a map as the formatter wants it: on one line when it fits in
# eighty columns, and otherwise an item to a line.
fn spread head open items close
  inner = text/join items " "
  flat = if (open == "[") "{head} [{inner}]" "{head} \{ {inner} }"
  return flat if length flat <= 80
  "{head} {open}\n  {text/join items "\n  "}\n{close}"

pub fn answering answers pages
  provided_table answers pages

# Whether the table holds a provider by this name, then its answering half
# by that name, which is none for a name the table lacks.
pub fn provides? _ none
  false

pub fn provides? table name
  list/any? (keys table.answers) (k -> k == name)

pub fn answer_named _ none
  none

pub fn answer_named table name
  table.answers[name]

# The modules whose pages may ask for the provider `name`.
pub fn pages_asking _ none
  []

pub fn pages_asking table name
  listed_or_none table.pages[name]

fn listed_or_none none
  []

fn listed_or_none names
  names

# The `i`th argument a page sent a provider, or "" when it sent fewer.
pub fn nth args:[]some i
  sent args[i]

pub fn nth _ _
  ""

fn sent none
  ""

fn sent v
  v
