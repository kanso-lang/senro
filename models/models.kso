import "../names"
import "../pg"
import "../web"
import "std/derive"
import "std/list"
import "std/text"

# senro's model convention, run while an app compiles (#2186). The app's
# migrations are values built from the changes below, listed in order by a
# module named `migrations` as `pub all`. The derivation folds them into the
# schema, declares it as `schema`, and checks each record type in the app's
# other modules against the table its plural names: a model whose table is
# missing, or with a field the table has no column for, is refused at the
# model.
type new_table
  name
  columns

type added_column
  table
  column

type renamed_column
  table
  from
  to

type dropped_column
  table
  name

type foreign_key
  table
  column
  parent

type unique_index
  table
  column

type column_def
  name
  kind

# The file a walk over a module's migrations saw last, and the first clash
# it found: the constant, and what to say of it.
type stamp_seen
  file
  name
  said

# The migrations of a module that keeps one to a file: the stamp each file's
# name opens with, and beside it what the file holds.
type filed_steps
  stamps
  changes

# A migration as it is run and recorded: its version, which is its stamp or
# its place in a module kept as one file, and the SQL it runs.
type migration
  version
  sql

# A model's record: its name and its fields, as the module wrote it or as the
# derivation declares it from the table.
type shape
  name
  fields

# How far `dumped` has read: the tables so far, and the one whose columns the
# next lines hold, or "" between tables.
type reading
  schema
  table

# What a create answers when the record breaks its model's rules: the
# problems, a map from each field that breaks one to its message, and the
# record as it was given, to fill the form in again.
pub type invalid
  problems
  record

# One of a model's rules, as `rule` writes it.
type ruled
  field
  broken
  message

# How far `key_read` has read a dump: the keys so far, and the table the last
# `ALTER TABLE ONLY` named, whose constraint the next line adds.
type keying
  keys
  table

# How far `unique_read` has read a dump: the unique columns so far, and the
# table the last `ALTER TABLE ONLY` named.
type unique_reading
  indexes
  table

# A page of a query's rows: the rows on it, its number, counted from 1, and
# whether another page follows it.
pub type page
  rows
  number
  more

# What the derived `all` of a migrations module is, when the module keeps
# a migration to a file.
pub fn filed stamps changes
  filed_steps stamps changes

# A table as senro makes every one: an `id` that is its primary key, the
# columns the migration names, and `created_at` and `updated_at`, as Rails'
# `create_table` gives with `t.timestamps`. Postgres sets both timestamps as
# a row is inserted, `updated` sets `updated_at` on every change, and
# neither is taken from a form. A migration names only the app's own
# columns; one that names a column senro supplies is refused.
pub fn create_table name columns
  supplied = list/concat [table_id] columns
  new_table name (list/concat supplied [created_at updated_at])

pub fn add_column table definition
  added_column table definition

pub fn rename_column table from to
  renamed_column table from to

pub fn drop_column table name
  dropped_column table name

# The column `name` of `table` holds the id of a row in `parent`, and
# removing that row removes this one, as Rails' `add_foreign_key` with
# `on_delete: :cascade` makes it. The schema an app is compiled against
# has no constraints, so the fold leaves it as it was.
pub fn add_foreign_key table name parent
  foreign_key table name parent

# No two rows of `table` hold the same `name`, as Rails' `add_index` with
# `unique: true` makes it. `models/created` and `models/updated` answer a
# record that would break the index as `invalid`, with the problem on its
# field, where Postgres would refuse the write.
pub fn add_unique_index table name
  unique_index table name

# A row's value for `name`, or "" when the row has no such column: what a
# model's reader passes to its constructor for each field.
pub fn cell row name
  present_cell row[name]

fn present_cell none
  ""

fn present_cell v
  v

pub fn column name kind
  column_def name kind

# The columns `create_table` supplies.
table_id = column_def "id" "serial primary key"

created_at = column_def "created_at" "timestamptz not null default now()"

updated_at = column_def "updated_at" "timestamptz not null default now()"

supplied_names = ["id" "created_at" "updated_at"]

# An app whose migrations need SQL the fold cannot read, such as a trigger,
# checks in `pg_dump --schema-only` output as `schema.sql` beside its entry,
# and the schema is read from that instead.
pub fn tables p
  schema = schema_in p
  kinds = list/fold p.modules [] (acc m -> list/concat acc (typed_in m schema))
  refused = list/fold p.modules [] (acc m -> list/concat acc (models m schema))
  asked = list/fold p.modules [] (acc m -> list/concat acc (wheres m schema))
  each_named = (acc m -> list/concat acc (named_reads p m schema))
  named = list/fold p.modules [] each_named
  uniq = uniques_of p p.files["schema.sql"]
  each_read = (acc m -> list/concat acc (readers m schema uniq))
  given = list/fold p.modules [] each_read
  fks = keys_of p p.files["schema.sql"]
  each = (acc m -> list/concat acc (linked m schema fks uniq))
  joined = list/fold p.modules [] each
  declared = list/concat [(derive/declare "schema" "schema" schema)] kinds
  steps = list/fold p.modules [] (acc m -> list/concat acc (ordered m))
  twice = list/fold p.modules [] (acc m -> list/concat acc (doubled m))
  parts = [declared refused asked named given joined steps twice]
  list/fold parts [] list/concat

# A module named for a table's rows, as `note` is for `notes`, holds the
# table's model, as a Rails model is named in the singular. When the module
# declares no record of its own name, the derivation declares one in it with
# a field for each of the table's columns, in the table's order, and the
# rest of the derivation reads it as a record the module wrote. A module
# that declares the record keeps its own, which may leave columns out.
fn records_of m schema
  own = list/to_list (list/map m.records (r -> shape r.name r.fields))
  return own if wrote_model? m schema
  list/concat own [(shape m.name (column_names schema[names/plural m.name]))]

fn typed_in m schema
  return [] if wrote_model? m schema
  fields = column_names schema[names/plural m.name]
  lines = list/to_list (list/map fields (f -> "  {f}"))
  source = "pub type {m.name}\n{text/join lines "\n"}\n"
  [(derive/define m.name source)]

fn wrote_model? m schema
  return true if not table? schema[names/plural m.name]
  declared = list/any? m.records (r -> r.name == m.name)
  declared or list/any? m.functions (f -> f.name == m.name)

fn table? none
  false

fn table? _
  true

fn column_names none
  []

fn column_names columns
  list/to_list (list/map columns name_of)

# The schema a derivation reads from the app, as `derive models/tables`
# declares it: each table's columns, from `schema.sql` beside the entry when
# the app checks one in, and otherwise from its migrations.
pub fn schema_in p
  schema_of p p.files["schema.sql"]

# The migrations a derivation finds in the app's `migrations` module, oldest
# first, as `applied` runs them: each one's version and its SQL, a pair of
# strings, since what a derivation declares is plain data.
pub fn migrations_in p
  kept = list/to_list (list/select p.modules (m -> m.name == "migrations"))
  return [] if length kept == 0
  each = (m -> [m.version m.sql])
  list/to_list (list/map (migrations_of (steps_of kept[1])) each)

fn steps_of m
  return changes_in m.constants["all"] if m.constants["all"] != none
  names = in_file_order m
  stamps = list/to_list (list/map names (n -> stamp_of (file_of m n)))
  changes = list/to_list (list/map names (n -> m.constants[n]))
  filed_steps stamps changes

fn schema_of p none
  list/fold (migrations_of p) {} applied

fn schema_of _ sql
  dumped sql

fn migrations_of p
  kept = list/select p.modules (m -> m.name == "migrations")
  list/fold kept [] (acc m -> list/concat acc (listed m))

# An app keeps its migrations one to a file, `migrations/<stamp>_<name>.kso`,
# each a pub constant named for the file and holding a list of changes. They
# run in the order of the files' names, which the stamp makes the order they
# were written in. A module that writes `all` itself, as one file of
# changes, is read as it is.
fn listed m
  return changes_in m.constants["all"] if m.constants["all"] != none
  each = (acc n -> list/concat acc (changes_in m.constants[n]))
  list/fold (in_file_order m) [] each

# The names of a migrations module's constants, in the order of the files
# that declare them.
fn in_file_order m
  names = list/to_list (keys m.constants)
  pairs = list/to_list (list/map names (n -> "{file_of m n} {n}"))
  list/to_list (list/map (list/sort pairs) second_word)

fn file_of m name
  or_blank m.sources[name]

fn second_word pair
  parts = text/split pair " "
  parts[2]

# `all` for a migrations module that keeps a file to a migration: each
# file's stamp beside its changes, oldest first, written into the module so
# the entry runs `migrations/all` whichever way the module is kept. A file
# whose name is not its stamp and its constant's name is refused, since the
# name is what orders it.
fn ordered m
  return [] if m.name != "migrations" or m.constants["all"] != none
  names = in_file_order m
  odd = list/to_list (list/select names (n -> not stamped? (file_of m n) n))
  return refused_name m odd[1] if length odd > 0
  twice = list/fold names (stamp_seen "" "" "") (acc n -> clash m acc n)
  at = "{m.name}/{twice.name}"
  return [(derive/refuse at twice.said)] if twice.said != ""
  stamps = list/to_list (list/map names (n -> "\"{stamp_of (file_of m n)}\""))
  [(derive/define m.name (all_of stamps names))]

fn all_of stamps names
  line = "pub all = models/filed filed_stamps filed_changes"
  lists = "{listing "filed_stamps" stamps}\n{listing "filed_changes" names}"
  "import \"../models\"\n\n{line}\n\n{lists}"

# A list as the formatter wants it: on one line when it fits in eighty
# characters, and otherwise an element to a line.
fn listing name items
  flat = "{name} = [{text/join items " "}]"
  return "{flat}\n" if length flat <= 80
  "{name} = [\n  {text/join items "\n  "}\n]\n"

fn refused_name m none
  [(derive/refuse m.name "a migration's file is not named for it")]

fn refused_name m name
  [(derive/refuse "{m.name}/{name}" (misnamed (file_of m name) name))]

# Two files with one stamp have no order between them, and a stamp is what
# a migration is recorded under, so the second is refused.
fn clash m seen name
  file = file_of m name
  again = stamp_of file == stamp_of seen.file and seen.said == ""
  return stamp_seen file name (same_stamp seen.file file) if again
  stamp_seen file seen.name seen.said

fn same_stamp first second
  "migrations/{second} has the stamp of migrations/{first}; give it its own"

fn stamp_of file
  or_blank (text/slice file 1 14)

fn or_blank none
  ""

fn or_blank s
  s

fn stamped? file name
  stamp = stamp_of file
  digits = list/all? (text/chars stamp) (c -> c >= "0" and c <= "9")
  length stamp == 14 and digits and file == "{stamp}_{name}.kso"

fn misnamed file name
  wanted = "<yyyymmddhhmmss>_{name}.kso"
  "migrations/{file} holds `{name}`, so it is named {wanted}"

fn changes_in none
  []

fn changes_in changes:[]some
  changes

fn changes_in change
  [change]

fn applied schema c:new_table
  put schema c.name (list/to_list (list/map c.columns spelled))

fn applied schema c:added_column
  put schema c.table (list/concat (held schema c.table) [(spelled c.column)])

fn applied schema c:renamed_column
  put schema c.table (list/to_list (list/map (held schema c.table) (renamed c)))

fn applied schema c:dropped_column
  kept = list/select (held schema c.table) (col -> name_of col != c.name)
  put schema c.table (list/to_list kept)

fn applied schema _:foreign_key
  schema

fn applied schema _:unique_index
  schema

fn held schema table
  present schema[table]

fn present none
  []

fn present columns
  columns

fn spelled c
  "{c.name} {c.kind}"

# A migration that names a column `create_table` supplies would make the
# table with it twice, so it is refused where it is declared.
fn doubled m
  return [] if m.name != "migrations"
  names = list/to_list (keys m.constants)
  list/fold names [] (acc n -> list/concat acc (doubled_in m n))

fn doubled_in m n
  each = (acc c -> list/concat acc (twice_in c))
  named = list/fold (changes_in m.constants[n]) [] each
  return [] if length named == 0
  [(derive/refuse "migrations/{n}" (supplied_twice named[1]))]

fn twice_in c:new_table
  names = list/to_list (list/map c.columns (col -> col.name))
  count = (s -> length (list/to_list (list/select names (x -> x == s))))
  list/to_list (list/select supplied_names (s -> count s > 1))

fn twice_in _
  []

fn supplied_twice name
  "`create_table` supplies `{name}`; leave it out of the migration's columns"

fn name_of col
  (text/split col " ")[1]

fn renamed c
  (col -> moved col c)

fn moved col c
  return col if name_of col != c.from
  "{c.to} {(text/split col " ")[2]}"

fn models m schema
  each = records_of m schema
  list/fold each [] (acc r -> list/concat acc (refusals m r schema))

fn refusals m r schema
  table = names/plural r.name
  checked "{m.name}/{r.name}" table r.fields schema[table]

# A `models/where` whose model is named for its record, as `comment_model`,
# and whose field is written out is checked here: the field is one of the
# table's columns, or the call is refused.
fn wheres m schema
  calls = list/select m.calls (c -> c.callee == "models/where")
  list/fold calls [] (acc c -> list/concat acc (where_checked c schema))

fn where_checked c schema
  t = record_named (last_part (blank_if_none c.arguments[3]))
  field = blank_if_none c.strings[4]
  return [] if t == ""
  column_checked c (names/plural t) field schema

fn column_checked c table field schema
  return [] if field == ""
  columns = list/to_list (list/map (present schema[table]) name_of)
  return [] if list/any? columns (n -> n == field)
  has = text/join columns ", "
  said = "`{field}` is not a column of `{table}`: it has {has}"
  [(derive/refuse_call c said)]

# The same check for a read through a model's own module: the field of
# `notes/where db "title" t` and `notes/find_by db "title" t`, and the
# column of `notes/ordered db "title"`, where it is written out.
fn named_reads p m schema
  calls = list/select m.calls (c -> by_column? (last_part c.callee))
  list/fold calls [] (acc c -> list/concat acc (named_checked p c schema))

fn by_column? leaf
  one = leaf == "where" or leaf == "find_by" or leaf == "ordered"
  one or leaf == "paged" or leaf == "increment"

# Where the call writes its column: after the session, or after the id.
fn column_at "increment"
  3

fn column_at _
  2

fn named_checked p c schema
  path = text/split c.callee "/"
  return [] if length path != 2
  holders = list/select p.modules (m -> m.name == path[1])
  one = (acc m -> list/concat acc (held_models m schema))
  kept = list/fold holders [] one
  return [] if length kept != 1
  at = column_at (last_part c.callee)
  table = names/plural kept[1].name
  column_checked c table (blank_if_none c.strings[at]) schema

fn held_models m schema
  list/to_list (list/select (records_of m schema) (r -> modeled? r schema))

fn last_part name
  blank_if_none (list/last (text/split name "/"))

fn record_named name
  return "" if not text/ends_with? name "_model"
  blank_if_none (text/slice name 1 (length name - 6))

fn blank_if_none none
  ""

fn blank_if_none s
  s

fn checked origin table _ none
  [(missing origin table)]

fn checked origin table fields columns
  names = list/to_list (list/map columns name_of)
  unknown = list/select fields (f -> not list/any? names (n -> n == f))
  list/to_list (list/map unknown (f -> stray origin table f))

# Each model with a table gets a reader in its own module, named after it:
# `signature_from row` builds a `signature` from a row a query answered,
# taking each field from the column of that name, or "" when the row has no
# such column. A module can pass the reader to `list/map` like any function
# it wrote (kanso#2265).
fn readers m schema uniq
  each = records_of m schema
  one = (acc r -> list/concat acc (reader m r schema uniq))
  each_read = list/fold each [] one
  list/concat each_read (finders m (held_models m schema))

fn modeled? r schema
  schema[names/plural r.name] != none and list/any? r.fields (f -> f == "id")

# A module that holds one model answers for it by name, as a Rails model
# answers its class methods. The reads are `notes/find db id`, `notes/find_by
# db "title" t`, `notes/all db`, `notes/newest db`, `notes/ordered db
# "title"`, `notes/where db "title" t` and `notes/paged db number per`; the
# writes are `notes/create db fields`, `notes/update db id changes` and
# `notes/destroy db id`. Each goes through the model for the viewer the
# session names. A module that declares a function of one of those names
# keeps its own, and a module with two models has none written, since a bare
# `find` would not say which.
fn finders m kept
  return [] if length kept != 1
  model = "{kept[1].name}_model"
  each_one = [
    (finder m model "find" "find" "id")
    (finder m model "find_by" "find_by" "field value")
    (finder m model "all" "all" "")
    (finder m model "newest" "newest" "")
    (finder m model "ordered" "ordered" "by")
    (finder m model "where" "matching" "field value")
    (finder m model "paged" "paged" "number per")
    (finder m model "paged" "paged" "field value number per")
    (finder m model "create" "create" "fields")
    (finder m model "update" "update" "id changes")
    (finder m model "destroy" "destroy" "id")
    (finder m model "increment" "increment" "id field")
  ]
  found_calls = list/to_list (list/reject each_one (c -> c == ""))
  return [] if length found_calls == 0
  source = "import \"../models\"\n\n{text/join found_calls "\n"}"
  [(derive/define m.name source)]

fn finder m model name reads takes
  return "" if declares? m name
  head = text/trim "pub fn {name} db {takes}"
  call = text/trim "models/{reads} db {model} {takes}"
  "{head}\n  {call}\n"

fn reader m r schema uniq
  table = names/plural r.name
  written m r schema[table] (present uniq[table])

fn written _ _ none _
  []

fn written m r _ uniq
  t = r.name
  cells = list/map r.fields (f -> wrapped "  {f} = {t}_cell" ["row[\"{f}\"]"])
  built = wrapped "  {t}" r.fields
  lines = list/concat (list/to_list cells) [built]
  reads = "pub fn {t}_from row\n{text/join lines "\n"}\n"
  blank = "fn {t}_cell none\n  \"\"\n\nfn {t}_cell v\n  v\n"
  given = [(derive/define m.name reads) (derive/define m.name blank)]
  read_and_mapped = list/concat given (attributes_of m r)
  list/concat read_and_mapped (guarded m r uniq)

# A model's record as a map from each field's name to its value, as Rails'
# `attributes` gives one: `note_attributes n`, which `web/json` encodes as an
# object. A module that declares a function of the name keeps its own, and
# so may leave a field out of what it answers.
fn attributes_of m r
  name = "{r.name}_attributes"
  return [] if declares? m name
  pairs = list/to_list (list/sort (list/map r.fields (f -> "\"{f}\":v.{f}")))
  one = "\{ {text/join pairs " "} }"
  body = if (length one <= 78) "  {one}" (spread_map pairs)
  [(derive/define m.name "pub fn {name} v\n{body}\n")]

fn spread_map pairs
  "  \{\n    {text/join pairs "\n    "}\n  }"

# The foreign keys the migrations add, or the ones a `schema.sql` dump
# declares when the app keeps one.
fn keys_of p none
  list/fold (migrations_of p) [] key

fn keys_of _ sql
  (list/fold (text/split sql "\n") (keying [] "") key_read).keys

# pg_dump writes a foreign key over two lines, `ALTER TABLE ONLY public.tags`
# and then `ADD CONSTRAINT tags_note_id_fkey FOREIGN KEY (note_id)
# REFERENCES public.notes(id);`, indented.
fn key_read k line
  named = unquoted (blank_if_none (text/slice line 18 (length line)))
  return keying k.keys named if altered? line
  return keying k.keys "" if k.table == "" or not foreign? line
  child = between line "FOREIGN KEY (" ")"
  parent = unquoted (between line "REFERENCES " "(")
  keying (list/concat k.keys [(foreign_key k.table child parent)]) ""

fn foreign? line
  mentions? line " FOREIGN KEY ("

# Whether `part` appears in `line`.
fn mentions? line part
  length (text/split line part) > 1

fn altered? line
  altering = text/starts_with? line "ALTER TABLE ONLY "
  altering and not mentions? line " ALTER COLUMN "

# The text after `from` and before the next `upto`.
fn between line from upto
  after = (text/split line from)[2]
  plain (text/split (plain after) upto)[1]

# `public.notes` and `"notes"` name `notes`.
fn unquoted name
  parts = text/split (text/trim name) "."
  text/replace (plain parts[length parts]) "\"" ""

fn key acc c:foreign_key
  list/concat acc [c]

fn key acc _
  acc

# The columns a unique index covers, a list for each table: those the
# migrations index with `add_unique_index` or declare with a kind that says
# `unique`, or the single-column unique indexes and constraints a
# `schema.sql` dump declares. An index over several columns is left out,
# since no one field breaks it.
fn uniques_of p none
  list/fold (migrations_of p) {} unique_of

fn uniques_of _ sql
  start = unique_reading {} ""
  (list/fold (text/split sql "\n") start unique_read).indexes

fn unique_of acc c:unique_index
  alone acc c.table c.column

fn unique_of acc c:new_table
  list/fold c.columns acc (a col -> unique_kind a c.name col)

fn unique_of acc c:added_column
  unique_kind acc c.table c.column

fn unique_of acc _
  acc

fn unique_kind acc table col
  words = text/split (text/lowercase col.kind) " "
  return acc if not list/any? words (w -> w == "unique")
  alone acc table col.name

fn alone seen table col
  return seen if mentions? col ","
  put seen table (list/concat (present seen[table]) [(text/trim col)])

# pg_dump writes a unique index on one line, `CREATE UNIQUE INDEX
# notes_slug_unique ON public.notes USING btree (slug);`, and a unique
# constraint over two, as it writes a foreign key: `ALTER TABLE ONLY
# public.notes`, then `ADD CONSTRAINT notes_slug_key UNIQUE (slug);`.
fn unique_read u line
  return unique_reading (indexed u.indexes line) "" if index_line? line
  named = unquoted (blank_if_none (text/slice line 18 (length line)))
  return unique_reading u.indexes named if altered? line
  return unique_reading u.indexes "" if u.table == "" or not unique? line
  col = between line " UNIQUE (" ")"
  unique_reading (alone u.indexes u.table col) ""

fn index_line? line
  text/starts_with? line "CREATE UNIQUE INDEX "

fn unique? line
  mentions? line " UNIQUE ("

fn indexed seen line
  table = unquoted (between line " ON " " USING")
  alone seen table (between line " (" ")")

# Each foreign key reads both ways, as Rails' `has_many` and `belongs_to`
# do, and each reader is named for the key's column, its stem being the
# column without `_id`. The child's module gets `of_<stem>`, the rows of its
# table that hold a given parent, which the viewer may see: `pages/of_note db
# note`, or `posts/of_owner db user` for `posts.owner_id`. When the column
# has a unique index a parent holds at most one, as Rails' `has_one`, and
# the reader answers that row or none. The parent's module gets the row a
# given child holds: `of_<child>` when the stem is the parent's own name, as
# `notes/of_page db page`, and `<stem>_of_<child>` when it is not, as
# `users/owner_of_post db post`, so two keys to one parent read apart. Each
# reader lives in the module whose rows it answers and reads the other
# record's field by name, so neither module imports the other, and an app
# may import either into the other without a cycle. A module that declares a
# function of the same name keeps its own, and so does one that declares
# the name its parameter takes.
fn linked m schema fks uniq
  each = records_of m schema
  list/fold each [] (acc r -> list/concat acc (associated m r fks uniq))

fn associated m r fks uniq
  return [] if not list/any? r.fields (f -> f == "id")
  table = names/plural r.name
  owned = list/select fks (k -> k.table == table)
  owners = list/select fks (k -> k.parent == table)
  only = (k -> list/any? (present uniq[k.table]) (c -> c == k.column))
  rows = list/fold owned [] (acc k -> list/concat acc (rows_of m r k (only k)))
  list/fold owners rows (acc k -> list/concat acc (owner_of m r k))

fn rows_of m r k one?
  given = stem k.column
  name = "of_{given}"
  return [] if given == "" or declares? m name or named? m given
  reads = if one? "  models/find_by" "  models/matching"
  args = ["db" "{r.name}_model" "\"{k.column}\"" "{given}.id"]
  [(derive/define m.name (association name given (wrapped reads args)))]

fn owner_of m r k
  given = singular k.table
  own = stem k.column == r.name
  name = if own "of_{given}" "{stem k.column}_of_{given}"
  return [] if given == "" or declares? m name or named? m given
  args = ["db" "{r.name}_model" "{given}.{k.column}"]
  call = wrapped "  models/find" args
  [(derive/define m.name (association name given call))]

# A key column's name without its `_id`: `owner_id` reads as `owner`.
fn stem col
  return col if not text/ends_with? col "_id"
  plain (text/slice col 1 (length col - 3))

# Whether the module declares a function or a record of this name, which
# a parameter of that name could not shadow.
fn named? m name
  declares? m name or list/any? m.records (r -> r.name == name)

# `../models` is this module, written from here, as a definition's imports
# are; kanso rewrites it from the module the reader joins.
fn association name given call
  "import \"../models\"\n\npub fn {name} db {given}\n{call}\n"

# A call as the formatter writes it: on one line when it fits in 80 columns,
# and one argument to a line, two spaces in, when it does not. `head` holds
# the line's own indent.
fn wrapped head args
  one = "{head} {text/join args " "}"
  return one if length one <= 80
  inset = length head - length (text/trim head)
  lead = blank_if_none (text/slice head 1 inset)
  each = list/to_list (list/map args (a -> "{lead}  {a}"))
  "{head}\n{text/join each "\n"}"

# Each model with an `id` gets a value describing it, `signature_model`: a
# map of its table, its columns, its reader, and each policy its module
# declares. `models/updated` and `models/destroyed` take that value, so a
# write reads the row, asks the policy and writes only when it says yes, and
# a model whose module declares no `destroy?` cannot be destroyed this way.
# A model whose table has unique columns among its fields names them as
# `unique`, which `models/created` and `models/updated` check.
fn guarded m r uniq
  return [] if not list/any? r.fields (f -> f == "id")
  t = r.name
  base = [
    "\"table\":\"{names/plural t}\""
    "\"columns\":{t}_columns"
    "\"read\":{t}_from"
  ]
  owned = ["create?" "update?" "destroy?" "visible?" "problems"]
  policies = list/select owned (p -> declares? m p)
  said = list/map policies (p -> "\"{text/replace p "?" ""}\":{p}")
  marked = list/concat (list/to_list said) (unique_entry r.fields uniq)
  pairs = list/to_list (list/sort (list/concat base marked))
  value = [(derive/define m.name (model_value t pairs))]
  named = "{t}_columns"
  return value if declares? m named or m.constants[named] != none
  list/concat value [(derive/define m.name (columns_value t r.fields))]

fn unique_entry fields uniq
  among = list/to_list (list/select uniq (c -> list/any? fields (f -> f == c)))
  return [] if among == []
  quoted = list/to_list (list/map among (c -> "\"{c}\""))
  ["\"unique\":[{text/join quoted " "}]"]

# A model's column names, `signature_columns`, which its module reads where it
# writes SQL, so a column a migration adds reaches the query with no edit. On
# one line when it fits, and a name to a line when it does not.
fn columns_value t fields
  names = list/to_list (list/map fields (f -> "\"{f}\""))
  line = "pub {t}_columns = [{text/join names " "}]"
  return "{line}\n" if length line <= 80
  "pub {t}_columns = [\n  {text/join names "\n  "}\n]\n"

fn declares? m name
  list/any? m.functions (f -> f.name == name)

# On one line when it fits in kanso's 80 columns, and an entry to a line when
# it does not, as the formatter asks.
fn model_value t pairs
  line = "pub {t}_model = \{ {text/join pairs " "} }"
  return "{line}\n" if length line <= 80
  "pub {t}_model = \{\n  {text/join pairs "\n  "}\n}\n"

# The records a viewer may see among the rows a query answered, read by the
# model's reader. A model whose module declares `visible?` shows each row it
# says yes to; one that declares none shows every row. Reads default open and
# writes closed: a read with no check is what senro did before policies, and
# a missing read policy can show a row but never change one.
pub fn shown viewer model rows
  records = list/map rows (row -> row_read model["read"] row)
  list/to_list (list/select records (was -> seen? model["visible"] viewer was))

fn seen? none _ _
  true

fn seen? policy viewer was
  return true if app? viewer
  policy viewer was

# Whether the app itself is asking (`models/as_app`), which no policy is
# asked about.
fn app? _:pg/the_app
  true

fn app? _
  false

# A record by its id, read through its model, or none when no row has that
# id or the viewer may not see it, as Rails' `find_by(id:)` answers nil.
pub fn found viewer db model id
  read model db id .> (row -> effect (seen_one viewer model row))

fn seen_one _ _ none
  none

fn seen_one viewer model row
  was = row_read model["read"] row
  return none if not seen? model["visible"] viewer was
  was

# The records whose `field` holds `value`, oldest first, that the viewer may
# see: a post's comments are `models/where viewer db comment_model "post_id"
# id`, as Rails' `where` reads. The field is one of the model's columns, which
# the derivation checks where the call writes it out; one that is not is an
# error here, so a field never reaches the SQL unread.
pub fn where viewer db model field value
  cols = column_list model["columns"]
  odd = "`{field}` is not a column of `{table_of model["table"]}`"
  return err odd if not list/any? cols (c -> c == field)
  names = text/join cols ", "
  from = "from {table_of model["table"]} where {field} = $1 order by id"
  pg/query db "select {names} {from}" ["{value}"]
    .> (r -> effect (shown viewer model r.rows))

# The same reads for an action, which holds the session senro handed it and
# nothing else. The web layer has named whoever is signed in on that session
# (`pg/asked_by`), so the viewer is not passed: `models/find db note_model id`
# reads as `found` does for that viewer. Each model's module gets these under
# its own name, as `notes/find db id`, `notes/all db`, `notes/ordered db by`
# and `notes/where db field value`, the way a Rails model answers `find`,
# `all`, `order` and `where`.
pub fn find db model id
  found (pg/asker db) db model id

# Every record the session's viewer may see, oldest first.
pub fn all db model
  ordered db model "id"

# Every record the viewer may see, in the order of one of the model's
# columns, smallest first: `notes/ordered db "title"`. The column is checked
# where the call writes it out, as `where`'s field is; one that is not a
# column is an error here, so the order never reaches the SQL unread.
pub fn ordered db model by
  cols = column_list model["columns"]
  odd = "`{by}` is not a column of `{table_of model["table"]}`"
  return err odd if not list/any? cols (c -> c == by)
  sorted db model "{by}, id"

# Every record the viewer may see, the one made last first, as a guestbook
# or a feed lists them.
pub fn newest db model
  sorted db model "id desc"

fn sorted db model order
  names = text/join (column_list model["columns"]) ", "
  from = "from {table_of model["table"]} order by {order}"
  pg/query db "select {names} {from}" []
    .> (r -> effect (shown (pg/asker db) model r.rows))

# Page `number` of the model's records, oldest first, `per` to a page, for
# the session's viewer: `notes/paged db number per`. The read policy is asked
# about the rows of that page, so a page may show fewer than `per`.
pub fn paged db model number per
  names = text/join (column_list model["columns"]) ", "
  sql = "select {names} from {table_of model["table"]} order by id"
  paged db sql [] number per .> (p -> effect (seen_page db model p))

fn seen_page db model p
  page (shown (pg/asker db) model p.rows) p.number p.more

# The same page of the records whose `field` holds `value`: a note's pages
# are `page/paged db "note_id" id number per`.
pub fn paged db model field value number per
  cols = column_list model["columns"]
  odd = "`{field}` is not a column of `{table_of model["table"]}`"
  return err odd if not list/any? cols (c -> c == field)
  names = text/join cols ", "
  from = "from {table_of model["table"]} where {field} = $1 order by id"
  paged db "select {names} {from}" ["{value}"] number per
    .> (p -> effect (seen_page db model p))

# The records whose `field` holds `value`, oldest first, as `where` reads
# them for the session's viewer.
pub fn matching db model field value
  where (pg/asker db) db model field value

# The first record whose `field` holds `value` that the viewer may see, or
# none: `accounts/find_by db "email" e`, as Rails' `find_by` answers nil.
pub fn find_by db model field value
  matching db model field value .> (ms -> effect ms[1])

# The writes, for the session's viewer: `created`, `updated` and `destroyed`
# as an action calls them, with the policy asked about whoever the session
# names.
pub fn create db model fields
  created (pg/asker db) db model fields

pub fn update db model id changes
  updated (pg/asker db) db model id changes

pub fn destroy db model id
  destroyed (pg/asker db) db model id

# The session, asking as the app itself: `account/update (models/as_app db)
# id changes` writes with no viewer behind the write, and no policy is
# asked. It is for what the app does on its own account, as a sign-in counts
# a wrong password or a reset link sets a digest. The id comes from a token
# the app checked or a record it looked up, and the changes are written out
# at the call, never taken from a form.
pub fn as_app db
  pg/as_app db

# One more in a counting column, `account/increment db id "failures"`,
# answering the record after the change. Postgres adds in the statement
# that answers, so of two requests that count at once each sees a count of
# its own, and exactly one of them sees the limit reached. The viewer's
# `update?` is asked about the row as it stood.
pub fn increment db:pg/session model id field
  incremented (pg/asker db) db model id field

pub fn incremented viewer db model id field
  cols = column_list model["columns"]
  odd = "`{field}` is not a column of `{table_of model["table"]}`"
  return err odd if not list/any? cols (c -> c == field)
  read model db id .> (row -> counted viewer db model field row)

fn counted _ _ _ _ none
  effect web/absent

fn counted viewer db model field row
  was = row_read model["read"] row
  return effect web/denied if not allowed? model["update"] viewer was
  cols = column_list model["columns"]
  table = table_of model["table"]
  pg/increment_by_id db table cols field "{id_of row}"
    .> (r -> stored model r.rows[1])

# A rule of a model's `problems`: the field it is about, whether the record
# breaks it, and what to tell the visitor when it does.
pub fn rule field broken message
  ruled field broken message

# A model module declares what makes its record fit to keep as `problems`,
# which takes the record and answers `models/problems` of its rules:
#
#   pub fn problems s
#     models/problems [
#       (models/rule "name" (s.name == "") "Say who you are.")
#       (models/rule "message" (s.message == "") "Say something.")
#     ]
#
# The answer maps each field that breaks a rule to the message of the first
# rule it breaks, and holds no other field, so a record with no problems has
# an empty map. A form shows a field's problem when it has one:
#
#   if problems["name"] != none
#     p.problem = problems["name"]
pub fn problems rules
  list/fold rules {} noted

fn noted acc r
  return acc if not r.broken or acc[r.field] != none
  put acc r.field r.message

# Whether a record has any problem.
pub fn problems? said
  length said > 0

# Whether a value, such as a form's field, is one an `integer` column takes:
# a whole number, written in digits with a sign or without, inside the
# column's range. Postgres refuses any other value, so a model whose field
# reads into an `integer` column asks this in its `problems`.
pub fn integer? v
  in_range? (text/to_int (text/trim "{v}"))

fn in_range? none
  false

fn in_range? n
  n >= -2147483648 and n <= 2147483647

# Page `number` of what `sql` selects, `per` rows to a page, as Pagy reads
# one for a Rails app. The query is asked for one row more than a page
# holds, which says whether another page follows, and that row is not shown.
# `sql` ends where a limit may follow it, after its `order by`.
pub fn paged db sql params number per
  n = length params
  limited = "{sql} limit ${n + 1} offset ${n + 2}"
  asked = list/concat params ["{per + 1}" "{(number - 1) * per}"]
  pg/query db limited asked .> (r -> effect (page_of r.rows number per))

fn page_of rows number per
  on_it = list/to_list (list/take rows per)
  page on_it number (length rows > per)

# The page a query string asks for: its whole number when that is 1 or
# more, and 1 for anything else, a missing `page` among them.
pub fn page_number asked
  at_least_one (text/to_int asked)

fn at_least_one none
  1

fn at_least_one n
  if (n < 1) 1 n

# The rule that a field is a whole number an `integer` column takes.
pub fn whole_number field v
  rule field (not integer? v) "Give a whole number."

# The rule that a field is filled in, as Rails' `presence: true` reads
# one: a value of nothing but spaces is as blank as none at all.
pub fn present field v
  rule field (text/trim "{v}" == "") "Fill this in."

# The rule that a field holds at most `n` characters, as Rails'
# `length: { maximum: n }`. Characters are counted, not bytes, so a name in
# any script is held to the same length.
pub fn at_most field n v
  rule field (length (text/chars "{v}") > n) "Use at most {n} characters."

# The rule that a field holds at least `n` characters, as Rails'
# `length: { minimum: n }`.
pub fn at_least field n v
  rule field (length (text/chars "{v}") < n) "Use at least {n} characters."

# The rule that a field holds one of `choices`, as Rails'
# `inclusion: { in: choices }` does, so a form that posts a status or a kind
# from a select cannot post one the app does not know.
pub fn one_of field choices v
  known = list/any? choices (c -> c == "{v}")
  rule field (not known) "Choose one of {text/join choices ", "}."

# The rule that a field holds an email address: one @, with something
# before it and something after it, and no spaces. Whether the address
# reaches anyone only a mail sent to it can tell.
pub fn email_address field v
  halves = text/split "{v}" "@"
  shaped = length halves == 2 and not list/any? halves (h -> h == "")
  spaced = length (text/split "{v}" " ") > 1
  rule field (not shaped or spaced) "Give an email address."

# A record made through its model. The values, such as a form's fields, are
# read into a record by the model's reader, with any `id` left out, since
# Postgres numbers a new row. The model's `create?` policy is asked about the
# record, and a model whose module declares none cannot be created this
# way, as with every write. Then `problems` checks it, when the module
# declares one, and a record with problems answers `invalid` without
# writing. Otherwise the row is inserted, and the answer is the record as
# stored, its id among it. A model with unique columns is inserted only when
# no row holds its values, in the one statement, so two requests that race
# for a value cannot both have it; the one that loses answers `invalid`,
# with the problem on each field whose value is taken.
pub fn created viewer db model fields
  given = unstamped (delete fields "id")
  was = row_read model["read"] given
  return effect web/denied if not allowed? model["create"] viewer was
  broken = checked_by model["problems"] was
  return effect (invalid broken was) if problems? broken
  cols = column_list model["columns"]
  inserted db model cols given .> (r -> kept db model given was r.rows)

fn inserted db model cols given
  table = table_of model["table"]
  return pg/insert db table cols given if model["unique"] == none
  pg/insert_unless_taken db table cols given

fn kept db model given was rows
  return stored model rows[1] if length rows > 0
  taken db model given "" .> (t -> refused_for t was)

fn refused_for t was
  return err "a unique index refused the row on no one column" if t == {}
  effect (invalid t was)

# The problems of the unique columns among `fields` whose value another row
# holds. `id` is the row being changed, which keeps its own values, or "" for
# a row not yet made.
fn taken db model fields id
  named = list/select (present model["unique"]) (c -> fields[c] != none)
  table = table_of model["table"]
  taken_among db table (list/to_list named) fields id {}

fn taken_among db table cols fields id seen
  return effect seen if length cols == 0
  c = cols[1]
  others = list/to_list (list/drop cols 1)
  sql = "select 1 from {table} where {c} = $1 and id::text <> $2 limit 1"
  pg/query db sql ["{fields[c]}" id]
    .> (r -> taken_among db table others fields id (noted_taken seen c r.rows))

fn noted_taken seen c rows
  return seen if length rows == 0
  put seen c "That is taken."

fn checked_by none _
  {}

fn checked_by check was
  check was

fn stored _ none
  effect web/absent

fn stored model row
  effect (row_read model["read"] row)

# Whether a write answered a refusal, `web/denied` or `web/absent`, rather
# than the row it wrote.
pub fn refused? w
  web/refused? w

# A write through a model, checked by its policy. The row is read by its id,
# and `web/absent` answers for one that is not there; the policy is asked
# about it as it stands, and `web/denied` answers a no, or a model with no
# such policy. The server answers a server action that answers either as a
# 404 or a 403. An update is checked by the model's `problems` too, as the
# change leaves the record, and answers `invalid` without writing when it
# breaks a rule. `updated` answers the row as Postgres holds it after the
# change, and a change that names nothing answers the row as it is without
# writing. `destroyed` answers the row as it was.
#
# A state the browser sent may name no id at all, which is a row not there.
pub fn updated _ _ _ none _
  effect web/absent

pub fn updated viewer db model id changes
  read model db id .> (row -> update_found viewer db model changes row)

fn update_found _ _ _ _ none
  effect web/absent

fn update_found viewer db model asked row
  was = row_read model["read"] row
  return effect web/denied if not allowed? model["update"] viewer was
  changes = unstamped asked
  return effect was if length (keys changes) == 0
  now = list/fold (keys changes) row (acc k -> put acc k changes[k])
  changed = row_read model["read"] now
  broken = checked_by model["problems"] changed
  return effect (invalid broken changed) if problems? broken
  cols = column_list model["columns"]
  sent = stamped cols changes
  taken db model changes "{id_of row}"
    .> (t -> rewritten db model cols row sent changed t)

# A change that gives a unique column a value another row holds answers
# `invalid` without writing. The check is a read before the write, so two
# changes that race for one value can still meet the index, which refuses
# the second as Postgres refuses any write.
fn rewritten db model cols row sent changed t
  return effect (invalid t changed) if t != {}
  pg/update_by_id db (table_of model["table"]) cols "{id_of row}" sent
    .> (r -> effect (stored model changed r.rows[1]))

# The row as Postgres holds it after the write, each value of its column's
# type and `updated_at` the moment of the change. A row removed between the
# check and the write answers the record as the change would have left it.
fn stored _ changed none
  changed

fn stored model _ row
  row_read model["read"] row

# A form's fields without the timestamps, which only the database writes.
fn unstamped fields
  delete (delete fields "created_at") "updated_at"

# A change to a table with `updated_at` sets it to the time of the write:
# Postgres reads the text `now` as the current time for a timestamp column.
fn stamped cols changes
  return changes if not list/any? cols (c -> c == "updated_at")
  put changes "updated_at" "now"

pub fn destroyed _ _ _ none
  effect web/absent

pub fn destroyed viewer db model id
  read model db id .> (row -> destroy_found viewer db model row)

fn destroy_found _ _ _ none
  effect web/absent

fn destroy_found viewer db model row
  was = row_read model["read"] row
  return effect web/denied if not allowed? model["destroy"] viewer was
  table = table_of model["table"]
  pg/delete_by_id db table "{id_of row}" .> (_ -> effect was)

fn read model db id
  cols = column_list model["columns"]
  pg/row_by_id db (table_of model["table"]) cols id .> (r -> effect r.rows[1])

fn id_of row
  row["id"]

fn allowed? none viewer _
  app? viewer

fn allowed? policy viewer was
  return true if app? viewer
  policy viewer was

fn row_read none row
  row

fn row_read f row
  f row

fn table_of none
  ""

fn table_of t
  t

fn column_list none
  []

fn column_list cols
  cols

fn missing origin table
  derive/refuse origin "no table `{table}` in the schema the migrations build"

fn stray origin table f
  derive/refuse origin "`{f}` is not a column of `{table}`"

# A dump's tables, each as `CREATE TABLE public.notes (` with a column to a
# line until `);`. Each column keeps its whole definition, as a migration's
# column does, and a table constraint is not a column.
fn dumped sql
  lines = text/split sql "\n"
  (list/fold lines (reading {} "") read).schema

fn read r line
  return opened r (table_named line) if created? line
  return reading r.schema "" if r.table != "" and text/starts_with? line ")"
  return r if r.table == "" or text/starts_with? (text/trim line) "CONSTRAINT"
  columns = list/concat (held r.schema r.table) [(unlisted (text/trim line))]
  reading (put r.schema r.table columns) r.table

fn created? line
  logged = text/starts_with? line "CREATE TABLE "
  logged or text/starts_with? line "CREATE UNLOGGED TABLE "

fn opened r table
  reading (put r.schema table []) table

fn unlisted c
  return c if not text/ends_with? c ","
  text/slice c 1 (length c - 1)

# `CREATE TABLE public.notes (` names `notes`, with any quotes taken off.
fn table_named line
  head = plain (text/split line " (")[1]
  words = text/split head " "
  parts = text/split (plain words[length words]) "."
  text/replace (plain parts[length parts]) "\"" ""

# The inflector: enough English for table names.
pub fn singular word
  formed = ["{text/slice word 1 (length word - 3)}y" (cut word 2) (cut word 1)]
  blank_if_none (list/find formed (w -> names/plural w == word))

fn cut word n
  blank_if_none (text/slice word 1 (length word - n))

# The SQL that makes each table in `schema` where it is missing, as one
# query for an app to run as it starts.
pub fn made schema
  each = list/map (keys schema) (t -> making t schema[t])
  text/join (list/to_list each) "; "

fn making table none
  "create table if not exists {table} ()"

fn making table columns
  "create table if not exists {table} ({text/join columns ", "})"

# The migrations of the app named `app` that have not yet run against `db`,
# run in order, as Rails runs the ones `schema_migrations` does not list.
# Each is recorded in `senro_migrations` under the app's name and its stamp,
# or its place in `all` for a module kept as one file, beside the SQL it
# ran, inside the transaction that ran it, so a migration runs once, and two
# apps can share a database. One whose SQL has changed since it ran is
# refused, and the app does not start: a change that has run is history, and
# a new one is a new migration. The session comes back when every migration
# has run, so `.>` carries it on.
#
# Each change does nothing when its work is already done, so a database made
# before migrations were recorded takes the whole list safely the first time.
pub fn migrated db app steps
  ran db app (migrations_of steps)

# `applied db app pairs` runs the migrations `migrations_in` reads, as
# `migrated` runs a module's, which is how `app/run` runs the ones `derive
# app/conventions` read.
pub fn applied db app pairs
  ran db app (list/to_list (list/map pairs paired))

fn paired pair
  migration (or_blank pair[1]) (or_blank pair[2])

fn ran db app migrations
  pg/run db ledger
    .> (_ -> pg/query db history [app])
    .> (r -> pending db app migrations (recorded r.rows))

# A version is a migration's stamp, fourteen digits, or its place in `all`
# for a module kept as one file; a table made when it was only ever a place
# is widened to hold either.
ledger = """
  create table if not exists senro_migrations
    (app text, version bigint, change text not null,
     primary key (app, version));
  alter table senro_migrations alter column version type bigint
"""

history = "select version, change from senro_migrations where app = $1"

fn recorded rows
  each = (acc row -> put acc "{cell row "version"}" (cell row "change"))
  list/fold rows {} each

fn pending db app migrations before
  each = (acc m -> acc .> (_ -> stepped db app m before[m.version]))
  list/fold migrations (effect db) each

# A migration kept in a file of its own is recorded under its stamp, with
# every statement its changes make, and runs in one transaction; a module
# kept as one file records each change under its place.
fn migrations_of f:filed_steps
  each = (acc s -> list/concat acc [(one_file s f.changes[length acc + 1])])
  list/fold f.stamps [] each

fn migrations_of steps:[]some
  each = (acc c -> list/concat acc [(placed_at (length acc + 1) c)])
  list/fold steps [] each

# The derivation writes a module's stamps and its changes side by side, one
# for each file, so a stamp always has changes beside it.
fn one_file stamp none
  migration stamp ""

fn one_file stamp changes
  each = list/to_list (list/map (changes_in changes) statement_of)
  migration stamp (text/join each ";\n")

fn placed_at n c
  migration "{n}" (statement_of c)

fn stepped db app m none
  pg/run db "begin; {m.sql}"
    .> (_ -> pg/query db record [app m.version m.sql])
    .> (_ -> pg/run db "commit")
    .> (_ -> effect db)

fn stepped db app m was
  return effect db if was == m.sql
  changed = "{app}'s migration {m.version} has changed since it ran"
  err "{changed}:\n  ran: {was}\n  now: {m.sql}"

record = """
  insert into senro_migrations (app, version, change)
  values ($1, $2, $3)
"""

fn statement_of c:new_table
  columns = text/join (list/to_list (list/map c.columns spelled)) ", "
  "create table if not exists {c.name} ({columns})"

fn statement_of c:added_column
  "alter table {c.table} add column if not exists {spelled c.column}"

# Postgres renames no column that is missing, so the rename asks first.
fn statement_of c:renamed_column
  t = c.table
  here = "table_schema = current_schema() and table_name = '{t}'"
  asked = "select from information_schema.columns where {here}"
  named = "{asked} and column_name = '{c.from}'"
  renaming = "alter table {t} rename column {c.from} to {c.to}"
  "do $$ begin if exists ({named}) then {renaming}; end if; end $$"

fn statement_of c:dropped_column
  "alter table {c.table} drop column if exists {c.name}"

# Postgres adds a constraint again when asked twice, so this asks first.
fn statement_of c:foreign_key
  named = "{c.table}_{c.column}_fkey"
  here = "conrelid = '{c.table}'::regclass"
  asked = "select from pg_constraint where {here} and conname = '{named}'"
  cascades = "references {c.parent} (id) on delete cascade"
  adding = "alter table {c.table} add constraint {named}"
  keyed = "{adding} foreign key ({c.column}) {cascades}"
  "do $$ begin if not exists ({asked}) then {keyed}; end if; end $$"

fn statement_of c:unique_index
  named = "{c.table}_{c.column}_unique"
  "create unique index if not exists {named} on {c.table} ({c.column})"

# The comparison an app runs as it starts: the live database's tables against
# the schema it was compiled with. Each table in `schema` is made again as a
# temporary shadow from the same column definitions, so Postgres reads `serial`
# and `int` and `varchar(80)` the way it read them when the real table was
# made, and the catalog then compares the two column by column: names, types
# and whether each takes a null. Defaults and constraints are not compared.
# The session comes back when they agree, so `.>` carries it on to the server;
# a difference is an err naming each one, and the app does not start.
pub fn compared db schema
  pg/run db (shadows schema)
    .> (_ -> pg/run db differences)
    .> (r -> pg/run db (unshadowed schema) .> (_ -> verdict db r.rows))

shadowed = "senro_expected_"

fn shadows schema
  each = list/map (keys schema) (t -> shadow t schema[t])
  text/join (list/to_list each) "; "

fn shadow table none
  "create temporary table {shadowed}{table} ()"

fn shadow table columns
  "create temporary table {shadowed}{table} ({text/join columns ", "})"

fn unshadowed schema
  each = list/map (keys schema) (t -> "drop table {shadowed}{t}")
  text/join (list/to_list each) "; "

differences = """
  with expected as (
    select substr(c.relname, 16) as tab, a.attname::text as col,
      format_type(a.atttypid, a.atttypmod) as kind, a.attnotnull as required
    from pg_attribute a join pg_class c on c.oid = a.attrelid
    where c.relnamespace = pg_my_temp_schema() and c.relkind = 'r'
      and starts_with(c.relname, 'senro_expected_')
      and a.attnum > 0 and not a.attisdropped
  ), live as (
    select c.relname::text as tab, a.attname::text as col,
      format_type(a.atttypid, a.atttypmod) as kind, a.attnotnull as required
    from pg_attribute a join pg_class c on c.oid = a.attrelid
    where c.relnamespace = current_schema()::regnamespace and c.relkind = 'r'
      and c.relname in (select tab from expected)
      and a.attnum > 0 and not a.attisdropped
  )
  select coalesce(e.tab, l.tab) as tab, coalesce(e.col, l.col) as col,
    e.kind as expected, l.kind as live,
    e.required as expected_required, l.required as live_required,
    exists (select 1 from live x where x.tab = coalesce(e.tab, l.tab)) as found
  from expected e full join live l on e.tab = l.tab and e.col = l.col
  where e.col is null or l.col is null or e.kind <> l.kind
    or e.required <> l.required
  order by 1, 2
"""

fn verdict db rows
  return db if length rows == 0
  told = list/to_list (list/map rows difference)
  unique = list/fold told [] (acc d -> once acc d)
  lines = text/join (list/to_list (list/map unique (d -> "  {d}"))) "\n"
  err "{differs}\n{lines}"

differs = "the database differs from the schema this app was compiled with:"

fn once acc d
  return acc if list/any? acc (seen -> seen == d)
  list/concat acc [d]

# A side the full join found nothing on reads "" for its kind.
fn difference r
  at = plain r["tab"]
  col = plain r["col"]
  kind = plain r["expected"]
  live = plain r["live"]
  return "no table `{at}`" if not holds? r["found"]
  return "`{at}` has a column `{col}` no migration makes" if kind == ""
  return "`{at}` has no column `{col}`" if live == ""
  return typed "{at}.{col}" kind live if live != kind
  required = nullness (holds? r["expected_required"])
  "`{at}.{col}` {required} in the migrations and not in the database"

fn plain none
  ""

fn plain s
  s

fn holds? true
  true

fn holds? none
  false

fn holds? _
  false

fn typed at expected live
  "`{at}` is {live} in the database and {expected} in the migrations"

fn nullness true
  "is not null"

fn nullness _
  "takes a null"
