import "../pg"
import "std/base64"
import "std/io"
import "std/json"
import "std/list"
import "std/net"
import "std/net/http"
import "std/os"
import "std/pool"
import "std/sha256"
import "std/text"
import "std/time"

type hit
  action
  kind
  id
  limit

# One client's calls to one limited action, beside the window they are
# counted in, so that a sweep can tell when every one of them has aged out.
type tally
  within
  times

# What the server keeps of its clients' calls: a tally for each client and
# action, and how many it may hold before it next looks for ones to forget.
type book
  seen
  next

type moved
  path

# A component whose actions run on the server: the `act` kata wrote for its
# module and the view that draws a state.
type wired
  act
  view

# What a model's checked write answers when its policy says no, and when the
# row it was asked for is not there. The server answers a server action that
# answers one of them as a 403 or a 404.
pub type denied

pub type absent

# What the server hands a server component's action besides its state.
type handed
  req
  db
  viewer

type site
  routes
  dbs
  connect
  calls

# A server for an app's route table. Each connection is answered in a fiber
# of its own beside the one that accepts the next, so a slow request holds up
# nobody else. A request is looked up by its method and path and handed to
# the action with a database session, which it borrows from a pool of
# `sessions` that `connect` opened when the server started. Two requests
# never hold one session at once, because their queries would interleave on
# its socket; a request that finds every session lent waits for one to come
# back. An action answers an effect that yields the response.
#
# An action its module limits (`rate_limits`, in routes) is called only so
# often by one client, told apart by its address. The calls each client made
# in the window are kept in this server's memory, in a pool holding one map,
# so two requests never count at once; they start over when the server does,
# and two servers count apart. A call past the limit is answered 429 Too Many
# Requests without reaching the action. A client whose calls have all aged out
# of their window is forgotten once the map has grown past `sweep_past`
# clients (`remembered` says how many it holds).
pub fn serve at routes connect
  pool/make sessions
    .> (dbs -> filled dbs connect sessions)
    .> (dbs -> counting .> (calls -> opening at routes dbs connect calls))

fn opening at routes dbs connect calls
  listened at (site routes dbs connect calls)

# The pool of one book a server counts its clients' calls in.
pub counting = pool/make 1 .> first_book

fn first_book p
  pool/give p (book {} sweep_past) .> (_ -> effect p)

sessions = 4

fn filled dbs _ 0
  effect dbs

fn filled dbs connect n
  connect .> (db -> pool/give dbs db) .> (_ -> filled dbs connect (n - 1))

fn listened at s
  net/listen at .> (l -> net/port l .> (p -> opened l p s))

fn opened l p s
  print "senro on port {p}" .> (_ -> served l s)

fn served l s
  net/accept l .> (c -> forked l c s)

fn forked l c s
  answered c s
  served l s

fn answered c s
  gathered c (text/to_bytes []) -1
    .> (raw -> request_text raw)
    .> (got -> handed_on c s got)

# A refusal is written as it stands: std/net/http has no reason phrase for
# every status the server refuses with.
fn handed_on c _ r:refused_with
  phrase = "{r.reason}\n"
  line = "HTTP/1.1 {r.status} {r.reason}\r\ncontent-length: {length phrase}"
  net/write c "{line}\r\nconnection: close\r\n\r\n{phrase}"
    .> (_ -> net/close_conn c)

fn handed_on c s raw
  time/now
    .> (t -> net/peer c .> (from -> heard_from raw t from))
    .> (req -> heard c s req)

fn heard_from raw t from
  effect (arrived raw t from)

# The request as the server heard it, with the time it arrived, in
# milliseconds since the epoch, under `senro-at`, the address of the client
# under `senro-peer`, and the query string, taken off the path, under
# `senro-query`. The lines go after the client's headers, and the
# last of two headers with one name is the one parsed, so a value the client
# sent under either name is replaced: a session's age is measured by the
# server's clock alone, and a client cannot name itself another.
fn arrived raw t from
  parts = text/split raw "\r\n\r\n"
  return http/parsed raw if length parts < 2
  rest = text/join (list/to_list (list/drop parts 1)) "\r\n\r\n"
  lines = text/split parts[1] "\r\n"
  asked = text/split (said lines[1]) " "
  return http/parsed raw if length asked < 3
  cut = text/split (said asked[2]) "?"
  query = text/join (list/to_list (list/drop cut 1)) "?"
  path = list/concat [asked[1] cut[1]] (list/to_list (list/drop asked 2))
  line = text/join path " "
  theirs = list/to_list (list/drop lines 1)
  ours = ["senro-at: {t}" "senro-peer: {from}" "senro-query: {query}"]
  head = list/concat (list/concat [line] theirs) ours
  http/parsed "{text/join head "\r\n"}\r\n\r\n{rest}"

# The address of the client that made a request, as Rails' `remote_ip` reads
# it: "127.0.0.1", or an IPv6 address in its short form.
pub fn peer req
  req.headers["senro-peer"]

fn heard c s req
  probe_at = blank_if_none req.headers["senro-at"]
  print "PROBE {req.method} {req.path} {probe_at}" .> (_ -> heard_now c s req)

fn heard_now c s req
  return live c s.connect if req.path == "/senro/live"
  method = method_of req
  return crossed c if forged? method req
  action = matched s.routes method req.path
  by = sender req.headers["senro-page"]
  answer = (db -> answered_by action req db)
  answering = pool/with s.dbs (db -> responded c db req method by (answer db))
  turned = turned_away action req
  allowed s.calls action req
    .> (fine -> let_in fine c answering turned)
    .> (_ -> net/close_conn c)

# A request that would change something, sent by a page on another site, as
# Rails' `protect_from_forgery` refuses one. The session cookie is
# SameSite=Lax, so a browser should not send it on such a request at all;
# this refuses the request even when it does. A browser says where a
# request came from in `Sec-Fetch-Site`, and in `Origin` when it is older
# than that header: anything but the app's own origin is refused. A request
# with neither header comes from a program, not a page, and is let through.
fn forged? method req
  return false if method == "GET" or method == "HEAD"
  elsewhere? req.headers["sec-fetch-site"] req

fn elsewhere? none req
  foreign? req.headers["origin"] req.headers["host"]

fn elsewhere? where _
  where != "same-origin" and where != "none"

fn foreign? none none
  false

fn foreign? none _
  false

fn foreign? _ none
  true

fn foreign? origin host
  parts = text/split origin "://"
  length parts != 2 or list/last parts != host

fn crossed c
  r = http/respond 403 [] "Forbidden: a request from another site\n"
  sent c r .> (_ -> net/close_conn c)

fn let_in true _ answering _
  answering

fn let_in false c _ turned
  turned .> (r -> sent c r)

# What a call past its action's limit is answered: the module's `over_limit`
# when it writes one, and 429 Too Many Requests when it does not.
fn turned_away none _
  too_many

fn turned_away (hit _ _ _ none) _
  too_many

fn turned_away (hit _ _ _ l) req
  over_limit l["over"] req

fn turned_away _ _
  too_many

fn over_limit none _
  too_many

fn over_limit over req
  over req

too_many = effect (http/respond 429 [] "Too Many Requests\n")

fn allowed _ none _
  effect true

fn allowed _ (hit _ _ _ none) _
  effect true

fn allowed calls (hit _ _ _ l) req
  at = "{l["key"]} {peer req}"
  checked calls at l["count"] l req

fn checked _ _ none _ _
  effect true

fn checked calls at count l req
  windowed calls at count l["within"] req

fn windowed _ _ _ none _
  effect true

fn windowed calls at count within req
  taken = pool/take calls
  heard_at = text/to_int (said req.headers["senro-at"])
  arrival heard_at .> (t -> taken .> (b -> counted calls b at count within t))

# When a request arrived: the time the server stamped on it, or now for one
# built by hand.
fn arrival none
  time/now

fn arrival t
  effect t

fn allowed _ _ _
  effect true

# The calls one client made to one action, in the window that ends now. A call
# the limit allows is counted, and one it does not is not, so a client that
# keeps calling is let in again once its earlier calls have aged out.
fn counted calls (book seen next) at count within t
  since = t - within
  recent = list/to_list (list/select (made seen[at]) (when -> when > since))
  fine = length recent < count
  noted = put seen at (tally within (tallied recent fine t))
  pool/give calls (booked noted next t) .> (_ -> effect fine)

fn made none
  []

fn made (tally _ times)
  times

# Whether a client is let in decides nothing about one that has stopped
# calling, so a server that hears from many addresses would hold a tally for
# each of them for as long as it runs. Past `sweep_past` clients, and then
# past twice as many as the last sweep left, the book forgets every client
# whose calls have all aged out. Doubling the mark keeps the sweeps rare when
# most clients are still calling: each one is paid for by as many new
# clients as it kept.
pub sweep_past = 1024

fn booked seen next t
  return book seen next if length seen <= next
  left = swept seen t
  book left (marked (2 * length left))

fn marked n
  return sweep_past if n < sweep_past
  n

fn swept seen t
  list/fold (keys seen) seen (acc k -> pruned acc k seen[k] t)

fn pruned acc _ none _
  acc

fn pruned acc k (tally within times) t
  return acc if list/any? times (when -> when > t - within)
  delete acc k

# How many clients a server's counting pool holds a tally for.
pub fn remembered calls
  pool/take calls .> (b -> pool/give calls b .> (_ -> effect (length b.seen)))

# Whether `calls` lets in a request under `limit`, a map holding the `key`,
# `count` and `within` an action's limit is read into, and counts it if so.
pub fn admits calls limit req
  allowed calls (hit none none none limit) req

fn tallied recent true t
  push recent t

fn tallied recent false _
  recent

fn responded c db req method by answer
  answer
    .> (r -> told db method by r)
    .> (r -> versioned by r)
    .> (r -> sent c (unchanged req r))

fn unchanged req r
  had = "set-cookie: senro={cookie req.headers["cookie"] "senro"};"
  same = (h -> text/starts_with? h had)
  return r if not list/any? r.headers same
  kept_lines = list/to_list (list/reject r.headers same)
  http/respond r.status kept_lines r.body

# An answer to senro's page script carries the version of the app's browser
# modules, so a page that loaded an older deploy's modules learns of the new
# one with its next request and loads itself again.
fn versioned "" r
  effect r

fn versioned _ r
  modules_version .> (v -> effect (headed r "senro-version: {v}"))

fn headed r line
  http/respond r.status (push r.headers line) r.body

# The version of the app's browser modules: the modification times of the
# module and the runtime it runs on, which a deploy that changes either moves.
# The page script keeps both in the browser's Cache Storage under it, so a
# returning visitor compiles them without asking for them.
modules_version = os/modified "public/senro/app.wasm"
  .> (a -> os/modified "public/senro/runtime.wasm" .> (b -> both a b))

fn both a b
  effect "{stamp a}-{stamp b}"

fn stamp _:os/file_not_found
  "none"

fn stamp at
  "{at}"

# A form can only GET or POST, so a POST says which method it stands for in a
# `_method` field, as Rails does: PATCH to update, DELETE to destroy.
fn method_of req
  return req.method if req.method != "POST"
  meant (value (form req.body) "_method")

fn meant "PATCH"
  "PATCH"

fn meant "DELETE"
  "DELETE"

fn meant _
  "POST"

# A request that is not a GET may have changed what the app stores, so the
# server says so on Postgres's `senro` channel before it answers, and every
# page listening at /senro/live fetches itself again. The notification names
# the page that sent the request, from its senro-page header, so that page
# leaves it alone: the answer it is about to get is already the new page.
fn told _ "GET" _ r
  effect r

fn told db _ by r
  pg/query db "select pg_notify('senro', $1)" [by] .> (_ -> effect r)

fn sender none
  ""

fn sender page
  page

# A page that loaded senro's script listens here. The stream holds a database
# session of its own, listening on the `senro` channel, and writes an event
# for each notification, from this server or any other on the same database.
# It ends when the page has gone and a write fails.
fn live c connect
  connect .> (db -> listening c db)

fn listening c db
  heard_all = net/write c stream_head
    .> (_ -> pg/run db "listen senro")
    .> (_ -> relayed c db)
  heard_all .? (_ -> effect 0) .> (_ -> pg/close db) .> (_ -> net/close_conn c)

fn relayed c db
  pg/notified db
    .> (p -> net/write c "data: changed {p}\n\n")
    .> (_ -> relayed c db)

stream_head = "HTTP/1.1 200 OK\r\n{event_stream}\r\n{uncached}\r\n\r\n"

event_stream = "content-type: text/event-stream"

uncached = "cache-control: no-cache"

# An action that fails is the app's failure, born in another hako, so the
# server may rescue it: the reason goes to standard error, the browser gets a
# 500, and the connection is closed as any other is. The server goes on
# accepting. A failure an app expects is a value its action answers, so what
# reaches here is one it did not plan for.
fn answered_by none req db
  routed none req db

fn answered_by action req db
  routed action req db .? failed

fn failed u
  io/write_err "senro: a request failed: {u.reason}\n"
    .> (_ -> effect (http/respond 500 [] "Internal Server Error\n"))

# Every answer says the connection closes after it, since the server closes
# each connection once it has answered one request. A browser told otherwise
# keeps the connection to reuse, and a request it sends down one the server
# has closed is lost.
fn sent c r
  wrote c r r.body

fn wrote c r body:string
  head_of c r (length (text/bytes body)) .> (_ -> net/write c body)

# A bytes body, such as a wasm module, goes after its head on its own, since
# a string holding the head cannot hold the bytes.
fn wrote c r body
  head_of c r (length body) .> (_ -> net/write c body)

fn head_of c r size
  lines = list/concat r.headers ["content-length: {size}" "connection: close"]
  status = "HTTP/1.1 {r.status} {r.reason}"
  net/write c "{status}\r\n{text/join lines "\r\n"}\r\n\r\n"

# A request's route: its own path first, then the path with the segment after
# the module's name read as `:id`, so /entries/3 and /entries/3/edit find
# GET /entries/:id and GET /entries/:id/edit. A path longer than either is
# looked for among the nested routes, whose parent's id is the third segment
# and whose own `:id`, when they take one, the fifth.
pub fn matched routes method path
  whole = routes["{method} {path}"]
  return found whole "" if whole != none
  parts = text/split path "/"
  return none if length parts < 3
  head = list/to_list (list/take parts 2)
  tail = list/to_list (list/drop parts 3)
  pattern = text/join (list/concat (push head ":id") tail) "/"
  flat = routes["{method} {pattern}"]
  return found flat parts[3] if flat != none
  nested_in routes method parts

fn nested_in routes method parts
  return none if length parts < 4
  fits = list/select (entries routes) (e -> shaped? e.key method parts)
  nested_found (list/first (list/to_list fits)) parts

# Whether a route's key reads as this request: the same method, as many
# segments, and each segment the same word or a parameter.
fn shaped? key method parts
  words = text/split key " "
  return false if length words != 2 or words[1] != method
  segments = text/split (blank_if_none words[2]) "/"
  return false if length segments != length parts
  alike? segments parts 1

fn alike? segments parts i
  return true if i > length segments
  s = segments[i]
  same = s == parts[i] or text/starts_with? s ":"
  same and alike? segments parts (i + 1)

# The parent's id reaches the action first, as its kind reads, and a segment
# that is not a number is not an int's route. The action is handed on with
# the parent's id in place, so it takes what an action that is not nested
# would.
fn nested_found none _
  none

fn nested_found e parts
  row = e.value
  parent = parent_id row["within"] (blank_if_none parts[3])
  return none if parent == none
  kind = id_kind row["id"]
  curried = beneath row["action"] kind parent
  found (put row "action" curried) (own_id kind parts)

fn parent_id "int" segment
  text/to_int segment

fn parent_id none _
  none

fn parent_id _ segment
  segment

fn own_id "" _
  ""

fn own_id _ parts
  parts[5]

fn beneath none "" _
  none

fn beneath none _ _
  none

fn beneath action "" parent
  (req db -> action req db parent)

fn beneath action _ parent
  (req db id -> action req db parent id)

fn found none _
  none

fn found row id
  aimed row["to"] row id

fn aimed none row id
  limited (took row["action"] row["id"] id) row["limit"]

fn aimed to _ id
  moved (redirected to id)

# Where a request `matched` found is redirected when a legacy alias answered
# it, or "" when it was not. An alias redirects to its route with the id it
# was asked for.
pub fn moved_to none
  ""

pub fn moved_to (moved path)
  path

pub fn moved_to _
  ""

fn redirected to ""
  to

fn redirected to id
  text/join (text/split to ":id") id

fn took none none _
  none

fn took none _ _
  none

fn took _ none _
  none

fn took action kind id
  hit action kind id none

# The limit its module set on the action, when it set one.
fn limited none _
  none

fn limited (hit action kind id _) none
  hit action kind id none

fn limited (hit action kind id _) l
  hit action kind id l

# A GET no route answers is senro's page script at /senro.js, or else it is
# looked for under `public/`, beside the app, the way a stylesheet or an
# image is served. A path that climbs out of it, or a file that is not there,
# is a 404.
fn routed none req _
  return effect http/not_found if req.method != "GET"
  return page_script if req.path == "/senro.js"
  return blob req if text/starts_with? req.path "/senro/blobs/"
  return effect http/not_found if length (text/split req.path "..") > 1
  return served_module req if text/ends_with? req.path ".wasm"
  os/read_file "public{req.path}" .> (got -> served_file req.path got)

# A wasm module is bytes, read as bytes: the app's components compiled for the
# browser, and the runtime they run on. Each goes out with an ETag made of the
# file's modification time and size, as a static file server's is, and the
# browser is told to check it before reusing its copy. A request whose
# If-None-Match names the module as it stands is answered 304 with no body,
# so a visitor downloads a module once per deploy that changes it. Hashing
# the bytes instead cost the interpreter four seconds a request on the
# runtime.
fn served_module req
  had = blank_if_none req.headers["if-none-match"]
  path = "public{req.path}"
  os/modified path .> (at -> os/read_bytes path .> (got -> stamped had at got))

fn stamped _ _ _:os/file_not_found
  effect http/not_found

fn stamped had at got
  served_bytes had "\"{at}-{length got}\"" got

fn blank_if_none none
  ""

fn blank_if_none v
  v

fn served_bytes had tag body
  fresh = ["etag: {tag}" "cache-control: no-cache"]
  return effect (http/respond 304 fresh "") if had == tag
  effect (http/page (push fresh "content-type: application/wasm") body)

javascript = "content-type: text/javascript; charset=utf-8"

# senro's page script, opened with the version of the app's modules. It is
# small, and the browser is told to check it before reusing a copy, since a
# copy from before a deploy would name the old version.
page_script = modules_version .> (v -> effect (opened_with v))

fn opened_with v
  heads = [javascript "cache-control: no-cache"]
  http/page heads "const senroVersion = \"{v}\";\n{script}"

fn served_file path body:string
  effect (http/page ["content-type: {kind_of path}"] body)

fn served_file _ _
  effect http/not_found

fn kind_of path
  return "text/css; charset=utf-8" if text/ends_with? path ".css"
  return "text/html; charset=utf-8" if text/ends_with? path ".html"
  return "image/svg+xml" if text/ends_with? path ".svg"
  return "text/javascript; charset=utf-8" if text/ends_with? path ".js"
  "text/plain; charset=utf-8"

fn routed (hit action kind id _) req db
  called action kind id req db

fn routed (moved path) _ _
  effect (http/respond 308 ["location: {path}"] "")

# An `:id` the action annotates as an int reaches it as one, and a segment
# that is not a number is not that route.
fn called action "int" id req db
  numbered action (text/to_int id) req db

fn called action "any" id req db
  action req db id

fn called action _ _ req db
  action req db

fn numbered _ none _ _
  effect http/not_found

fn numbered action n req db
  action req db n

# Whether a write answered a refusal rather than what it wrote.
pub fn refused? denied
  true

pub fn refused? absent
  true

pub fn refused? _
  false

# The answer to a write a model refused: 403 for a policy's no, 404 for a
# row that is not there.
pub fn refusal denied
  http/respond 403 [] "Forbidden\n"

pub fn refusal absent
  http/not_found

# The app's components whose actions run on the server, added to its route
# table. Each answers POST /senro/act/<component> and nothing else, so only
# a component the app names here, and only an action one of its templates
# binds, can be reached from a page:
#
#   web/serve 3001 (web/components routes secret { "stars": stars }) connected
#
# where `stars = web/component stars/act stars/view`. `secret` is the one the
# app signs its sessions with, so an action that asks for the viewer is handed
# the one the session names.
pub fn component act view
  wired act view

pub fn components routes secret table
  list/fold (keys table) routes (acc n -> routed_to acc n secret table[n])

fn routed_to routes _ _ none
  routes

fn routed_to routes n secret c
  put routes "POST /senro/act/{n}" (act_row c secret)

fn act_row c secret
  acting = (req db -> acted c req db (viewer req secret))
  { "action":acting "id":"" "open":true }

# The body is the action's name and the state as JSON, on two lines. A
# request without the page's senro-page header did not come from senro's
# script; a form on another site cannot set one, so it is refused, which is
# what keeps a page elsewhere from acting with this visitor's cookie.
fn acted c req db who
  return effect forbidden if req.headers["senro-page"] == none
  lines = text/split req.body "\n"
  return effect bad_request if length lines < 2
  state = json/decode (text/join (list/to_list (list/drop lines 1)) "\n")
  stated c lines[1] state req db who

forbidden = http/respond 403 [] "Forbidden\n"

bad_request = http/respond 400 [] "Bad Request\n"

fn stated _ _ none _ _ _
  effect bad_request

fn stated c action state req db who
  c.act action (handed req db who) state .> (next -> drawn c next)

fn drawn _ none
  effect http/not_found

fn drawn _ denied
  effect forbidden

fn drawn _ absent
  effect http/not_found

fn drawn c next
  effect (http/page [plain] "{json/encode next}\n{c.view next}")

plain = "content-type: text/plain; charset=utf-8"

# A 303 to `path`: the browser asks for it with a GET, which is how a form
# post ends without leaving a page that posts again when reloaded.
pub fn redirect path
  http/respond 303 ["location: {path}"] ""

# Every action in `routes` asks for a visitor who has signed in, except the
# ones their module lists in `without_sign_in`, as Rails 8's generated
# authentication requires one unless an action allows otherwise. A visitor
# who has not signed in is sent to `/session/new`, and the path a GET asked
# for is kept in the session, where `return_to` finds it once they have.
# An alias's redirect is left as it is, since it answers no content. A
# component's action, like an action its module lists in `without_sign_in`,
# is open to anyone, and asks its model's policy who may do what; so the
# table a component joins (`components`) goes through here too.
#
# A sign-in rests on something the account holds, its password's digest in
# the guestbook, and `signed_in` keeps a fingerprint of it in the session.
# `bound_of db id` reads it now, at every action, open or not. When the two
# differ, as they do once the password has changed, the sign-in is over, as
# a new password ends every older sign-in in Devise. An action that asks for
# a sign-in sends the visitor to sign in again. An open one runs for a
# visitor who is not signed in, reading the session as `signed_out` leaves
# it, and its answer tells the browser to forget the sign-in too. An app
# whose sign-ins rest on nothing passes `unbound` here and "" to
# `signed_in`.
pub fn requiring_sign_in routes secret bound_of
  each = (acc e -> put acc e.key (guarded e.value secret bound_of))
  list/fold (entries routes) {} each

# What a sign-in rests on, for an app whose sign-ins rest on nothing.
pub unbound = (_ _ -> effect "")

fn guarded row secret bound_of
  return row if row["to"] != none
  kind = id_kind row["id"]
  open = row["open"] != none
  gate = (req db go -> admitted req db open secret bound_of go)
  put row "action" (gated row["action"] kind (row["within"] != none) gate)

fn id_kind none
  ""

fn id_kind kind
  kind

fn gated none _ _ _
  none

fn gated action kind nested gate
  gated_by kind nested action gate

# A nested action takes its parent's id before its own.
fn gated_by "" false action gate
  (req db -> gate req db (r -> action r db))

fn gated_by "" true action gate
  (req db p -> gate req db (r -> action r db p))

fn gated_by _ false action gate
  (req db id -> gate req db (r -> action r db id))

fn gated_by _ true action gate
  (req db p id -> gate req db (r -> action r db p id))

fn admitted req db open secret bound_of go
  who = viewer req secret
  s = session req secret
  return go req if who == "" and open
  return turned_back req secret s if who == ""
  bound_of db who .> (b -> current req open secret s b go)

fn current req open secret s bound go
  return go req if said s["bound"] == fingerprint secret bound
  return turned_back req secret (forgotten s) if not open
  ended = forgotten s
  go (reheard req secret ended) .> (r -> effect (forgetting r secret ended))

# `req` as its action reads it once its sign-in is over: its cookie names
# the session `held` first, which is the one `session` reads.
fn reheard req secret held
  ours = "senro={sealed_of secret held}"
  cookies = with_cookie ours req.headers["cookie"]
  named = entries (put req.headers "cookie" cookies)
  lines = list/map named (e -> "{e.key}: {e.value}")
  head = text/join (list/to_list lines) "\r\n"
  http/parsed "{req.method} {req.path} HTTP/1.1\r\n{head}\r\n\r\n{req.body}"

fn with_cookie ours none
  ours

fn with_cookie ours others
  "{ours}; {others}"

# The answer `r`, telling the browser to keep `held` rather than the sign-in
# it sent, unless the action already set a session of its own.
fn forgetting r secret held
  return r if list/any? r.headers sets_session?
  kept r secret held

fn sets_session? h
  text/starts_with? h "set-cookie: senro="

fn turned_back req secret s
  return effect (kept (redirect "/session/new") secret s) if req.method != "GET"
  effect (kept (redirect "/session/new") secret (put s "return_to" req.path))

# Where a visitor sent to sign in was going, or `fallback` when nobody sent
# them. An app's sign-in redirects there once the password matches.
pub fn return_to req secret fallback
  went (session req secret)["return_to"] fallback

fn went none fallback
  fallback

fn went path _
  path

# A session is a map of strings the browser keeps in a cookie and sends back
# with each request. The cookie holds the map as JSON beside an HMAC-SHA-256
# of it under the app's secret, so a session the browser altered, or one no
# secret of this app signed, reads as an empty map.
#
# A sign-in lasts `session_days`. The session keeps the time it began, and a
# request that arrives later than that reads the session without its viewer;
# whatever else it keeps, such as a notice, survives. A request the server
# did not stamp, as a spec builds by hand, has no age to measure.
pub fn session req secret
  m = verified (cookie req.headers["cookie"] "senro") secret
  at = text/to_int (said req.headers["senro-at"])
  aged m at (text/to_int (said m["since"]))

pub session_days = 14

day = 24 * 60 * 60 * 1000

fn aged m none none
  m

fn aged m none _
  m

fn aged m _ none
  forgotten m

fn aged m at since
  return forgotten m if at - since > session_days * day or at < since
  m

fn forgotten m
  signing = ["viewer" "since" "bound" "lasting"]
  list/fold signing m (acc k -> delete acc k)

fn said none
  ""

fn said v
  v

# Who the session says is signed in: the id an app kept under "viewer" when
# it signed them in (`signed_in`), or "" for a visitor who has not been.
pub fn viewer req secret
  signed_as (session req secret)["viewer"]

fn signed_as none
  ""

fn signed_as v
  v

# The response to `req`, signing `id` in: the session the next request reads
# names them as its viewer, beside whatever else `held` keeps, until
# `session_days` after `req` arrived.
#
# The sign-in rests on `bound`, the account's password digest in the
# guestbook. The session keeps an HMAC of it rather than the value itself,
# since a session is signed and not secret; `requiring_sign_in` compares it
# with what the account holds at each gated action.
pub fn signed_in req r secret held id bound
  since = said req.headers["senro-at"]
  viewing = put (put held "viewer" id) "since" since
  kept r secret (put viewing "bound" (fingerprint secret bound))

fn fingerprint secret bound
  hexed (sha256/hmac (text/bytes secret) (text/bytes "signed in {bound}"))

# The response, with `held` kept as the session the next request reads.
#
# The cookie lasts as long as the browser does, so closing it signs the
# visitor out, unless the session was made `lasting`.
pub fn kept r secret held
  sealed = sealed_of secret held
  line = "set-cookie: senro={sealed}; Path=/; HttpOnly; SameSite=Lax"
  http/respond r.status (push r.headers (aged_line line held)) r.body

fn aged_line line held
  return line if held["lasting"] != "yes"
  "{line}; Max-Age={session_days * 24 * 60 * 60}"

# The session `held`, kept by the browser for `session_days` rather than
# until it closes, as Devise's "remember me" does. The session says so
# itself, so every later response that keeps it keeps the cookie as long,
# whatever else it changes. A sign-in still ends `session_days` after it
# began, because the session keeps the time it began; this only lets it
# outlive the browser. Signing out forgets it with the viewer.
pub fn lasting held
  put held "lasting" "yes"

# The session `held` without its sign-in: the viewer, when it began, what it
# rests on, and whether it outlives the browser. Whatever else it keeps,
# such as a notice, stays.
pub fn signed_out held
  forgotten held

fn sealed_of secret held
  body = base64/encode (text/bytes (json/encode held))
  "{body}.{signature secret body}"

fn signature secret body
  base64/encode (sha256/hmac (text/bytes secret) (text/bytes body))

fn cookie none _
  ""

fn cookie header name
  pairs = list/to_list (list/map (text/split header ";") text/trim)
  wanted = list/to_list (list/select pairs (p -> text/starts_with? p "{name}="))
  return "" if length wanted == 0
  text/join (list/to_list (list/drop (text/split wanted[1] "=") 1)) "="

fn verified "" _
  {}

fn verified sealed secret
  parts = text/split sealed "."
  return {} if length parts != 2
  return {} if signature secret parts[1] != parts[2]
  opened (base64/decode parts[1])

fn opened none
  {}

# A signed cookie holds JSON this app wrote, which is always a map.
fn opened raw
  read_back (json/decode (text/utf8 (list/to_list raw)))

fn read_back none
  {}

fn read_back m
  m

# A form posted as application/x-www-form-urlencoded, as a map from each
# field's name to its value. A field the form did not send reads as "".
pub fn form body
  pairs = text/split body "&"
  list/fold pairs {} (acc pair -> field acc (text/split pair "="))

fn field acc parts
  return acc if length parts < 2
  put acc (decoded parts[1]) (decoded parts[2])

# The query string a request came with, as a form: `/notes?page=2` reads
# as `{ "page":"2" }`, which `value` reads as it reads a posted field.
pub fn query req
  form (said req.headers["senro-query"])

pub fn value f name
  given f[name]

fn given none
  ""

fn given v
  v

# `+` is a space, and `%` and two hex digits are one byte.
fn decoded s
  percent_decoded (text/join (text/split s "+") " ")

# Text with each `%` and the two hex digits after it read as one byte, as a
# URL writes a character it cannot hold. A `+` stays a `+`.
pub fn percent_decoded s
  text/utf8 (unescaped (list/to_list (text/bytes s)) 1 [])

fn unescaped bs at acc
  return acc if at < 1 or at > length bs
  return unescaped bs (at + 1) (push acc bs[at]) if bs[at] != 37
  return acc if at + 2 > length bs
  byte = hex bs[at + 1] * 16 + hex bs[at + 2]
  unescaped bs (at + 3) (push acc byte)

# Bytes as lowercase hex, two characters to a byte.
pub fn hexed bs
  text/join (list/to_list (list/map (list/to_list bs) (b -> byte_hex b))) ""

fn byte_hex b
  "{hexit (b / 16)}{hexit (b % 16)}"

fn hexit n
  given (text/slice "0123456789abcdef" (n + 1) (n + 1))

fn hex c
  return c - 48 if c >= 48 and c <= 57
  return c - 55 if c >= 65 and c <= 70
  return c - 87 if c >= 97 and c <= 102
  0
