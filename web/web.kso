import "std/base64"
import "std/io"
import "std/json"
import "std/list"
import "std/net"
import "std/net/http"
import "std/os"
import "std/pool"
import "std/sha256"
import "std/text"

type hit
  action
  kind
  id

type moved
  path

# A server for an app's route table. Each connection is answered in a fiber
# of its own beside the one that accepts the next, so a slow request holds up
# nobody else. A request is looked up by its method and path and handed to
# the action with a database session, which it borrows from a pool of
# `sessions` that `connect` opened when the server started. Two requests
# never hold one session at once, because their queries would interleave on
# its socket; a request that finds every session lent waits for one to come
# back. An action answers an effect that yields the response.
pub fn serve at routes connect
  pool/make sessions
    .> (dbs -> filled dbs connect sessions .> (_ -> listened at routes dbs))

sessions = 4

fn filled _ _ 0
  effect 0

fn filled dbs connect n
  connect .> (db -> pool/give dbs db) .> (_ -> filled dbs connect (n - 1))

fn listened at routes dbs
  net/listen at .> (l -> net/port l .> (p -> opened l p routes dbs))

fn opened l p routes dbs
  print "senro on port {p}" .> (_ -> served l routes dbs)

fn served l routes dbs
  net/accept l .> (c -> forked l c routes dbs)

fn forked l c routes dbs
  answered c routes dbs
  served l routes dbs

fn answered c routes dbs
  net/read c .> (raw -> heard c routes dbs (http/parsed raw))

fn heard c routes dbs req
  action = matched routes req.method req.path
  pool/with dbs (db -> answered_by action req db .> (r -> sent c r))
    .> (_ -> net/close_conn c)

# An action that fails is the app's failure, born in another hako, so the
# server may rescue it: the reason goes to standard error, the browser gets a
# 500, and the connection is closed as any other is. The server goes on
# accepting. A failure an app expects is a value its action answers, so what
# reaches here is one it did not plan for.
fn answered_by none req db
  routed none req db

fn answered_by action req db
  routed action req db .? failed

fn failed u
  io/write_err "senro: a request failed: {u.reason}\n"
    .> (_ -> effect (http/respond 500 [] "Internal Server Error\n"))

fn sent c r
  net/write c (http/rendered r)

# A request's route: its own path first, then the path with the segment after
# the module's name read as `:id`, so /entries/3 and /entries/3/edit find
# GET /entries/:id and GET /entries/:id/edit.
pub fn matched routes method path
  whole = routes["{method} {path}"]
  return found whole "" if whole != none
  parts = text/split path "/"
  return none if length parts < 3
  head = list/to_list (list/take parts 2)
  tail = list/to_list (list/drop parts 3)
  pattern = text/join (list/concat (push head ":id") tail) "/"
  found routes["{method} {pattern}"] parts[3]

fn found none _
  none

fn found row id
  aimed row["to"] row id

fn aimed none row id
  took row["action"] row["id"] id

fn aimed to _ id
  moved (redirected to id)

# An old path the app keeps as a legacy alias answers a permanent redirect to
# its route, with the id it was asked for.
# Where a request `matched` found is redirected when a legacy alias answered
# it, or "" when it was not.
pub fn moved_to none
  ""

pub fn moved_to (moved path)
  path

pub fn moved_to _
  ""

fn redirected to ""
  to

fn redirected to id
  text/join (text/split to ":id") id

fn took none none _
  none

fn took none _ _
  none

fn took _ none _
  none

fn took action kind id
  hit action kind id

# A GET no route answers is senro's page script at /senro.js, or else it is
# looked for under `public/`, beside the app, the way a stylesheet or an
# image is served. A path that climbs out of it, or a file that is not there,
# is a 404.
fn routed none req _
  return effect http/not_found if req.method != "GET"
  return effect (http/page [javascript] script) if req.path == "/senro.js"
  return effect http/not_found if length (text/split req.path "..") > 1
  os/read_file "public{req.path}" .> (got -> served_file req.path got)

javascript = "content-type: text/javascript; charset=utf-8"

fn served_file path body:string
  effect (http/page ["content-type: {kind_of path}"] body)

fn served_file _ _
  effect http/not_found

fn kind_of path
  return "text/css; charset=utf-8" if text/ends_with? path ".css"
  return "text/html; charset=utf-8" if text/ends_with? path ".html"
  return "image/svg+xml" if text/ends_with? path ".svg"
  return "text/javascript; charset=utf-8" if text/ends_with? path ".js"
  "text/plain; charset=utf-8"

fn routed (hit action kind id) req db
  called action kind id req db

fn routed (moved path) _ _
  effect (http/respond 308 ["location: {path}"] "")

# An `:id` the action annotates as an int reaches it as one, and a segment
# that is not a number is not that route.
fn called action "int" id req db
  numbered action (text/to_int id) req db

fn called action "any" id req db
  action req db id

fn called action _ _ req db
  action req db

fn numbered _ none _ _
  effect http/not_found

fn numbered action n req db
  action req db n

# A 303 to `path`: the browser asks for it with a GET, which is how a form
# post ends without leaving a page that posts again when reloaded.
pub fn redirect path
  http/respond 303 ["location: {path}"] ""

# A session is a map of strings the browser keeps in a cookie and sends back
# with each request. The cookie holds the map as JSON beside an HMAC-SHA-256
# of it under the app's secret, so a session the browser altered, or one no
# secret of this app signed, reads as an empty map.
pub fn session req secret
  verified (cookie req.headers["cookie"] "senro") secret

# The response, with `held` kept as the session the next request reads.
pub fn kept r secret held
  sealed = sealed_of secret held
  line = "set-cookie: senro={sealed}; Path=/; HttpOnly; SameSite=Lax"
  http/respond r.status (push r.headers line) r.body

fn sealed_of secret held
  body = base64/encode (text/bytes (json/encode held))
  "{body}.{signature secret body}"

fn signature secret body
  base64/encode (sha256/hmac (text/bytes secret) (text/bytes body))

fn cookie none _
  ""

fn cookie header name
  pairs = list/to_list (list/map (text/split header ";") text/trim)
  wanted = list/to_list (list/select pairs (p -> text/starts_with? p "{name}="))
  return "" if length wanted == 0
  text/join (list/to_list (list/drop (text/split wanted[1] "=") 1)) "="

fn verified "" _
  {}

fn verified sealed secret
  parts = text/split sealed "."
  return {} if length parts != 2
  return {} if signature secret parts[1] != parts[2]
  opened (base64/decode parts[1])

fn opened none
  {}

# A signed cookie holds JSON this app wrote, which is always a map.
fn opened raw
  read_back (json/decode (text/utf8 (list/to_list raw)))

fn read_back none
  {}

fn read_back m
  m

# A form posted as application/x-www-form-urlencoded, as a map from each
# field's name to its value. A field the form did not send reads as "".
pub fn form body
  pairs = text/split body "&"
  list/fold pairs {} (acc pair -> field acc (text/split pair "="))

fn field acc parts
  return acc if length parts < 2
  put acc (decoded parts[1]) (decoded parts[2])

pub fn value f name
  given f[name]

fn given none
  ""

fn given v
  v

# `+` is a space, and `%` and two hex digits are one byte.
fn decoded s
  bytes = list/to_list (text/bytes (text/join (text/split s "+") " "))
  text/utf8 (unescaped bytes 1 [])

fn unescaped bs at acc
  return acc if at < 1 or at > length bs
  return unescaped bs (at + 1) (push acc bs[at]) if bs[at] != 37
  return acc if at + 2 > length bs
  byte = hex bs[at + 1] * 16 + hex bs[at + 2]
  unescaped bs (at + 3) (push acc byte)

fn hex c
  return c - 48 if c >= 48 and c <= 57
  return c - 55 if c >= 65 and c <= 70
  return c - 87 if c >= 97 and c <= 102
  0
