# How the page script runs an app's browser module, as JavaScript of its
# own: a WASI host with the event in the environment and a page's bytes as
# the one file there is to open. The page script holds it, and
# spec/browser/module.mjs runs this same text under node, so the specs that
# run a module without a browser run it the way a page does.
runner = """
    class Exit \{}

    // One run of an app's module against a fresh runtime, both handed over
    // compiled: the event in SENRO_EVENT, and what the module printed. A
    // page's bytes are the one file the module can open, /senro/page, since
    // an environment variable cannot hold them. What the module writes to
    // its second stream goes to `told`, when there is one.
    const module_run = async (runtime, app, event, page, told) => \{
      const out = [];
      let memory = null;
      let read = 0;
      const bytes = () => new Uint8Array(memory.buffer);
      const view = () => new DataView(memory.buffer);
      const env = [new TextEncoder().encode("SENRO_EVENT=" + event + "\\0")];
      const calls = \{
        fd_write(fd, iovs, n, written) \{
          let total = 0;
          for (let k = 0; k < n; k++) \{
            const at = view().getUint32(iovs + k * 8, true);
            const len = view().getUint32(iovs + k * 8 + 4, true);
            const piece = bytes().slice(at, at + len);
            if (fd === 1) out.push(piece);
            else if (told) told(piece);
            total += len;
          }
          view().setUint32(written, total, true);
          return 0;
        },
        environ_sizes_get(count, size) \{
          view().setUint32(count, env.length, true);
          view().setUint32(size, env[0].length, true);
          return 0;
        },
        environ_get(at, buf) \{
          view().setUint32(at, buf, true);
          bytes().set(env[0], buf);
          return 0;
        },
        args_sizes_get(count, size) \{
          view().setUint32(count, 0, true);
          view().setUint32(size, 0, true);
          return 0;
        },
        fd_fdstat_get(fd, stat) \{
          bytes().fill(0, stat, stat + 24);
          return 0;
        },
        fd_prestat_get(fd, stat) \{
          if (fd !== 3 || !page) return 8;
          view().setUint32(stat, 0, true);
          view().setUint32(stat + 4, 1, true);
          return 0;
        },
        fd_prestat_dir_name(fd, name) \{
          bytes()[name] = 47;
          return 0;
        },
        path_open(dir, flags, path, len, o, base, inheriting, f, opened) \{
          const name = new TextDecoder().decode(bytes().slice(path, path + len));
          if (!page || name !== "senro/page") return 44;
          read = 0;
          view().setUint32(opened, 4, true);
          return 0;
        },
        fd_seek(fd, by, whence, place) \{
          if (fd !== 4) return 8;
          const from = whence === 0 ? 0 : whence === 1 ? read : page.length;
          read = Math.max(0, Math.min(page.length, from + Number(by)));
          view().setBigUint64(place, BigInt(read), true);
          return 0;
        },
        fd_read(fd, iovs, n, got) \{
          if (fd !== 4) return 8;
          let total = 0;
          for (let k = 0; k < n; k++) \{
            const at = view().getUint32(iovs + k * 8, true);
            const len = view().getUint32(iovs + k * 8 + 4, true);
            const some = page.subarray(read, read + len);
            bytes().set(some, at);
            read += some.length;
            total += some.length;
          }
          view().setUint32(got, total, true);
          return 0;
        },
        proc_exit() \{ throw new Exit(); },
      };
      const quiet = (t, name) => t[name] || (() => 0);
      const wasi = new Proxy(calls, \{ get: quiet });
      const rt = (await WebAssembly.instantiate(runtime,
        \{ wasi_snapshot_preview1: wasi })).exports;
      memory = rt.memory;
      const link = new DataView(
        WebAssembly.Module.customSections(app, "kanso.link")[0]);
      const table = rt.__indirect_function_table;
      const imports = \{
        memory: rt.memory,
        __indirect_function_table: table,
        __memory_base: new WebAssembly.Global(\{ value: "i32", mutable: false },
          rt.malloc(link.getUint32(0, true))),
        __table_base: new WebAssembly.Global(\{ value: "i32", mutable: false },
          table.grow(link.getUint32(4, true))),
      };
      for (const imp of WebAssembly.Module.imports(app)) \{
        if (!(imp.name in imports)) imports[imp.name] = rt[imp.name];
      }
      await WebAssembly.instantiate(app, \{ env: imports });
      try \{
        rt._start();
      } catch (e) \{
        if (!(e instanceof Exit)) throw e;
      }
      const all = new Uint8Array(out.reduce((n, c) => n + c.length, 0));
      let at = 0;
      for (const c of out) \{
        all.set(c, at);
        at += c.length;
      }
      return new TextDecoder().decode(all);
    };
"""

pub module_runner = runner

# The page script senro serves at /senro.js. A layout that loads it gets
# pages that update in place: a link followed or a form sent on the app's own
# origin is fetched, and the page it answers is morphed into the live one.
script = """
  // senro's page script. A link followed or a form sent on this origin is
  // fetched, and the page it answers is morphed into the live one, so the
  // browser never reloads. A field being typed in keeps what was typed,
  // unless its own form was sent: then the answer is what it should hold.
  (() => \{
    let sent = null;

    // This page's name for itself, sent with each request. The server names
    // the page whose request changed something when it announces the change,
    // and this page does not refetch on news of its own doing.
    const self = Math.random().toString(36).slice(2) + Date.now().toString(36);

    // Visits can overlap: a link followed while a refresh is on its way. The
    // page shows the answer to the visit started last, and an earlier one
    // that answers after it is dropped. A change announced while a visit is
    // in flight is fetched once that visit is done, since its answer may have
    // been read before the change.
    let started = 0;
    let flying = 0;
    let changed = false;

    const visit = async (url, init, pushed, form) => \{
      const mine = ++started;
      flying++;
      try \{
        const headers = \{ "senro-page": self };
        if (app) headers["senro-view"] = "1";
        const named = \{ ...init, headers };
        const r = await fetch(url, named);
        if (stale(r)) return;
        await shown(mine, r, init, pushed, form);
      } finally \{
        flying--;
        if (flying === 0 && changed) \{
          changed = false;
          visit(location.href, \{}, false);
        }
      }
    };

    // An answer from a server whose browser modules are not the ones this
    // page was opened with means a deploy came between them. The page loads
    // itself again, once for each version, to take the new script and
    // modules.
    const stale = (r) => \{
      const v = r.headers.get("senro-version");
      if (v === null || v === senroVersion) return false;
      try \{
        if (sessionStorage.getItem("senro-reloaded") === v) return false;
        sessionStorage.setItem("senro-reloaded", v);
      } catch (e) \{
        return false;
      }
      location.reload();
      return true;
    };

    const refresh = () => \{
      if (flying > 0) changed = true;
      else visit(location.href, \{}, false);
    };

    const shown = async (mine, r, init, pushed, form) => \{
      const kind = r.headers.get("content-type") || "";
      const data = r.headers.get("senro-view") !== null;
      if (!data && !kind.startsWith("text/html")) return plain(r, init);
      const text = data ? await rendered(r) : await r.text();
      if (text === null) return location.assign(r.url);
      if (mine !== started) return;
      const next = new DOMParser().parseFromString(text, "text/html");
      const moved = r.url !== location.href;
      if (pushed && moved) history.pushState(null, "", r.url);
      document.title = next.title;
      sent = form || null;
      morph(document.body, next.body);
      sent = null;
      const asked = document.querySelector("[autofocus]");
      if (asked && asked !== document.activeElement) asked.focus();
      if (pushed && moved) scrollTo(0, 0);
    };

    // A page sent as data is bytes, which the app's module renders with the
    // same views the server renders with. A module that cannot read them,
    // say one from an older deploy whose pages take other values, renders
    // nothing, and the page is left to the browser to load.
    const rendered = async (r) => \{
      const page = new Uint8Array(await r.arrayBuffer());
      try \{
        const html = await ran("\\n\\n", page);
        return html.trim() === "" ? null : html;
      } catch (e) \{
        return null;
      }
    };

    // An answer that is not a page is shown as the browser would show it. A
    // GET is simply followed; anything else was sent once already, so its
    // answer is shown in place rather than asked for again.
    const plain = async (r, init) => \{
      if (!init.method) return location.assign(r.url);
      const pre = document.createElement("pre");
      pre.textContent = await r.text();
      document.body.replaceChildren(pre);
    };

    // A component's state belongs to the browser once the page has loaded.
    // The server's render replaces it only when the server's own state for it
    // has changed since it last sent one, so a page fetched for some other
    // reason leaves a counter where its clicks put it.
    const served = new WeakMap();
    const serve = (el) => \{
      const all = [...el.querySelectorAll("[data-component]")];
      if (el.matches && el.matches("[data-component]")) all.push(el);
      for (const c of all) served.set(c, c.dataset.state);
    };
    serve(document);

    const kept = (from, to) => from.dataset.component !== undefined &&
      from.dataset.component === to.dataset.component &&
      served.get(from) === to.dataset.state;

    const morph = (from, to) => \{
      if (from.nodeType !== to.nodeType || from.nodeName !== to.nodeName) \{
        const fresh = document.importNode(to, true);
        from.replaceWith(fresh);
        if (fresh.nodeType === Node.ELEMENT_NODE) serve(fresh);
      } else if (from.nodeType === Node.ELEMENT_NODE) \{
        if (kept(from, to)) return;
        attributes(from, to);
        children(from, to);
        field(from, to);
        if (to.dataset.component !== undefined) \{
          served.set(from, to.dataset.state);
        }
      } else if (from.nodeValue !== to.nodeValue) \{
        from.nodeValue = to.nodeValue;
      }
    };

    const attributes = (from, to) => \{
      for (const a of [...from.attributes]) \{
        if (!to.hasAttribute(a.name)) from.removeAttribute(a.name);
      }
      for (const a of [...to.attributes]) \{
        const same = from.getAttribute(a.name) === a.value;
        if (!same) from.setAttribute(a.name, a.value);
      }
    };

    const children = (from, to) => \{
      const had = [...from.childNodes];
      const wanted = [...to.childNodes];
      wanted.forEach((w, i) => \{
        if (i < had.length) morph(had[i], w);
        else from.appendChild(document.importNode(w, true));
      });
      had.slice(wanted.length).forEach((h) => h.remove());
    };

    // A field's value lives apart from its markup once someone has typed in
    // it, so it is set from the answer, unless it is the one with focus and
    // the answer is to some other request than its own form's.
    const field = (from, to) => \{
      const own = sent && sent.contains(from);
      if (from === document.activeElement && !own) return;
      if (from.localName === "input" || from.localName === "textarea") \{
        if (from.value !== to.value) from.value = to.value;
      }
    };

    const ours = (url) => url.origin === location.origin;

    addEventListener("click", (e) => \{
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = e.target.closest("a[href]");
      if (!a || a.target || a.hasAttribute("download")) return;
      const url = new URL(a.href);
      if (!ours(url)) return;
      if (url.hash && url.pathname === location.pathname) return;
      e.preventDefault();
      visit(url.href, \{}, true);
    });

    addEventListener("submit", (e) => \{
      const form = e.target;
      const url = new URL(form.action);
      if (e.defaultPrevented || !ours(url)) return;
      e.preventDefault();
      const fields = new FormData(form, e.submitter);
      const data = new URLSearchParams(fields);
      if (form.method === "get") \{
        url.search = data;
        visit(url.href, \{}, true, form);
      } else \{
        // A form that holds a file posts as multipart/form-data, as the
        // browser would post it; any other posts as a urlencoded form.
        const multipart = form.enctype === "multipart/form-data";
        const body = multipart ? fields : data;
        visit(url.href, \{ method: "POST", body }, true, form);
      }
    });

    addEventListener("popstate", () => visit(location.href, \{}, false));

    // The app's module. senro compiled the app's components, and its pages if
    // it asked, to one wasm module, which every page loads; an app without one
    // answers 404, and its pages go on without it. Once the module has loaded,
    // visits ask for pages as data. A component's template binds events to its
    // actions by name, and a click on a bound element runs the action in the
    // browser: the module takes the component's state and the action's name
    // and answers the next state and the component rendered in it, which is
    // morphed into the page. Until the module has loaded, elements marked
    // data-while-loading show and those marked data-when-loaded do not.
    const loading = document.createElement("style");
    loading.textContent = "html:not(.senro-ready) [data-when-loaded]," +
      "html.senro-ready [data-while-loading] \{ display: none }";
    document.head.appendChild(loading);

    let runtime = null;
    let app = null;

    // Both modules are kept in the browser's Cache Storage, each under its
    // own part of the version the server opened this script with, so a
    // returning visitor compiles them without asking for them. A deploy that
    // changes one module fetches that one and drops its older copy.
    const stored = async (path, mark) => \{
      const key = path + "?v=" + mark;
      let store = null;
      try \{
        if (typeof caches !== "undefined") store = await caches.open("senro");
      } catch (e) \{}
      const hit = store && await store.match(key);
      if (hit) return hit;
      const r = await fetch(path);
      if (!r.ok || !store) return r;
      await store.put(key, r.clone());
      for (const old of await store.keys()) \{
        const u = new URL(old.url);
        if (u.pathname === path && u.search !== "?v=" + mark) \{
          await store.delete(old);
        }
      }
      return r;
    };

    const [appMark, runtimeMark] = senroVersion.split("-");

    const ready = (async () => \{
      const own = await stored("/senro/app.wasm", appMark);
      if (!own.ok) return;
      const [r, a] = await Promise.all([
        WebAssembly.compileStreaming(stored("/senro/runtime.wasm", runtimeMark)),
        WebAssembly.compileStreaming(own),
      ]);
      runtime = r;
      app = a;
      document.documentElement.classList.add("senro-ready");
    })().catch(() => \{});

    {runner}
    const ran = (event, page) => module_run(runtime, app, event, page);

    // A component whose actions need the server posts its state there, and
    // the server answers the same way the module does. What the action
    // changed on the server may show elsewhere on the page too, so the page
    // then refreshes the rest of itself.
    const posted = async (root, action) => \{
      const r = await fetch("/senro/act/" + root.dataset.component, \{
        method: "POST",
        headers: \{ "senro-page": self },
        body: action + "\\n" + root.dataset.state,
      });
      if (stale(r)) return null;
      return r.ok ? r.text() : null;
    };

    // An action in the browser that reads what only the server holds
    // answers "?" and the calls it asks for. They go to the server in one
    // request, and the action runs again with every round of answers so
    // far, until it answers its next state.
    const supplied = async (event) => \{
      const rounds = [];
      for (let round = 0; round < 8; round++) \{
        const line = JSON.stringify(rounds);
        const answer = await ran([...event, line].join("\\n"));
        if (!answer.startsWith("?\\n")) return answer;
        const r = await fetch("/senro/data", \{
          method: "POST",
          headers: \{ "senro-page": self },
          body: answer.slice(2),
        });
        if (stale(r) || !r.ok) return null;
        rounds.push(await r.json());
      }
      return null;
    };

    const acted = async (root, action) => \{
      const server = root.dataset.runs === "server";
      if (!server) await ready;
      if (!server && !app) return;
      const event = [root.dataset.component, action, root.dataset.state];
      const answer = server
        ? await posted(root, action)
        : await supplied(event);
      if (answer === null) return;
      const html = answer.slice(answer.indexOf("\\n") + 1);
      const next = new DOMParser().parseFromString(html, "text/html");
      const drawn = next.body.firstElementChild;
      if (!drawn) return;
      attributes(root, drawn);
      children(root, drawn);
      if (server) refresh();
    };

    addEventListener("click", (e) => \{
      const bound = e.target.closest("[data-on-click]");
      const root = bound && bound.closest("[data-component]");
      if (!root) return;
      e.preventDefault();
      acted(root, bound.dataset.onClick);
    });

    // When a request anywhere changes what the app stores, the server says so
    // on this stream, and the page fetches itself again.
    const live = new EventSource("/senro/live");
    live.onmessage = (e) => \{
      if (e.data !== "changed " + self) refresh();
    };
  })();
"""
