import "../data"
import "../kata"
import "../models"
import "../names"
import "std/derive"
import "std/list"
import "std/text"

type route
  method
  path
  origin
  action
  id
  within
  to

type place
  method
  path

type clashes
  seen
  out

type aliases
  routes
  refused

type limits
  by
  refused

# senro's routing convention, run while an app compiles (#2186). A pub
# function in one of the app's modules is an action, and its module's name
# and its own name place it: `entries/index` answers GET /entries,
# `entries/create` POST /entries, `entries/show` GET /entries/:id, and
# `home/index` GET /. Any other pub function is refused where it is declared,
# so a misspelled action is a compile error and never a dead route.
#
# The table maps each route to its action and to what its `:id` segment
# takes: "int" when the action annotates `id` as an int, "any" when it takes
# any segment, and "" when the route has no `:id`.
#
# A module whose `show`, `edit`, `update` and `destroy` take no `id` is a
# singular resource, as Rails has them: `profile/show` answers GET /profile,
# with no `:id`, and such a module has no `index`.
#
# A module whose actions each take a parent's id first, as `post_id`, is
# nested under the parent: `comments/index req db post_id` answers GET
# /posts/:post_id/comments and `comments/show req db post_id id` GET
# /posts/:post_id/comments/:id. The table carries what the parent's id
# takes beside what `:id` takes. Nesting goes one level deep, the depth
# Rails' guides advise, since a comment's path needs its post and nothing
# above it. An action of a nested module that takes no parent id, or takes
# it after `id`, is refused.
#
# An app that must keep an old URL declares `legacy_route_aliases` in one of
# its modules, a map from an old path to the action now answering it:
# `{ "GET /signbook": "entries/index" }`. Each alias answers with a permanent
# redirect to its action's route, so every resource keeps one URL. An alias
# must name a route, take `:id` as its second segment exactly when its route
# does, and answer no request a route or another alias answers.
#
# A module that lets one client call an action only so often declares
# `rate_limits`, a map from the action's name to a count per a window, as
# Rails' `rate_limit` reads: `{ "create": "10 per 3 minutes" }`. The window
# is a number of seconds, minutes or hours, and "per minute" means one. A
# limit names an action of its own module and reads as a count per a window,
# or it is refused at the declaration. The table carries the count and the
# window in milliseconds beside the action. A call past the limit is answered
# 429 Too Many Requests, or by the module's `over_limit req` when it writes
# one, as Rails' `with:` does: the guestbook answers its sign-in page again,
# saying why.
#
# It also writes a `path_to` arm for each route, named by its action, and
# refuses a `path_to` whose route name is no route or whose ids do not
# match the route.
pub fn rest p
  apps = apps_of p
  laid = laid_out apps
  placed = laid.routes
  limited = list/fold apps (limits {} []) limits_in
  open = list/fold apps (limits {} []) opens_in
  asked = list/fold apps {} admitting_in
  secret = secret_of p
  carrying = (r -> put (row r limited open asked) "secret" secret)
  rows = list/fold placed {} (acc r -> put acc (spelled r) (carrying r))
  turned = list/concat limited.refused open.refused
  given = list/concat laid.refused turned
  calls = data/calls_of_program p
  odd = list/fold apps given (acc m -> list/concat acc (strays m calls))
  clashing = list/fold placed (clashes [] []) clashed
  declared = [(derive/declare "routes" "routes" rows)]
  arms = list/fold apps [] (acc m -> list/concat acc (arms_of m))
  links = list/fold apps [] (acc m -> list/concat acc (links_of m placed))
  pages = list/fold p.modules [] (acc m -> list/concat acc (paged m placed))
  told = list/concat (list/concat declared odd) clashing.out
  signed = unsigned (list/concat [p.modules[1]] apps) secret
  checked = list/concat (list/concat (list/concat told arms) links) pages
  list/concat checked signed

# The secret an app signs its sessions with: `secret` in its `session`
# module. Each row of the table carries it, which is how the server and a
# spec's visit find it (`web/request`); `web/serve` puts `SENRO_SECRET` there
# instead when the environment sets it.
fn secret_of p
  held = list/to_list (list/select p.modules (m -> m.name == "session"))
  return "" if length held == 0
  blank_if_none held[1].constants["secret"]

# An app that reads or keeps a session signs it, so it declares a secret.
fn unsigned scope ""
  calls = list/fold scope [] (acc m -> list/concat acc m.calls)
  found = list/select calls (c -> list/any? signing (n -> n == c.callee))
  list/to_list (list/map found (c -> derive/refuse_call c no_secret))

fn unsigned _ _
  []

signing = [
  "web/session"
  "web/viewer"
  "web/signed_in"
  "web/kept"
  "web/return_to"
  "web/requiring_sign_in"
]

no_secret = "an app that signs sessions declares `secret` in `session.kso`"

# The routes `rest` places, conventional and aliased.
pub fn routes_in p
  (laid_out (apps_of p)).routes

fn apps_of p
  list/to_list (list/select p.modules (m -> routed? m))

fn laid_out apps
  conventional = list/fold apps [] (acc m -> list/concat acc (routes_of m))
  start = aliases [] []
  aliased = list/fold apps start (acc m -> aliases_in acc m conventional)
  aliases (list/concat conventional aliased.routes) aliased.refused

# A module holding templates is the app's views or one of its components.
# A component's pub functions are its actions, which its template binds, and
# none of them is a route. A module whose name ends in `_mailer` makes the
# app's mail, as a Rails mailer does, and its pub functions are called by
# actions in other modules; none of them is a route either. Nor is the
# `perform` of a module whose name ends in `_job`, which a worker calls
# (`jobs/performers`).
fn routed? m
  aside = text/ends_with? m.name "_mailer" or text/ends_with? m.name "_job"
  not templated? m and not aside

fn templated? m
  list/any? (keys m.files) (f -> text/ends_with? f ".kata")

# How a page names a route: by its action, `path_to "posts/index"`, and with
# the ids its path takes, `path_to "posts/show" 3`, where the id fills `:id`.
pub fn path_to name:string
  filled name ""

pub fn path_to name:string id
  filled name "{id}"

fn filled name id
  parts = text/split name "/"
  return err "`{name}` names no route" if length parts != 2
  path_in (path_of parts[1] parts[2]) name id

fn path_in none name _
  err "`{name}` names no route"

fn path_in (place _ path) _ id
  names/id_filled path id

fn arms_of m
  named_arms m (nest_of m)

# A nested route named by a string is placed by an arm of its own, which takes
# the parent's id first: `path_to "comments/show" 3 4` is /posts/3/comments/4.
fn named_arms _ ""
  []

fn named_arms m nest
  one = singular? m
  acting = list/select m.functions (f -> path_of m.name f.name != none)
  arms = list/map acting (f -> named_arm m f (place_of m f one nest) nest)
  list/to_list (list/select arms (a -> a != none))

fn named_arm _ _ none _
  none

fn named_arm m f (place _ path) nest
  member = has_id? path
  params = with_id nest member
  parented = text/replace path ":{nest}" "\{{nest}}"
  body = text/replace parented ":id" "\{id}"
  name = "{m.name}/{f.name}"
  derive/define name "fn routes/path_to \"{name}\" {params}\n  \"{body}\"\n"

fn with_id params true
  "{params} id"

fn with_id params false
  params

# A `path_to` that names its route by a string is checked here, at the call:
# the name must be a route, and the route takes an id exactly when its path
# has `:id`.
fn links_of m placed
  links = list/select m.calls (c -> c.callee == "routes/path_to")
  list/fold links [] (acc c -> list/concat acc (named c c.strings[1] placed))

# A link a template writes is held to the table as a call to `path_to` is:
# its name must be a route and its ids the route's. kata spells the link by
# the convention the routes are placed by, so the browser can draw the page
# without the table, and the spelling must give the route's own path.
fn paged m placed
  pages = list/select (keys m.files) (f -> text/ends_with? f ".kata")
  each = (acc f -> list/concat acc (page_links m f m.files[f] placed))
  list/fold pages [] each

fn page_links _ _ none _
  []

fn page_links m f src placed
  origin = "{m.name}/{text/replace f ".kata" ""}"
  at = "{m.name}/{f}"
  each = (acc l -> list/concat acc (held_link origin at l placed))
  list/fold (kata/links src) [] each

fn held_link origin at l placed
  spelt = blank_if_none (names/link_path l.name l.exprs)
  return [] if spelt == ""
  ids = list/to_list (list/map l.exprs (e -> "\{{e}}"))
  why = unlinked l.name (length ids) placed
  where = "{at}:{l.line}"
  return [(derive/refuse origin "{where}: {why}")] if why != ""
  answered = path_with l.name ids placed
  return [] if answered == spelt
  [(derive/refuse origin "{where}: {unspelled l.name spelt answered}")]

fn unspelled name spelt answered
  told = "`{name}` is {answered}, and a page drawn in the browser would link"
  "{told} to {spelt}: name the parent's id as `<parent>_id`"

# A route is named by its name written whole, which is what the check
# reads.
fn named _ none _
  []

fn named c "" _
  [(derive/refuse_call c written_whole)]

fn named c name placed
  why = unlinked name (length c.arguments - 1) placed
  if (why == "") [] [(derive/refuse_call c why)]

# Why naming the route `name` with `given` ids links nowhere, or "" when it
# links to a route.
pub fn unlinked name given placed
  found = list/to_list (list/select placed (r -> r.origin == name))
  return "`{name}` names no route" if length found == 0
  r = found[1]
  return "" if ids_of r == given
  miscounted name r

# The path of the route `name` names with its ids written as `ids` spell
# them, the parent's first, for a route `unlinked` finds no fault with.
pub fn path_with name ids placed
  r = (list/to_list (list/select placed (r -> r.origin == name)))[1]
  parent = blank_if_none ids[1]
  own = blank_if_none ids[length ids]
  marker = blank_if_none (text/split r.path "/")[3]
  nested = if (r.within == "") r.path (text/replace r.path marker parent)
  if (r.id == "") nested (text/replace nested ":id" own)

# How many ids a route's path takes: its parent's, then its own.
fn ids_of r
  count r.within + count r.id

fn count ""
  0

fn count _
  1

written_whole = "name the route as written: path_to \"posts/show\" id"

fn miscounted name r
  third = blank_if_none (text/split r.path "/")[3]
  how name (text/replace third ":" "") r.within r.id

fn how name _ "" ""
  "`{name}` takes no id"

fn how name _ "" _
  "`{name}` takes an id: path_to \"{name}\" id"

fn how name parent _ ""
  "`{name}` takes its parent's id: path_to \"{name}\" {parent}"

fn how name parent _ _
  "`{name}` takes its parent's id and its own: path_to \"{name}\" {parent} id"

fn spelled r
  "{r.method} {r.path}"

fn row r limited open asked
  return { "action":r.action "id":r.id "to":r.to } if r.to != ""
  plain = { "action":r.action "id":r.id "name":r.origin }
  placed = nested_row plain r.within
  base = opened placed open.by[r.origin]
  admitted (bounded base limited.by[r.origin]) asked[module_of r.origin]

# A module that defines `admits action viewer db` says who may reach each of
# its actions, and every row of the module carries the function. An app that
# wraps its table in `web/requiring_sign_in` asks it before the action runs,
# and again for the page a provider's request names (`web/providers`).
fn admitting_in acc m
  found = list/to_list (list/select m.functions (f -> f.name == "admits"))
  return acc if length found == 0
  put acc m.name found[1].reference

fn admitted base none
  base

fn admitted base asking
  put base "admits" asking

# The module of `notes/index` is `notes`.
fn module_of origin
  parts = list/to_list (text/split origin "/")
  text/join (list/to_list (list/take parts (length parts - 1))) "/"

fn nested_row plain ""
  plain

fn nested_row plain within
  put plain "within" within

fn opened base none
  base

fn opened base _
  put base "open" true

# A module lists the actions anyone may reach, signed in or not, in
# `without_sign_in`, and the table marks them open. An app that wraps its
# table in `web/requiring_sign_in` sends a visitor who has not signed in from
# any other action to sign in. Each name must be an action of its module.
fn opens_in acc m
  opens_from acc m m.constants["without_sign_in"]

fn opens_from acc _ none
  acc

fn opens_from acc m given
  list/fold given acc (a name -> open_of a m name)

fn open_of acc m name
  origin = "{m.name}/without_sign_in"
  acts = list/any? m.functions (f -> acting? m f name)
  stray = "`{name}` is not an action of `{m.name}`"
  return limit_refused acc origin stray if not acts
  limits (put acc.by "{m.name}/{name}" true) acc.refused

fn bounded base none
  base

fn bounded base found
  put base "limit" found

fn limits_in acc m
  limits_from acc m m.constants["rate_limits"]

fn limits_from acc _ none
  acc

fn limits_from acc m given
  list/fold (entries given) acc (a e -> limit_of a m e.key e.value)

fn limit_of acc m name said
  origin = "{m.name}/rate_limits"
  acts = list/any? m.functions (f -> acting? m f name)
  stray = "`{name}` is not an action of `{m.name}`"
  return limit_refused acc origin stray if not acts
  words = text/split (widened said) " "
  shape = "`{said}` is not a count per a window, such as \"10 per 3 minutes\""
  return limit_refused acc origin shape if length words != 4
  return limit_refused acc origin shape if words[2] != "per"
  count = text/to_int words[1]
  span = text/to_int words[3]
  ms = unit_ms words[4]
  unread = count == none or span == none or ms == 0
  return limit_refused acc origin shape if unread
  return limit_refused acc origin shape if count < 1 or span < 1
  key = "{m.name}/{name}"
  limit = { "count":count "key":key "within":(span * ms) }
  over = list/to_list (list/select m.functions (f -> f.name == "over_limit"))
  return limits (put acc.by key limit) acc.refused if length over == 0
  turned = put limit "over" over[1].reference
  limits (put acc.by key turned) acc.refused

fn acting? m f name
  f.name == name and path_of m.name f.name != none

# "10 per minute" is a window of one.
fn widened said
  words = text/split said " "
  return said if length words != 3
  "{words[1]} {words[2]} 1 {words[3]}"

fn unit_ms "second"
  1000

fn unit_ms "seconds"
  1000

fn unit_ms "minute"
  60000

fn unit_ms "minutes"
  60000

fn unit_ms "hour"
  3600000

fn unit_ms "hours"
  3600000

fn unit_ms _
  0

fn limit_refused acc origin said
  limits acc.by (push acc.refused (derive/refuse origin said))

fn routes_of m
  one = singular? m
  nest = nest_of m
  each = (acc f -> routed acc m f nest (place_of m f one nest))
  list/fold m.functions [] each

fn place_of m f one nest
  return none if one and f.name == "index"
  under nest (placed_in (path_of m.name f.name) one)

# The parent a module's actions nest under: the parameter besides `id`, named
# `<parent>_id`, that its first action takes, or "" when it takes none.
fn nest_of m
  acting = list/select m.functions (f -> path_of m.name f.name != none)
  parent_of (list/first (list/to_list acting))

fn parent_of none
  ""

fn parent_of f
  parents = list/select f.params (p -> parent? p.name)
  name_or_blank (list/first (list/to_list parents))

fn parent? name
  name != "id" and text/ends_with? name "_id"

fn name_or_blank none
  ""

fn name_or_blank p
  p.name

fn under _ none
  none

fn under nest found
  return found if nest == ""
  beneath nest found

fn beneath nest (place method path)
  place method "/{names/parent_plural nest}/:{nest}{path}"

fn blank_if_none none
  ""

fn blank_if_none s
  s

# A singular resource's routes are its plural routes without `:id`.
fn placed_in none true
  none

fn placed_in (place method path) true
  place method (names/id_filled path "")

fn placed_in found false
  found

# The member actions decide: when none the module declares takes an `id`, the
# resource is singular.
fn singular? m
  members = list/to_list (list/select m.functions (f -> member? f.name))
  return false if length members == 0
  list/all? members (f -> not takes_id? f)

fn takes_id? f
  list/any? f.params (p -> p.name == "id")

fn member? "show"
  true

fn member? "edit"
  true

fn member? "update"
  true

fn member? "destroy"
  true

fn member? _
  false

fn routed acc _ _ _ none
  acc

fn routed acc m f nest (place method path)
  origin = "{m.name}/{f.name}"
  id = id_of path f.params
  within = within_of nest f.params
  push acc (route method path origin f.reference id within "")

fn within_of "" _
  ""

fn within_of nest params
  list/fold params "any" (acc p -> taken_as acc p nest)

fn taken_as acc p nest
  return acc if p.name != nest
  int_or_any p.annotation

fn id_of path params
  return "" if not list/any? (text/split path "/") (s -> s == ":id")
  list/fold params "any" (acc p -> taken acc p)

fn taken acc p
  return acc if p.name != "id"
  int_or_any p.annotation

fn int_or_any "int"
  "int"

fn int_or_any _
  "any"

fn path_of m a
  placed_at (names/action_path m a) a

fn placed_at none _
  none

fn placed_at path a
  place (names/action_method a) path

# A policy or a model's `problems` sits in its model's module beside the
# actions, and is no route. Nor is a provider the app calls from the browser,
# which the server answers at `/senro/data` (data/providers).
fn strays m calls
  unrouted = (f -> policy? f.name or data/provided? m f calls)
  acting = list/reject m.functions unrouted
  unplaced = list/select acting (f -> path_of m.name f.name == none)
  odd = list/to_list (list/map unplaced (f -> refused m f))
  formed = list/concat (list/concat odd (indexed m)) (mixed m)
  list/concat formed (unnested m (nest_of m))

fn policy? name
  modeled = ["create?" "update?" "destroy?" "visible?" "problems" "over_limit"]
  name == "admits" or list/any? modeled (p -> p == name)

# A singular resource has no `index`: there is one of it.
fn indexed m
  return [] if not singular? m
  found = list/to_list (list/select m.functions (f -> f.name == "index"))
  said = "`{m.name}` is a singular resource, so it has no `index`"
  list/to_list (list/map found (f -> derive/refuse "{m.name}/{f.name}" said))

# Member actions that disagree about taking an id leave the resource neither
# singular nor plural.
fn mixed m
  members = list/to_list (list/select m.functions (f -> member? f.name))
  bare = list/to_list (list/select members (f -> not takes_id? f))
  return [] if length bare == 0 or length bare == length members
  f = bare[1]
  bare = "`{m.name}/{f.name}` takes no id"
  others = "other actions in `{m.name}` do: give each one an id, or none"
  said = "{bare}, but {others}"
  [(derive/refuse "{m.name}/{f.name}" said)]

# Each action of a nested module takes the parent's id, and first, since the
# server hands it over in that place.
fn unnested _ ""
  []

fn unnested m nest
  acting = list/select m.functions (f -> path_of m.name f.name != none)
  odd = list/select acting (f -> not nested_first? f nest)
  list/to_list (list/map odd (f -> unnested_said m f nest))

fn nested_first? f nest
  given = list/to_list (list/drop f.params 2)
  given != [] and given[1].name == nest

fn unnested_said m f nest
  first = "`{m.name}` nests under `{names/parent_plural nest}`"
  rule = "so each of its actions takes `{nest}` after the request and database"
  derive/refuse "{m.name}/{f.name}" "{first}, {rule}"

# Each entry of a module's `legacy_route_aliases` becomes a route that
# redirects, or a refusal at the declaration.
fn aliases_in acc m placed
  aliases_from acc m m.constants["legacy_route_aliases"] placed

fn aliases_from acc _ none _
  acc

fn aliases_from acc m given placed
  list/fold (entries given) acc (a e -> alias_of a m e.key e.value placed)

fn alias_of acc m key target placed
  origin = "{m.name}/legacy_route_aliases"
  words = text/split key " "
  unsplit = "`{key}` is not a method and a path"
  return refusal acc origin unsplit if length words != 2
  found = list/to_list (list/select placed (r -> r.origin == target))
  nowhere = "`{key}` points at `{target}`, which names no route"
  return refusal acc origin nowhere if length found == 0
  r = found[1]
  method = words[1]
  path = words[2]
  deep = "`{target}` is nested, and an alias reaches only a route that is not"
  return refusal acc origin deep if r.within != ""
  other = "`{key}` is a {method}, but `{target}` answers {r.method}"
  return refusal acc origin other if method != r.method
  shaped acc origin key path r (has_id? path) (r.id != "")

fn shaped acc origin key path r true true
  misplaced = "`{key}` must take `:id` as its second segment"
  return refusal acc origin misplaced if not second_id? path
  kept acc path origin r

fn shaped acc origin _ path r false false
  kept acc path origin r

fn shaped acc origin key _ r false true
  refusal acc origin "`{key}` has no `:id`, but `{r.origin}` takes one"

fn shaped acc origin key _ r true false
  refusal acc origin "`{key}` has an `:id`, but `{r.origin}` takes none"

fn has_id? path
  list/any? (text/split path "/") (s -> s == ":id")

fn second_id? path
  segments = text/split path "/"
  segments[3] == ":id"

fn kept acc path origin r
  alias = route r.method path origin r.action r.id "" r.path
  aliases (push acc.routes alias) acc.refused

fn refusal acc origin said
  aliases acc.routes (push acc.refused (derive/refuse origin said))

fn refused m f
  actions = "index, new, create, show, edit, update or destroy"
  said = "`{f.name}` is not an action: name it {actions}"
  derive/refuse "{m.name}/{f.name}" said

# Two routes clash when one request could reach both: the same method, as
# many segments, and each pair of segments able to match one string. A literal
# and `:id` can, unless the action annotates `id` as an int and the literal is
# not a number. The later of the two is refused, naming the earlier.
fn clashed acc r
  hit = list/select acc.seen (s -> overlap? s r)
  out = list/concat acc.out (list/to_list (list/map hit (s -> clash s r)))
  clashes (push acc.seen r) out

fn clash s r
  said = "`{spelled r}` and `{spelled s}` ({s.origin}) answer the same request"
  derive/refuse r.origin "{said}{advice s r}"

fn advice s r
  return "" if s.id == "" and r.id == ""
  ": annotate `id` as `int` so a word is not taken for an id"

fn overlap? s r
  return false if s.method != r.method
  sa = text/split s.path "/"
  sb = text/split r.path "/"
  return false if length sa != length sb
  meet? sa sb 1 s.id r.id

fn meet? sa sb i ix iy
  return true if i > length sa
  return false if not meets? sa[i] sb[i] ix iy
  meet? sa sb (i + 1) ix iy

fn meets? none none _ _
  false

fn meets? none _ _ _
  false

fn meets? _ none _ _
  false

fn meets? x y ix iy
  return true if x == y
  across? x y ix iy

fn across? ":id" ":id" _ _
  true

fn across? ":id" y ix _
  number_or_any? y ix

fn across? x ":id" _ iy
  number_or_any? x iy

fn across? _ _ _ _
  false

