import "../../../models"
import "../../../pg"
import "./migrations"
import "std/io"
import "std/os"

derive models/tables

# The live tables disagree with the migrations every way the comparison
# reads: `body` is an int, `seen` refuses a null, `title` is missing, `extra`
# is a column no migration makes, and `tags` was never made.
live = """
  drop schema if exists senro_spec cascade;
  create schema senro_spec;
  set search_path to senro_spec;
  create table notes (id serial, body int not null, seen bool not null, extra text)
"""

# The app says why it will not start and exits 1, the way an app's own
# start-up would, so the golden holds the differences and not the line in
# senro's library where the err was made.
pg/connect "127.0.0.1" 54329 "postgres" "postgres" ""
  .> (db -> pg/run db live .> (_ -> models/compared db schema))
  .> (_ -> print "the database agrees")
  .? (u -> io/write_err "{u.reason}\n" .> (_ -> os/exit 1))
