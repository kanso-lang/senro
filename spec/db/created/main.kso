import "../../../models"
import "../../../pg"
import "./migrations"
import "./notes"
import "./writing"

derive models/tables

# Notes written through the model: one that is fine, one with no body, one
# too long, one by a visitor signed in as nobody, one claiming another's
# name, and one that names an id of its own, which Postgres overrides. Then
# Ada empties her note, which its rule refuses, and edits it.
fresh = """
  drop schema if exists senro_spec cascade;
  create schema senro_spec;
  set search_path to senro_spec
"""

made = models/made schema

fine = { "body":"first" "owner":"ada" }
blank = { "body":"  " "owner":"ada" }
long = { "body":"a note far too long to keep" "owner":"ada" }
nobody = { "body":"anonymous" "owner":"" }
forged = { "body":"forged" "owner":"ada" }
numbered = { "body":"mine" "id":"77" "owner":"bob" }
emptied = { "body":"" }
edited = { "body":"edited" }

pg/connect "127.0.0.1" 54329 "postgres" "postgres" ""
  .> (db -> pg/run db fresh .> (_ -> pg/run db made) .> (_ -> db))
  .> (db -> writing/tried "ada" db fine)
  .> (db -> writing/tried "ada" db blank)
  .> (db -> writing/tried "ada" db long)
  .> (db -> writing/tried "" db nobody)
  .> (db -> writing/tried "bob" db forged)
  .> (db -> writing/tried "bob" db numbered)
  .> (db -> writing/changed "ada" db 1 emptied)
  .> (db -> writing/changed "ada" db 1 edited)
