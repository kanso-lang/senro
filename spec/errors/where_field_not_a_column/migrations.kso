import "../../../models"

pub all = [comments]

comments = models/create_table "comments" [id post_id body author]

id = models/column "id" "serial"

title = models/column "title" "text not null"

post_id = models/column "post_id" "integer not null"

body = models/column "body" "text not null"

author = models/column "author" "text not null"
