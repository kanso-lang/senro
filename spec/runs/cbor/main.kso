import "../../../cbor"
import "./shown"
import "std/list"
import "std/text"

# RFC 8949 appendix A's examples that WebAuthn's subset covers, then input
# the reader refuses: a truncated string, a map with a key twice, bytes left
# over, an indefinite length, a tag, a float and an integer past 63 bits.
cases = [
  [0]
  [23]
  [24 24]
  [25 3 232]
  [26 0 15 66 64]
  [27 0 0 0 232 212 165 16 0]
  [32]
  [56 99]
  [57 3 231]
  [244]
  [245]
  [246]
  [64]
  [68 1 2 3 4]
  [96]
  [97 97]
  [100 73 69 84 70]
  [98 195 188]
  [128]
  [131 1 2 3]
  [131 1 130 2 3 130 4 5]
  [160]
  [162 1 2 3 4]
  [162 97 97 1 97 98 130 2 3]
  [165 1 38 3 39 32 1 33 88 2 171 205 34 66 239 1]
  [68 1 2 3]
  [162 1 2 1 3]
  [1 2]
  [95 65 1 255]
  [193 0]
  [249 60 0]
  [27 128 0 0 0 0 0 0 0]
  [130 1]
]

lines = list/to_list (list/map cases (c -> shown/shown (cbor/decoded c)))
print (text/join lines "\n")
