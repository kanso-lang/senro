import "../../../models"
import "./migrations"
import "./note"
import "./tag"
import "std/list"

derive models/tables

# The dump's foreign key writes a reader each way, so both names resolve.
tags_of_a_note = &tag/of_note

note_of_a_tag = &note/of_tag

print "{schema["notes"]}"
print "{schema["tags"]}"

print (list/to_list (list/map [tags_of_a_note note_of_a_tag] (_ -> "written")))

# The dump's unique index and unique constraint each name a table's unique
# column. The index over two columns names none.
print "{note/note_model["unique"]} {tag/tag_model["unique"]}"
