import "std/list"
import "std/net/http"
import "std/text"

# A request as the server hands one to an action: the request as parsed, and
# the secret the app signs its sessions with.
type request
  method
  path
  body
  headers
  secret

pub fn carrying r secret
  request r.method r.path r.body r.headers secret

# A request carrying `v` as its senro cookie, beside one the app did not set.
pub fn asked v secret
  raw = "GET / HTTP/1.1\r\ncookie: theme=dark; senro={v}\r\n\r\n"
  carrying (http/parsed raw) secret

# The senro cookie's value in a rendered response, as a browser would keep it.
pub fn sealed_from rendered
  after = text/split rendered "senro="
  return "" if length after < 2
  rest = text/split after[2] ";"
  return "" if length rest < 1
  rest[1]

# The same signature over a different map: {"name":"eve"}.
pub fn forged sealed
  parts = text/split sealed "."
  return "" if length parts < 2
  "eyJuYW1lIjoiZXZlIn0=.{parts[2]}"

# The same, as the server hands it on, stamped with the time it arrived.
pub fn asked_at v t secret
  raw = "GET / HTTP/1.1\r\ncookie: senro={v}\r\nsenro-at: {t}\r\n\r\n"
  carrying (http/parsed raw) secret

# What the senro cookie in a rendered response says after its value: its
# path, flags and, when it outlives the browser, its age.
pub fn attributes_of rendered
  after = text/split rendered "senro="
  return "" if length after < 2
  lines = text/split after[2] "\r\n"
  return "" if length lines < 1
  parts = list/to_list (list/drop (text/split lines[1] "; ") 1)
  text/join parts "; "
