import "std/net/http"
import "std/text"

# A request carrying `v` as its senro cookie, beside one the app did not set.
pub fn asked v
  http/parsed "GET / HTTP/1.1\r\ncookie: theme=dark; senro={v}\r\n\r\n"

# The senro cookie's value in a rendered response, as a browser would keep it.
pub fn sealed_from rendered
  after = text/split rendered "senro="
  return "" if length after < 2
  rest = text/split after[2] ";"
  return "" if length rest < 1
  rest[1]

# The same signature over a different map: {"name":"eve"}.
pub fn forged sealed
  parts = text/split sealed "."
  return "" if length parts < 2
  "eyJuYW1lIjoiZXZlIn0=.{parts[2]}"

# The same, as the server hands it on, stamped with the time it arrived.
pub fn asked_at v t
  raw = "GET / HTTP/1.1\r\ncookie: senro={v}\r\nsenro-at: {t}\r\n\r\n"
  http/parsed raw
