import "../../../objects"

# The example AWS publishes for a presigned GET: `test.txt` in
# `examplebucket`, signed at midnight on 24 May 2013 for a day with the
# documentation's example key. AWS gives the signature as
# aeeed9bbccd4d02ee5c0109b86d86835f995330da4c265957d157751f604d404.
example = objects/signed_url
  "AKIAIOSFODNN7EXAMPLE"
  "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  "us-east-1"
  "examplebucket.s3.amazonaws.com"
  "/test.txt"
  "GET"
  "20130524T000000Z"
  86400

# The same request of an R2 bucket, which names the bucket in the path and
# takes `auto` for its region, for a key with characters that are encoded.
r2 = objects/store "https://acct.r2.cloudflarestorage.com" "auto" "tunes" "id" "secret"

print example
print (objects/presigned r2 "PUT" "songs/a b+c.mp3" "20261126T120000Z" 300)
