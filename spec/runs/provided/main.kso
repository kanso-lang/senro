import "../../../web"
import "./stock"
import "std/json"

# The server answers every call of a round in one reply, in the order asked,
# and none when a call names a provider the app does not have.
table = { "orders/recent":stock/recent "stock/low":stock/low }
calls = [["stock/low" [3]] ["orders/recent" [2]]]
web/answers table calls "ada" "no database" .> (a -> print (json/encode a))
  .> (_ -> web/answers table [["nowhere" []]] "ada" "no database")
  .> (a -> print "an unknown provider answers {a}")
