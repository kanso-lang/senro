takes posts notice marks
if notice != ""
  p.notice = notice
ul
  each posts p ->
    li id="post-{p.id}"
      h2 = p.title
      if p.author != ""
        p.by by {p.author}
      == marks["{p.id}"]
      if p.draft
        em draft
      ul.tags
        each p.tags t ->
          li = t
p.count {length posts} posts
