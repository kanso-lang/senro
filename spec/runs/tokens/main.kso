import "../../../tokens"
import "./keyed"

# A token is good for the purpose, secret, record and bound value it was made
# for, until its expiry, and for nothing else: a reset token does not confirm
# an address, and a confirmation bound to an address stops working when the
# address changes.
made = 1793000000000

ana = "ana@example.com"

key = keyed/under "a secret"

other = keyed/under "another"

token = tokens/made "confirm" key 4 ana made 1440

day = 86400000

late = made + day + 1

print token
  .> (_ -> print "{tokens/id_of token}")
  .> (_ -> print (tokens/valid? "confirm" key token ana made))
  .> (_ -> print (tokens/valid? "reset" key token ana made))
  .> (_ -> print (tokens/valid? "confirm" other token ana made))
  .> (_ -> print (tokens/valid? "confirm" key token "ana@x.org" made))
  .> (_ -> print (tokens/valid? "confirm" key token ana (made + day)))
  .> (_ -> print (tokens/valid? "confirm" key token ana late))
