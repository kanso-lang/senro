import "../../../kata"
import "./views"

derive kata/views

# One value for each character the escape rewrites, one with none of them and
# one with all five.
marked = ["a&b" "a<b" "a>b" "a\"b" "a'b" "plain" "&<>\"'&"]

print (views/page "Shelf" (views/shelf ["Dune" "Emma"] "<all>"))
print (views/shelf [] "")
print (views/shelf ["Dune"] "")
print (views/shelf marked "five")
print (views/a_long_named_form { "a_field_whose_name_runs_long":"Too short." })
print (views/a_long_named_form { "another_field_with_a_long_name":"Wrong." })
print (views/a_long_named_form {})
