import "../../../kata"
import "./posts"
import "./views"
import "std/list"
import "std/text"

derive kata/views

# A template reads a field of the record a post holds: `p.author.name`. The
# page as data keeps that field of the author and leaves out the email no
# page reads, and the page drawn from its bytes is the same markup.
page = views/list_view posts/all
bytes = views/packed page
held = text/join (list/to_list (list/map bytes text/from_code)) ""
name = length (text/split held "Ada") > 1
email = length (text/split held "ada@example.com") > 1

print (views/list posts/all)
print "the page's bytes hold the name: {name}; the email: {email}"
print (views/rendered bytes)
