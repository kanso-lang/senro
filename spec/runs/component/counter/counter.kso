import "std/text"

# A count that steps up and down, or is set from what a field or a library
# reports. Each action takes the state and answers the next one; `set` also
# takes the event's value, by naming it.
pub fn increment count
  count + 1

pub fn decrement count
  count - 1

pub fn set value _
  counted (text/to_int value)

fn counted none
  0

fn counted n
  n
