  ]

fn signed_27 removals e
  joined [
    # signed.kata:29
    "<li><p class=\"message\">{escape e.message}</p>"
    # signed.kata:30, 32
    "{if (e.photo != "") (signed_30 e) ""}<p class=\"who\">{escape e.name}"
    # signed.kata:33
    "</p>{removals["{e.id}"]}</li>"
  ]

pub fn signed signatures form flash removals viewer
  joined [
    "<header><h1>Guestbook</h1><p class=\"lede\">Leave a line for whoever "
    # signed.kata:5
    "comes next.</p></header>{if (viewer == "") signed_5 (signed_9 viewer)}"
    # signed.kata:15
    "{if (flash != "") (signed_15 flash) ""}"
    # signed.kata:17
    "{if (viewer != "") (signed_17 form) ""}<ol class=\"entries\">"
    # signed.kata:27
    "{each signatures (e -> signed_27 removals e)}</ol>"
  ]
