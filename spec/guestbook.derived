# from door.kata:1
pub fn door heading path button name email problems asks remembers
  joined [
    # from door.kata:3
    "<header><h1>{escape heading}</h1><p class=\"lede\"><a href=\"/\">Back "
    # from door.kata:6
    "to the book</a></p></header><form method=\"post\" action=\"{escape path}"
    "\"><input name=\"name\" placeholder=\"name\" required=\"required\" "
    # from door.kata:7
    "value=\"{escape name}\">"
    # from door.kata:8
    "{if (problems["name"] != none) (door_8 problems) ""}"
    # from door.kata:10
    "{if asks (door_10 email problems) ""}<input type=\"password\" "
    "name=\"password\" placeholder=\"password\" required=\"required\">"
    # from door.kata:15
    "{if (problems["password"] != none) (door_15 problems) ""}"
    # from door.kata:17
    "{if remembers door_17 ""}<button>"
    # from door.kata:21
    "{escape button}</button></form>"
    # from door.kata:22
    "{if remembers door_22 ""}"
  ]
