# in views, by kata/views
fn signed_view_signatures_each x
  { "id":x.id "message":x.message "name":x.name "photo":x.photo }

fn signed_view_signatures xs
  list/to_list (list/map xs signed_view_signatures_each)

fn signed_view_form x
  { "message":x.message "problems":x.problems }

pub fn signed_view signatures form flash removals viewer
  kata_locals = {
    "flash":flash
    "form":(signed_view_form form)
    "removals":removals
    "signatures":(signed_view_signatures signatures)
    "viewer":viewer
  }
  { "locals":kata_locals "view":"signed" }
# in views, by kata/views
pub fn unlock_offered_view path
  kata_locals = { "path":path }
  { "locals":kata_locals "view":"unlock_offered" }
# in views, by kata/views
pub fn answer req node
  answer_as req 200 node

pub fn answer_as req code node
  kata_answered req.headers["senro-view"] code node

fn kata_answered none code node
  page = ["content-type: text/html; charset=utf-8"]
  http/respond code page (rendered node)

fn kata_answered _ code node
  heard = [
    "cache-control: no-store"
    "content-type: application/json"
    "senro-view: 1"
  ]
  http/respond code heard (json/encode node)
schema = { "accounts":["id serial" "name text" "digest text" "email text" "confirmed text" "failures integer not null default 0" "locked text not null default ''" "sign_in_count integer not null default 0" "current_sign_in_at text not null default ''" "last_sign_in_at text not null default ''" "current_sign_in_ip text not null default ''" "last_sign_in_ip text not null default ''"] "signatures":["id serial" "name text" "message text" "photo text not null default ''"] }    # models/tables
# in signatures, by models/tables
pub type signature
  id
