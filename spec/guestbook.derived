# in views, by kata/views
pub fn rendered node
  kata_shown (kata_at node "view") (kata_at node "locals")

fn kata_shown "account" kata_l
  path = kata_at kata_l "path"
  problems = kata_at kata_l "problems"
  seen = kata_at kata_l "seen"
  account_keyed path problems seen

fn kata_shown "confirm_offered" kata_l
  path = kata_at kata_l "path"
  email = kata_at kata_l "email"
  confirm_offered_keyed path email

fn kata_shown "door" kata_l
  heading = kata_at kata_l "heading"
  path = kata_at kata_l "path"
  button = kata_at kata_l "button"
  name = kata_at kata_l "name"
  email = kata_at kata_l "email"
  problems = kata_at kata_l "problems"
  asks = kata_at kata_l "asks"
  remembers = kata_at kata_l "remembers"
  door_keyed heading path button name email problems asks remembers

fn kata_shown "layout" kata_l
  title = kata_at kata_l "title"
  body = kata_at kata_l "body"
  layout_keyed title body

fn kata_shown "reset_asked" kata_l
  flash = kata_at kata_l "flash"
  problems = kata_at kata_l "problems"
  reset_asked_keyed flash problems

fn kata_shown "reset_chosen" kata_l
  path = kata_at kata_l "path"
  problems = kata_at kata_l "problems"
  reset_chosen_keyed path problems

fn kata_shown "signed" kata_l
  signatures = kata_at kata_l "signatures"
  form = kata_at kata_l "form"
  flash = kata_at kata_l "flash"
  removals = kata_at kata_l "removals"
  viewer = kata_at kata_l "viewer"
  signed_keyed signatures form flash removals viewer

fn kata_shown "unlock_offered" kata_l
  path = kata_at kata_l "path"
  unlock_offered_keyed path

fn kata_shown _ _
  ""
# in views, by kata/views
pub fn account_view path problems seen
  kata_locals = { "path":path "problems":problems "seen":seen }
  { "locals":kata_locals "view":"account" }
# in views, by kata/views
pub fn confirm_offered_view path email
  kata_locals = { "email":email "path":path }
  { "locals":kata_locals "view":"confirm_offered" }
# in views, by kata/views
pub fn door_view heading path button name email problems asks remembers
  kata_locals = {
    "asks":asks
    "button":button
    "email":email
    "heading":heading
    "name":name
    "path":path
    "problems":problems
    "remembers":remembers
  }
  { "locals":kata_locals "view":"door" }
# in views, by kata/views
pub fn layout_view title body
  kata_locals = { "body":body "title":title }
  { "locals":kata_locals "view":"layout" }
# in views, by kata/views
pub fn reset_asked_view flash problems
  kata_locals = { "flash":flash "problems":problems }
  { "locals":kata_locals "view":"reset_asked" }
# in views, by kata/views
pub fn reset_chosen_view path problems
  kata_locals = { "path":path "problems":problems }
