# in removal, by kata/views
import "std/json"
import "std/list"
import "std/text"

fn escape none
  ""

fn escape x
  s = "{x}"
  amp = text/join (text/split s "&") "&amp;"
  lt = text/join (text/split amp "<") "&lt;"
  gt = text/join (text/split lt ">") "&gt;"
  quot = text/join (text/split gt "\"") "&quot;"
  text/join (text/split quot "'") "&#39;"

fn each xs f
  text/join (list/to_list (list/map xs f)) ""

fn joined parts
  text/join parts ""
# in removal, by kata/views
pub fn view_body id
  joined [
    # view.kata:2
    "<button data-on-click=\"removed\" aria-label=\"remove entry {escape id}"
    "\" class=\"remove\">×</button>"
  ]

pub fn view id
  kata_state = escape (json/encode id)
  kata_inside = view_body id
  kata_open = "<div data-component=\"removal\" data-runs=\"server\""
  "{kata_open} data-state=\"{kata_state}\">{kata_inside}</div>"
# in removal, by kata/views
pub fn act "removed" kata_given state
  removed kata_given.viewer kata_given.db state

pub fn act _ _ _
  none
# in views, by kata/views
import "std/json"
import "std/list"
import "std/net/http"
import "std/text"

fn escape none
  ""

fn escape x
  s = "{x}"
  amp = text/join (text/split s "&") "&amp;"
  lt = text/join (text/split amp "<") "&lt;"
  gt = text/join (text/split lt ">") "&gt;"
  quot = text/join (text/split gt "\"") "&quot;"
  text/join (text/split quot "'") "&#39;"

fn each xs f
  text/join (list/to_list (list/map xs f)) ""

fn joined parts
  text/join parts ""

fn kata_at none _
  ""

fn kata_at m k
  kata_present m[k]

fn kata_present none
  ""

fn kata_present v
  v

fn kata_items xs:[]some
  xs

fn kata_items _
  []

fn kata_raw none
  "<none>"

fn kata_raw node:map[string some]
  rendered node

fn kata_raw x
  "{x}"
# in views, by kata/views
fn account_6 seen
  # account.kata:7
  "<p class=\"seen\">{escape seen}</p>"

fn account_11 problems
  # account.kata:12
  "<p class=\"problem\">{escape problems["current"]}</p>"

fn account_14 problems
  # account.kata:15
  "<p class=\"problem\">{escape problems["password"]}</p>"

pub fn account path problems seen
  joined [
    "<header><h1>Your account</h1><p class=\"lede\"><a href=\"/\">Back to "
    # account.kata:6
    "the book</a></p></header>{if (seen != "") (account_6 seen) ""}<form "
    # account.kata:8
    "method=\"post\" action=\"{escape path}\"><input type=\"hidden\" "
    "name=\"_method\" value=\"PATCH\"><input type=\"password\" "
    "name=\"current\" placeholder=\"current password\" required=\"required\">"
    # account.kata:11
    "{if (problems["current"] != none) (account_11 problems) ""}<input "
    "type=\"password\" name=\"password\" placeholder=\"new password\" "
    "required=\"required\">"
    # account.kata:14
    "{if (problems["password"] != none) (account_14 problems) ""}<button>"
    "Change it</button></form>"
  ]
# in views, by kata/views
pub fn confirm_offered path email
  joined [
    "<header><h1>Confirm your address</h1></header><form method=\"post\" "
    # confirm_offered.kata:4
    "action=\"{escape path}\"><input type=\"hidden\" name=\"_method\" "
    # confirm_offered.kata:6
    "value=\"PATCH\"><p class=\"lede\">{escape email}</p><button>Confirm "
    "it</button></form>"
  ]
# in views, by kata/views
fn door_8 problems
  # door.kata:9
  "<p class=\"problem\">{escape problems["name"]}</p>"

fn door_12 problems
  # door.kata:13
  "<p class=\"problem\">{escape problems["email"]}</p>"

fn door_10 email problems
  joined [
    "<input type=\"email\" name=\"email\" placeholder=\"email, for a lost "
    # door.kata:11
    "password\" required=\"required\" value=\"{escape email}\">"
    # door.kata:12
    "{if (problems["email"] != none) (door_12 problems) ""}"
  ]

fn door_15 problems
  # door.kata:16
  "<p class=\"problem\">{escape problems["password"]}</p>"

door_17 = joined [
  "<label class=\"remember\"><input type=\"checkbox\" name=\"remember\" "
  "value=\"yes\">Keep me signed in</label>"
]

door_22 = joined [
  "<p class=\"forgot\"><a href=\"/resets/new\">Forgot your password?</a>"
  "</p>"
]

pub fn door heading path button name email problems asks remembers
  joined [
    # door.kata:3
    "<header><h1>{escape heading}</h1><p class=\"lede\"><a href=\"/\">Back "
    # door.kata:6
    "to the book</a></p></header><form method=\"post\" action=\"{escape path}"
    "\"><input name=\"name\" placeholder=\"name\" required=\"required\" "
    # door.kata:7
    "value=\"{escape name}\">"
    # door.kata:8
    "{if (problems["name"] != none) (door_8 problems) ""}"
    # door.kata:10
    "{if asks (door_10 email problems) ""}<input type=\"password\" "
    "name=\"password\" placeholder=\"password\" required=\"required\">"
    # door.kata:15
    "{if (problems["password"] != none) (door_15 problems) ""}"
    # door.kata:17, 21
    "{if remembers door_17 ""}<button>{escape button}</button></form>"
    # door.kata:22
    "{if remembers door_22 ""}"
  ]
# in views, by kata/views
pub fn layout title body
  joined [
    "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta "
    "name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    # layout.kata:7
    "<title>{escape title}</title><link rel=\"stylesheet\" "
    "href=\"/site.css\"><script src=\"/senro.js\" defer=\"defer\"></script>"
    # layout.kata:12
    "</head><body><main>{body}</main></body></html>"
  ]
