# in views, by kata/views
fn account_pack acc h
  a1 = wire/add (wire/add_count acc 1) h.path
  a2 = wire/add a1 h.problems
  wire/add a2 h.seen

fn account_drawn h
  account h.path h.problems h.seen

pub fn account_view path problems seen
  kata_held = account_page path problems seen
  wire/paged kata_held account_pack account_drawn
# in views, by kata/views
fn confirm_offered_pack acc h
  a1 = wire/add (wire/add_count acc 2) h.path
  wire/add a1 h.email

fn confirm_offered_drawn h
  confirm_offered h.path h.email

pub fn confirm_offered_view path email
  kata_held = confirm_offered_page path email
  wire/paged kata_held confirm_offered_pack confirm_offered_drawn
# in views, by kata/views
fn door_pack acc h
  a1 = wire/add (wire/add_count acc 3) h.heading
  a2 = wire/add a1 h.path
  a3 = wire/add a2 h.button
  a4 = wire/add a3 h.name
  a5 = wire/add a4 h.email
  a6 = wire/add a5 h.problems
  a7 = wire/add a6 h.asks
  wire/add a7 h.remembers

fn door_drawn h
  door h.heading h.path h.button h.name h.email h.problems h.asks h.remembers

pub fn door_view heading path button name email problems asks remembers
  kata_held = door_page heading path button name email problems asks remembers
  wire/paged kata_held door_pack door_drawn
