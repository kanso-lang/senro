# in views, by kata/views
fn signed_pack_signatures_each acc x
  # from signed.kata:33
  a1 = wire/add acc x.id
  # from signed.kata:29
  a2 = wire/add a1 x.message
  # from signed.kata:31
  a3 = wire/add a2 x.name
  # from signed.kata:31
  wire/add a3 x.photo

fn signed_pack_signatures acc xs
  counted = wire/add_count acc (length xs)
  list/fold xs counted signed_pack_signatures_each

fn signed_pack_form acc x
  # from signed.kata:19
  a1 = wire/add acc x.message
  # from signed.kata:21
  wire/add a1 x.problems

fn signed_pack acc h
  a1 = signed_pack_signatures (wire/add_count acc 7) h.signatures
  a2 = signed_pack_form a1 h.form
  a3 = wire/add a2 h.flash
  a4 = wire/add a3 h.removals
  wire/add a4 h.viewer

fn signed_drawn h
  signed h.signatures h.form h.flash h.removals h.viewer

pub fn signed_view signatures form flash removals viewer
  kata_held = signed_page signatures form flash removals viewer
  wire/paged kata_held signed_pack signed_drawn
# in views, by kata/views
fn unlock_offered_pack acc h
  wire/add (wire/add_count acc 8) h.path

fn unlock_offered_drawn h
  unlock_offered h.path

pub fn unlock_offered_view path
  kata_held = unlock_offered_page path
  wire/paged kata_held unlock_offered_pack unlock_offered_drawn
# in views, by kata/views
pub fn packed page
  wire/written (text/to_bytes kata_marks) page
# in views, by kata/views
pub fn answer req page
  answer_as req 200 page

pub fn answer_as req code page
  kata_answered req.headers["senro-view"] code page

fn kata_answered none code page
  html = ["content-type: text/html; charset=utf-8"]
  http/respond code html (wire/drawn page)

fn kata_answered _ code page
  heard = [
    "cache-control: no-store"
    "content-type: application/octet-stream"
    "senro-view: 1"
  ]
  http/respond code heard (packed page)
