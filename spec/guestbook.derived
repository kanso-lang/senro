# in views, by kata/views
signed_k_5 = joined [
  "<nav class=\"door\"><a href=\"/session/new\">Sign in</a><a "
  "href=\"/accounts/new\">Make an account</a></nav>"
]

fn signed_k_9 viewer
  joined [
    "<form method=\"post\" action=\"/session\" class=\"out\"><input "
    "type=\"hidden\" name=\"_method\" value=\"DELETE\"><span>Signed in as "
    # signed.kata:12
    "{escape viewer}.</span><button>Sign out</button></form>"
  ]

fn signed_k_14 flash
  # signed.kata:15
  "<p class=\"flash\">{escape flash}</p>"

fn signed_k_19 form
  # signed.kata:20
  "<p class=\"problem\">{escape (kata_at form "problems")["message"]}</p>"

fn signed_k_16 form
  joined [
    "<form method=\"post\" action=\"/entries\" class=\"sign\"><textarea "
    "name=\"message\" placeholder=\"say something\" required=\"required\">"
    # signed.kata:18
    "{escape (kata_at form "message")}</textarea>"
    # signed.kata:19
    "{if ((kata_at form "problems")["message"] != none) (signed_k_19 form) ""}"
    "<button>Sign</button></form>"
  ]

fn signed_k_23 removals e
  joined [
    # signed.kata:25
    "<li><p class=\"message\">{escape (kata_at e "message")}</p><p "
    # signed.kata:26
    "class=\"who\">{escape (kata_at e "name")}</p>"
    # signed.kata:27
    "{kata_raw removals["{kata_at e "id"}"]}</li>"
  ]

fn signed_keyed signatures form flash removals viewer
  joined [
    "<header><h1>Guestbook</h1><p class=\"lede\">Leave a line for whoever "
    "comes next.</p></header>"
    # signed.kata:5
    "{if (viewer == "") signed_k_5 (signed_k_9 viewer)}"
    # signed.kata:14
    "{if (flash != "") (signed_k_14 flash) ""}"
    # signed.kata:16
    "{if (viewer != "") (signed_k_16 form) ""}<ol class=\"entries\">"
    # signed.kata:23
    "{each (kata_items signatures) (e -> signed_k_23 removals e)}</ol>"
  ]
# in views, by kata/views
pub fn rendered node
  kata_shown (kata_at node "view") (kata_at node "locals")

fn kata_shown "door" kata_l
  heading = kata_at kata_l "heading"
  path = kata_at kata_l "path"
  button = kata_at kata_l "button"
  name = kata_at kata_l "name"
  problems = kata_at kata_l "problems"
  remembers = kata_at kata_l "remembers"
  door_keyed heading path button name problems remembers

fn kata_shown "layout" kata_l
  title = kata_at kata_l "title"
  body = kata_at kata_l "body"
  layout_keyed title body

fn kata_shown "signed" kata_l
  signatures = kata_at kata_l "signatures"
  form = kata_at kata_l "form"
  flash = kata_at kata_l "flash"
  removals = kata_at kata_l "removals"
  viewer = kata_at kata_l "viewer"
  signed_keyed signatures form flash removals viewer

fn kata_shown _ _
  ""
# in views, by kata/views
pub fn door_view heading path button name problems remembers
  kata_locals = {
    "button":button
    "heading":heading
    "name":name
    "path":path
    "problems":problems
    "remembers":remembers
  }
  { "locals":kata_locals "view":"door" }
# in views, by kata/views
pub fn layout_view title body
  kata_locals = { "body":body "title":title }
  { "locals":kata_locals "view":"layout" }
# in views, by kata/views
fn signed_view_signatures_each x
  { "id":x.id "message":x.message "name":x.name }

fn signed_view_signatures xs
  list/to_list (list/map xs signed_view_signatures_each)

fn signed_view_form x
  { "message":x.message "problems":x.problems }

pub fn signed_view signatures form flash removals viewer
  kata_locals = {
    "flash":flash
    "form":(signed_view_form form)
    "removals":removals
    "signatures":(signed_view_signatures signatures)
    "viewer":viewer
  }
  { "locals":kata_locals "view":"signed" }
# in views, by kata/views
pub fn answer req node
  answer_as req 200 node

pub fn answer_as req code node
  kata_answered req.headers["senro-view"] code node

fn kata_answered none code node
  page = ["content-type: text/html; charset=utf-8"]
  http/respond code page (rendered node)

fn kata_answered _ code node
  heard = [
    "cache-control: no-store"
    "content-type: application/json"
    "senro-view: 1"
  ]
  http/respond code heard (json/encode node)
schema = { "accounts":["id serial" "name text" "digest text"] "signatures":["id serial" "name text" "message text"] }    # models/tables
# in accounts, by models/tables
pub fn account_from row
  id = account_cell row["id"]
  name = account_cell row["name"]
  digest = account_cell row["digest"]
  account id name digest
# in accounts, by models/tables
fn account_cell none
  ""

fn account_cell v
  v
# in accounts, by models/tables
pub account_model = {
  "columns":["id" "name" "digest"]
  "create":create?
  "read":account_from
  "table":"accounts"
}
# in signatures, by models/tables
pub fn signature_from row
  id = signature_cell row["id"]
  name = signature_cell row["name"]
  message = signature_cell row["message"]
  signature id name message
# in signatures, by models/tables
fn signature_cell none
  ""

fn signature_cell v
  v
# in signatures, by models/tables
pub signature_model = {
  "columns":["id" "name" "message"]
  "create":create?
  "destroy":destroy?
  "problems":problems
  "read":signature_from
  "table":"signatures"
}
routes = { "DELETE /session":{ "action":session/destroy "id":"" } "GET /":{ "action":home/index "id":"" "open":true } "GET /accounts/new":{ "action":accounts/new "id":"" "open":true } "GET /entries":{ "action":entries/index "id":"" "open":true } "GET /session/new":{ "action":session/new "id":"" "open":true } "POST /accounts":{ "action":accounts/create "id":"" "open":true } "POST /entries":{ "action":entries/create "id":"" } "POST /session":{ "action":session/create "id":"" "limit":{ "count":10 "key":"session/create" "over":session/over_limit "within":180000 } "open":true } }    # routes/rest
