fn door_keyed heading path button name problems remembers
  joined [
    # door.kata:3
    "<header><h1>{escape heading}</h1><p class=\"lede\"><a href=\"/\">Back "
    # door.kata:6
    "to the book</a></p></header><form method=\"post\" action=\"{escape path}"
    "\"><input name=\"name\" placeholder=\"name\" required=\"required\" "
    # door.kata:7
    "value=\"{escape name}\">"
    # door.kata:8
    "{if (problems["name"] != none) (door_k_8 problems) ""}<input "
    "type=\"password\" name=\"password\" placeholder=\"password\" "
    "required=\"required\">"
    # door.kata:11
    "{if (problems["password"] != none) (door_k_11 problems) ""}"
    # door.kata:13, 17
    "{if remembers door_k_13 ""}<button>{escape button}</button></form>"
  ]
# in views, by kata/views
fn layout_keyed title body
  joined [
    "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta "
    "name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    # layout.kata:7
