fn signed_15 flash
  # signed.kata:16
  "<p class=\"flash\">{escape flash}</p>"

fn signed_20 form
  # signed.kata:21
  "<p class=\"problem\">{escape form.problems["message"]}</p>"

fn signed_17 form
  joined [
    "<form method=\"post\" action=\"/entries\" "
    "enctype=\"multipart/form-data\" class=\"sign\"><textarea "
    "name=\"message\" placeholder=\"say something\" required=\"required\">"
    # signed.kata:19
    "{escape form.message}</textarea>"
    # signed.kata:20
    "{if (form.problems["message"] != none) (signed_20 form) ""}<label><span>"
    "A photo, if you like</span><input type=\"file\" name=\"photo\" "
    "accept=\"image/*\"></label><button>Sign</button></form>"
