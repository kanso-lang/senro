# in removal, by kata/views
import "std/json"
import "std/list"
import "std/text"

fn escape none
  ""

fn escape x
  s = "{x}"
  amp = text/join (text/split s "&") "&amp;"
  lt = text/join (text/split amp "<") "&lt;"
  gt = text/join (text/split lt ">") "&gt;"
  quot = text/join (text/split gt "\"") "&quot;"
  text/join (text/split quot "'") "&#39;"

fn each xs f
  text/join (list/to_list (list/map xs f)) ""

fn joined parts
  text/join parts ""
# in removal, by kata/views
pub fn view_body id
  joined [
    # view.kata:2
    "<button data-on-click=\"removed\" aria-label=\"remove entry {escape id}"
    "\" class=\"remove\">×</button>"
  ]

pub fn view id
  kata_state = escape (json/encode id)
  kata_inside = view_body id
  kata_open = "<div data-component=\"removal\" data-runs=\"server\""
  "{kata_open} data-state=\"{kata_state}\">{kata_inside}</div>"
# in removal, by kata/views
pub fn act "removed" kata_given state
  removed kata_given.viewer kata_given.db state

pub fn act _ _ _
  none
# in views, by kata/views
import "std/json"
import "std/list"
import "std/net/http"
import "std/text"

fn escape none
  ""

fn escape x
  s = "{x}"
  amp = text/join (text/split s "&") "&amp;"
  lt = text/join (text/split amp "<") "&lt;"
  gt = text/join (text/split lt ">") "&gt;"
  quot = text/join (text/split gt "\"") "&quot;"
  text/join (text/split quot "'") "&#39;"

fn each xs f
  text/join (list/to_list (list/map xs f)) ""

fn joined parts
  text/join parts ""

fn kata_at none _
  ""

fn kata_at m k
  kata_present m[k]

fn kata_present none
  ""

fn kata_present v
  v

fn kata_items xs:[]some
  xs

fn kata_items _
  []

fn kata_raw none
  "<none>"

fn kata_raw node:map[string some]
  rendered node

fn kata_raw x
  "{x}"
# in views, by kata/views
fn door_8 problems
  # door.kata:9
  "<p class=\"problem\">{escape problems["name"]}</p>"

fn door_11 problems
  # door.kata:12
  "<p class=\"problem\">{escape problems["password"]}</p>"

door_13 = joined [
  "<label class=\"remember\"><input type=\"checkbox\" name=\"remember\" "
  "value=\"yes\">Keep me signed in</label>"
]

pub fn door heading path button name problems remembers
  joined [
    # door.kata:3
    "<header><h1>{escape heading}</h1><p class=\"lede\"><a href=\"/\">Back "
    # door.kata:6
    "to the book</a></p></header><form method=\"post\" action=\"{escape path}"
    "\"><input name=\"name\" placeholder=\"name\" required=\"required\" "
    # door.kata:7
    "value=\"{escape name}\">"
    # door.kata:8
    "{if (problems["name"] != none) (door_8 problems) ""}<input "
    "type=\"password\" name=\"password\" placeholder=\"password\" "
    "required=\"required\">"
    # door.kata:11
    "{if (problems["password"] != none) (door_11 problems) ""}"
    # door.kata:13, 17
    "{if remembers door_13 ""}<button>{escape button}</button></form>"
  ]
# in views, by kata/views
pub fn layout title body
  joined [
    "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta "
    "name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    # layout.kata:7
    "<title>{escape title}</title><link rel=\"stylesheet\" "
    "href=\"/site.css\"><script src=\"/senro.js\" defer=\"defer\"></script>"
    # layout.kata:12
    "</head><body><main>{body}</main></body></html>"
  ]
# in views, by kata/views
signed_5 = joined [
  "<nav class=\"door\"><a href=\"/session/new\">Sign in</a><a "
  "href=\"/accounts/new\">Make an account</a></nav>"
]

fn signed_9 viewer
  joined [
    "<form method=\"post\" action=\"/session\" class=\"out\"><input "
    "type=\"hidden\" name=\"_method\" value=\"DELETE\"><span>Signed in as "
    # signed.kata:12
    "{escape viewer}.</span><button>Sign out</button></form>"
  ]

fn signed_14 flash
  # signed.kata:15
  "<p class=\"flash\">{escape flash}</p>"

fn signed_19 form
  # signed.kata:20
  "<p class=\"problem\">{escape form.problems["message"]}</p>"

fn signed_16 form
  joined [
    "<form method=\"post\" action=\"/entries\" class=\"sign\"><textarea "
    "name=\"message\" placeholder=\"say something\" required=\"required\">"
    # signed.kata:18
    "{escape form.message}</textarea>"
    # signed.kata:19
    "{if (form.problems["message"] != none) (signed_19 form) ""}<button>"
    "Sign</button></form>"
  ]

fn signed_23 removals e
  joined [
    # signed.kata:25
    "<li><p class=\"message\">{escape e.message}</p><p class=\"who\">"
    # signed.kata:26, 27
    "{escape e.name}</p>{removals["{e.id}"]}</li>"
  ]

pub fn signed signatures form flash removals viewer
  joined [
    "<header><h1>Guestbook</h1><p class=\"lede\">Leave a line for whoever "
    # signed.kata:5
    "comes next.</p></header>{if (viewer == "") signed_5 (signed_9 viewer)}"
    # signed.kata:14
    "{if (flash != "") (signed_14 flash) ""}"
    # signed.kata:16
    "{if (viewer != "") (signed_16 form) ""}<ol class=\"entries\">"
    # signed.kata:23
    "{each signatures (e -> signed_23 removals e)}</ol>"
  ]
