import "../../../bots"
import "../../../web"
import "std/net/http"

pub without_sign_in = ["create"]

# Lets in a form that Turnstile says a person sent.
pub fn create req _
  bots/verified req (web/input req) .> (p -> effect (http/text_page (let_in p)))

fn let_in true
  "let in"

fn let_in false
  "turned away"
