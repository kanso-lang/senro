import "std/net"
import "std/net/http"
import "std/text"

# The answer to this request is the answer to another one, asked of the same
# server while this one waits. A server that answers one connection at a time
# never gets to the second.
pub fn index _ _
  net/dial "127.0.0.1" 24401 .> asked

fn asked c
  net/write c asking .> (_ -> net/read c) .> (raw -> told c raw)

asking = "GET /plain HTTP/1.1\r\nhost: localhost\r\n\r\n"

fn told c raw
  net/close_conn c .> (_ -> effect (http/text_page "nested saw {body raw}"))

fn body raw
  parts = text/split raw "\r\n\r\n"
  return "" if length parts < 2
  parts[2]
