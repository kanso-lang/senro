import "../../../data"
import "../../../pg"
import "../../../routes"
import "../../../web"
import "./books"
import "./desk"
import "./home"
import "./ledger"
import "./nested"
import "./session"

derive data/providers
derive routes/rest

connected = pg/connect "127.0.0.1" 54329 "postgres" "postgres" ""

answering = web/providers routes session/secret books/provided

guarded = web/requiring_sign_in answering session/secret web/unbound

web/serve 24420 guarded connected
