import "std/list"
import "std/net"
import "std/net/http"
import "std/text"

# Four visitors behind the proxy, each knocking once on a door that lets one
# client in twice a minute and every client together three times. The first
# three are let in; the fourth, who never knocked before, is turned away by
# the limit they share.
pub fn index _ _
  two = (a -> knocked "203.0.113.2" .> (b -> effect [a b]))
  first = knocked "203.0.113.1" .> two
  first .> (xs -> knocked "203.0.113.3" .> (c -> fourth (push xs c)))

fn fourth xs
  knocked "203.0.113.4" .> (d -> said (push xs d))

fn knocked who
  net/dial "127.0.0.1" 24425 .> (c -> knocking c who)

fn knocking c who
  claimed = "x-forwarded-for: 10.9.9.9, {who}"
  head = "POST /door HTTP/1.1\r\nhost: localhost\r\n{claimed}"
  net/write c "{head}\r\ncontent-length: 0\r\n\r\n"
    .> (_ -> net/read c)
    .> (raw -> net/close_conn c .> (_ -> effect raw))

fn said answers
  lines = text/join (list/to_list (list/map answers heard)) "\n"
  effect (http/text_page lines)

fn heard raw
  "{status raw}: {body raw}"

fn status raw
  (text/split raw "\r\n")[1]

fn body raw
  parts = text/split raw "\r\n\r\n"
  return "" if length parts < 2
  text/trim parts[2]
