import "std/list"
import "std/net"
import "std/net/http"
import "std/text"

# Two visitors behind the proxy in front of the app, which reaches it from
# this machine and names each in `x-forwarded-for`, after any address the
# visitor claimed. The door lets a client in twice a minute: the first
# visitor knocks three times and is turned away on the third, and the
# second, knocking once, is let in and named. Without the proxy's address
# both are 127.0.0.1 and the second is turned away.
pub fn index _ _
  third = (a b -> knocked one .> (c -> effect [a b c]))
  ones = knocked one .> (a -> knocked one .> (b -> third a b))
  ones .> (xs -> knocked "203.0.113.2" .> (d -> said (push xs d)))

one = "203.0.113.1"

fn knocked who
  net/dial "127.0.0.1" 24424 .> (c -> knocking c who)

fn knocking c who
  claimed = "x-forwarded-for: 10.9.9.9, {who}"
  head = "POST /door HTTP/1.1\r\nhost: localhost\r\n{claimed}"
  net/write c "{head}\r\ncontent-length: 0\r\n\r\n"
    .> (_ -> net/read c)
    .> (raw -> net/close_conn c .> (_ -> effect raw))

fn said answers
  lines = text/join (list/to_list (list/map answers heard)) "\n"
  effect (http/text_page lines)

fn heard raw
  "{status raw}: {body raw}"

fn status raw
  (text/split raw "\r\n")[1]

fn body raw
  parts = text/split raw "\r\n\r\n"
  return "" if length parts < 2
  text/trim parts[2]
