import "std/list"
import "std/net"
import "std/net/http"
import "std/text"
import "std/time"

pub without_sign_in = ["index"]

# Ada signs in to a session that ends after three seconds with no request.
# A request at once reads her and sets nothing. One a second and a half
# later reads her and moves the session's last moment on, so one two
# seconds after that, three and a half since she signed in, still reads
# her. Then she is quiet for four seconds, and the next request is sent to
# sign in.
pub fn index _ _
  asked "POST" "/session" "" ""
    .> (a -> asked "GET" "/notes" (cookie_of a) "" .> (b -> paused a b))

fn paused a b
  time/sleep 1500
    .> (_ -> asked "GET" "/notes" (cookie_of a) "")
    .> (c -> longer a b c)

fn longer a b c
  time/sleep 2000
    .> (_ -> asked "GET" "/notes" (jar (cookie_of a) c) "")
    .> (d -> quiet a b c d)

fn quiet a b c d
  held = jar (jar (cookie_of a) c) d
  time/sleep 4000
    .> (_ -> asked "GET" "/notes" held "")
    .> (e -> said [a b c d e])

# The cookie a browser sends after the answer `raw`: the one it set, or the
# one it held before when the answer sets none.
fn jar held raw
  return held if length (set_lines raw) == 0
  cookie_of raw

fn asked method path cookie form
  net/dial "127.0.0.1" 24421 .> (c -> sent c method path cookie form)

fn sent c method path cookie form
  head = "{method} {path} HTTP/1.1\r\nhost: localhost{carried cookie}"
  sized = "content-length: {length (text/bytes form)}"
  net/write c "{head}\r\n{sized}\r\n\r\n{form}"
    .> (_ -> net/read c)
    .> (raw -> net/close_conn c .> (_ -> effect raw))

fn carried ""
  ""

fn carried cookie
  "\r\ncookie: {cookie}"

fn cookie_of raw
  set = set_lines raw
  return "" if length set == 0
  line = or_empty set[1]
  value = or_empty (text/slice line 13 (length line))
  or_empty (text/split value ";")[1]

fn set_lines raw
  list/to_list (list/select (lines raw) (l -> starts? l "set-cookie: "))

fn said answers
  told = text/join (list/to_list (list/map answers heard)) "\n"
  effect (http/text_page told)

fn heard raw
  status = (lines raw)[1]
  sets = if (length (set_lines raw) > 0) ", setting a session" ""
  moved = list/to_list (list/select (lines raw) (l -> starts? l "location: "))
  return "{status}{sets}: {body raw}" if length moved == 0
  where = or_empty moved[1]
  "{status}{sets} to {text/slice where 11 (length where)}"

fn lines raw
  text/split (or_empty (text/split raw "\r\n\r\n")[1]) "\r\n"

fn or_empty none
  ""

fn or_empty s
  s

fn starts? l prefix
  text/starts_with? (text/lowercase l) prefix

fn body raw
  parts = text/split raw "\r\n\r\n"
  return "" if length parts < 2
  text/trim parts[2]
