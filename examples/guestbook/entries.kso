import "../../pg"
import "../../web"
import "./views"
import "std/list"
import "std/net/http"

# A signature as the `signatures` table stores it. senro/models checks each
# field against the table's columns and writes `signature_from`, which builds
# one from a row.
pub type signature
  name
  message

# The session remembers who signed last, to fill in the form for them, and
# carries a thank-you across the redirect that follows a signature; the page
# that shows the thank-you clears it.
pub fn index req db
  s = web/session req secret
  pg/query db newest [] .> (r -> shown r.rows s)

# A development secret. A deployed guestbook signs its sessions with its own.
secret = "the guestbook's development secret"

# The form's two fields go to Postgres as parameters, so what a visitor
# types is stored as text and never read as SQL. The answer sends the browser
# back to the list, so reloading it does not sign the book again.
pub fn create req db
  f = web/form req.body
  name = web/value f "name"
  s = put (web/session req secret) "name" name
  thanked = put s "flash" "Thank you for signing, {name}."
  back = web/kept (web/redirect "/") secret thanked
  pg/query db added [name (web/value f "message")] .> (_ -> effect back)

added = "insert into signatures (name, message) values ($1, $2)"

newest = "select name, message from signatures order by id desc"

fn shown rows s
  signed = list/to_list (list/map rows signature_from)
  page = views/signed signed (said s["name"]) (said s["flash"])
  r = http/html_page (views/layout "Guestbook" page)
  effect (web/kept r secret (put s "flash" ""))

fn said none
  ""

fn said v
  v
