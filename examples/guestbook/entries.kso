import "../../models"
import "../../pg"
import "../../web"
import "./views"
import "std/list"
import "std/net/http"

# A signature as the `signatures` table stores it. senro/models checks each
# field against the table's columns.
pub type signature
  name
  message

pub fn index _ db
  listed db

# The form's two fields go to Postgres as parameters, so what a visitor
# types is stored as text and never read as SQL. The answer sends the browser
# back to the list, so reloading it does not sign the book again.
pub fn create req db
  f = web/form req.body
  wanted = [(web/value f "name") (web/value f "message")]
  pg/query db added wanted .> (_ -> effect (web/redirect "/"))

added = "insert into signatures (name, message) values ($1, $2)"

fn listed db
  pg/query db newest [] .> (r -> shown r.rows)

newest = "select name, message from signatures order by id desc"

fn shown rows
  signed = list/to_list (list/map rows signature_of)
  http/html_page (views/layout "Guestbook" (views/signed signed))

fn signature_of row
  signature (models/cell row "name") (models/cell row "message")
