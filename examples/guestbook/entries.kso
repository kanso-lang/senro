import "../../models"
import "../../pg"
import "../../web"
import "./removal"
import "./signatures"
import "./views"
import "std/list"

# What the form shows: the name and message it holds, and the problem with
# each, if any.
type filled
  name
  message
  problems

# The session remembers who signed last, to fill in the form for them, and
# carries a thank-you across the redirect that follows a signature; the page
# that shows the thank-you clears it.
pub fn index req db
  s = web/session req secret
  form = filled (said s["name"]) "" {}
  pg/query db newest [] .> (r -> shown req r.rows s form 200)

# A development secret. A deployed guestbook signs its sessions with its own.
pub secret = "the guestbook's development secret"

# A signature is made through its model, whose rules decide whether it is
# fit to keep; the two fields go to Postgres as parameters, so what a visitor
# types is stored as text and never read as SQL.
pub fn create req db
  f = web/form req.body
  viewer = web/viewer req secret
  models/created viewer db signatures/signature_model f
    .> (w -> signed req db w)

# A signature the rules turned back: the page again, answered 422, with the
# form as the visitor filled it in and what to fix.
fn signed req db w:models/invalid
  s = web/session req secret
  form = filled w.record.name w.record.message w.problems
  pg/query db newest [] .> (r -> shown req r.rows s form 422)

# A signature kept. The answer sends the browser back to the list, so
# reloading it does not sign the book again. Signing signs the visitor in
# under the name they signed with, which is what lets them remove their own
# entries.
fn signed req _ kept
  name = kept.name
  s = put (web/session req secret) "name" name
  thanked = put s "flash" "Thank you for signing, {name}."
  effect (web/signed_in (web/redirect "/") secret thanked name)

newest = "select id, name, message from signatures order by id desc"

# The page goes out as HTML to a browser that asked for it, and as data to
# senro's page script, which renders it with the views compiled for the
# browser.
fn shown req rows s form code
  book = list/to_list (list/map rows signatures/signature_from)
  who = said s["viewer"]
  removals = list/fold book {} (m e -> put m "{e.id}" (removal_of e who))
  flash = said s["flash"]
  page = views/signed_view book form flash removals
  r = views/answer_as req code (views/layout_view "Guestbook" page)
  effect (web/kept r secret (put s "flash" ""))

# Each entry's remove button, drawn only for the person who signed it. The
# policy is what stops anyone else; the button is a convenience.
fn removal_of e who
  return "" if e.name != who
  removal/view e.id

fn said none
  ""

fn said v
  v
