import "../../passwords"
import "../../routes"
import "../../web"
import "./account"
import "./entries"
import "./views"

# One address may try the current password ten times in three minutes, as
# it may try to sign in.
pub rate_limits = { "update":"10 per 3 minutes" }

# The password of whoever is signed in, changed as Devise's registrations
# change it: a new one, given the current one. It is a singular resource,
# since a visitor only ever changes their own.
# The page says how often the account has signed in and where the sign-in
# before this one came from, so a holder can see one that was not theirs.
pub fn edit req db
  name = web/viewer req entries/secret
  account/find_by db "name" name
    .> (a -> effect (changing req {} 200 (arrivals a)))

fn arrivals none
  ""

fn arrivals a
  count = times "{a.sign_in_count}"
  at = a.last_sign_in_at
  return "You have signed in {count}." if at == ""
  from = a.last_sign_in_ip
  "You have signed in {count}. The time before this one was {at}, from {from}."

fn times "1"
  "once"

fn times n
  "{n} times"

# The current password must match, and the new one is eight characters or
# more. Changing it ends every other sign-in, since a sign-in rests on the
# digest, and this browser is signed in again on the new one so that it
# stays. The write goes through the model as the holder, whose policy lets
# an account's holder change it.
pub fn update req db
  f = web/input req
  name = web/viewer req entries/secret
  current = web/value f "current"
  password = web/value f "password"
  account/find_by db "name" name .> (a -> changed req db current password a)

fn changed _ _ _ _ none
  effect web/denied

fn changed req db current password a
  wrong = { "current":"That is not your password." }
  short = { "password":"Use eight characters or more." }
  right = passwords/matches? current a.digest
  return effect (changing req wrong 422 "") if not right
  return effect (changing req short 422 "") if length password < 8
  passwords/digested password
    .> (d -> account/update db a.id { "digest":d } .> (_ -> kept_on req a d))

fn kept_on req a digest
  s = web/session req entries/secret
  home = web/redirect (routes/path_to "home/index") "Your password is changed."
  effect (web/signed_in req home entries/secret s a.name digest)

pub fn over_limit req
  wait = { "current":"Too many tries. Try again in a few minutes." }
  effect (changing req wait 429 "")

fn changing req problems code seen
  page = views/account_view (routes/path_to "password/update") problems seen
  views/answer req code "Your account · Guestbook" page
