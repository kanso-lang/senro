import "../../passwords"
import "../../routes"
import "../../web"
import "./account"
import "./views"

# One address may try the current password ten times in three minutes, as
# it may try to sign in.
pub rate_limits = { "update":"10 per 3 minutes" }

# The password of whoever is signed in, changed as Devise's registrations
# change it: a new one, chosen by the guestbook, given the current one. It
# is a singular resource, since a visitor only ever changes their own.
# The page says how often the account has signed in and where the sign-in
# before this one came from, so a holder can see one that was not theirs.
pub fn edit req db
  name = web/viewer req
  account/find_by db "name" name
    .> (a -> effect (changing req {} 200 (arrivals a)))

fn arrivals none
  ""

fn arrivals a
  count = times "{a.sign_in_count}"
  at = a.last_sign_in_at
  return "You have signed in {count}." if at == ""
  from = a.last_sign_in_ip
  "You have signed in {count}. The time before this one was {at}, from {from}."

fn times "1"
  "once"

fn times n
  "{n} times"

# The current password must match, and the guestbook then chooses a new
# one and shows it once (kanso#2515). Changing it ends every other sign-in,
# since a sign-in rests on the digest, and this browser is signed in again
# on the new one so that it stays. The write goes through the model as the
# holder, whose policy lets an account's holder change it.
pub fn update req db
  current = web/value (web/input req) "current"
  name = web/viewer req
  account/find_by db "name" name .> (a -> changed req db current a)

fn changed _ _ _ none
  effect web/denied

fn changed req db current a
  wrong = { "current":"That is not your password." }
  right = passwords/matches? current a.digest
  return effect (changing req wrong 422 "") if not right
  passwords/chosen .> (p -> passwords/digested p .> (d -> set req db a d p))

fn set req db a digest password
  account/update db a.id { "digest":digest }
    .> (_ -> kept_on req a digest password)

fn kept_on req a digest password
  s = web/session req
  page = views/password_shown_view "Your new password" password changed_told
  shown = views/answer req 200 "Your new password · Guestbook" page
  effect (web/signed_in req shown s a.name digest)

changed_told = "Save this password in your password manager: it is shown once."

pub fn over_limit req
  wait = { "current":"Too many tries. Try again in a few minutes." }
  effect (changing req wait 429 "")

fn changing req problems code seen
  page = views/account_view (routes/path_to "password/update") problems seen
  views/answer req code "Your account · Guestbook" page
