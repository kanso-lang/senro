- locals signatures
header
  h1 Guestbook
  p.lede Leave a line for whoever comes next.
form method="post" action="/entries"
  input name="name" placeholder="your name" required="required"
  textarea name="message" placeholder="say something" required="required"
  button Sign
ol.entries
  - for e in signatures
    li
      p.message = e.message
      p.who = e.name
