takes signatures form flash removals
header
  h1 Guestbook
  p.lede Leave a line for whoever comes next.
if flash != ""
  p.flash = flash
form method="post" action="/entries"
  input name="name" placeholder="your name" required="required" value=form.name
  if form.problems["name"] != none
    p.problem = form.problems["name"]
  textarea name="message" placeholder="say something" required="required" = form.message
  if form.problems["message"] != none
    p.problem = form.problems["message"]
  button Sign
ol.entries
  for e in signatures
    li
      p.message = e.message
      p.who = e.name
      == removals["{e.id}"]
