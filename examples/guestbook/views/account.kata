takes path problems seen
header
  h1 Your account
  p.lede
    a href="/" Back to the book
if seen != ""
  p.seen = seen
form method="post" action=path
  input type="hidden" name="_method" value="PATCH"
  input type="password" name="current" placeholder="current password" required="required"
  if problems["current"] != none
    p.problem = problems["current"]
  input type="password" name="password" placeholder="new password" required="required"
  if problems["password"] != none
    p.problem = problems["password"]
  button Change it
