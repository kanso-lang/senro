takes heading path button name email problems asks remembers
header
  h1 = heading
  p.lede
    a href=(path_to "home/index") Back to the book
form method="post" action=path
  input name="name" placeholder="name" required="required" value=name
  if problems["name"] != none
    p.problem = problems["name"]
  if asks
    input type="email" name="email" placeholder="email, for a lost password" required="required" value=email
    if problems["email"] != none
      p.problem = problems["email"]
  input type="password" name="password" placeholder="password" required="required"
  if problems["password"] != none
    p.problem = problems["password"]
  if remembers
    label.remember
      input type="checkbox" name="remember" value="yes"
      | Keep me signed in
  button = button
if remembers
  p.forgot
    a href=(path_to "resets/new") Forgot your password?
