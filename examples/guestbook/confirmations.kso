import "../../models"
import "../../routes"
import "../../tokens"
import "../../web"
import "./account"
import "./account_mailer"
import "./views"
import "std/time"

# An account whose address a good token would confirm.
type unconfirmed
  id
  email

# The link in a confirmation mail leads here. Following it shows a button,
# and the button confirms the address: a GET changes nothing, so a mail
# scanner that fetches every link it sees confirms nobody. The `id` the
# member routes take is the token `account_mailer/confirmation` signed.
pub without_sign_in = ["edit" "update"]

pub fn edit req db id
  held req db id .> (a -> offered req id a)

fn offered _ _ none
  effect (web/redirect (routes/path_to "home/index") stale)

fn offered req id a
  effect (shown req id a.email)

stale = "That link has expired or was used. Sign in to have it sent again."

# Confirming stamps the account with the moment, which also retires the link:
# it was bound to the column being empty.
pub fn update req db id
  held req db id .> (a -> confirmed req db a)

fn confirmed _ _ none
  effect (web/redirect (routes/path_to "home/index") stale)

fn confirmed _ db a
  time/now
    .> (t -> account/update (models/as_app db) a.id { "confirmed":"{t}" })
    .> (_ -> effect (web/redirect home confirmed_notice))

confirmed_notice = "Your address is confirmed. Sign in with it."

# The account a token confirms now, or none when the token is no good for
# the account it names.
fn held req db token
  id = id_text (tokens/id_of token)
  confirms = (a t -> checked req token id a t)
  account/find db id .> (a -> time/now .> (t -> effect (confirms a t)))

fn checked _ _ _ none _
  none

fn checked req token id a t
  email = a.email
  good = account_mailer/confirms? req token email (said a.confirmed) t
  if good (unconfirmed id email) none

fn said none
  ""

fn said s
  s

fn id_text none
  "0"

fn id_text n
  "{n}"

fn shown req id email
  to = routes/path_to "confirmations/update" id
  page = views/confirm_offered_view to email
  views/answer req 200 "Confirm your address · Guestbook" page

# The book, where a visitor lands once the link has done its work.
home = routes/path_to "home/index"
