import "../../models"
import "../../passwords"
import "../../routes"
import "../../web"
import "./account"
import "./account_mailer"
import "./views"
import "std/io"
import "std/text"

# What a sign-up form asked for.
type signup
  name
  email

# Anyone may make an account.
pub without_sign_in = ["create" "new"]

pub fn new req _
  effect (opened req "" "" {} 200)

# An account needs a name and an address nobody holds. Nobody chooses a
# password: the guestbook chooses one and shows it once (kanso#2515). Both
# are looked up before the password is stretched, so a sign-up that cannot
# succeed costs no hashing.
pub fn create req db
  f = web/input req
  name = text/trim (web/value f "name")
  email = text/lowercase (text/trim (web/value f "email"))
  by_email = account/find_by db "email" email
  account/find_by db "name" name
    .> (n -> by_email .> (m -> joined req db (signup name email) n m))

fn joined req db asked by_name by_email
  name = asked.name
  email = asked.email
  taken = "That address has an account."
  found = models/problems [
    (models/rule "name" (name == "") "Choose a name.")
    (models/rule "name" (by_name != none) "That name is taken.")
    (models/email_address "email" email)
    (models/rule "email" (by_email != none) taken)
  ]
  return effect (opened req name email found 422) if models/problems? found
  fields = { "email":email "name":name }
  passwords/chosen
    .> (p -> passwords/digested p .> (d -> kept req db fields d p))

fn kept req db fields digest password
  account/create db (put fields "digest" digest)
    .> (w -> made req db w password)

# A new account is not signed in: its holder confirms the address first,
# through the link the mail carries, as Devise's `confirmable` asks. The
# page that answers shows the password the guestbook chose, the only time
# it is shown. A mail that cannot be queued is logged, as the worker logs
# one it cannot send, and the account can ask again by signing in.
fn made req db kept:account/account password
  account_mailer/confirmation req db kept.id kept.email
    .? (u -> io/write_err "guestbook: no confirmation mail: {u.reason}\n")
    .> (_ -> effect (shown req kept.name password))

fn made _ _ _ _
  effect web/denied

fn shown req name password
  heading = "Welcome, {name}"
  page = views/password_shown_view heading password sent
  views/answer req 200 "Your password · Guestbook" page

sent = "{saved} Confirm your address with the link we sent, then sign in."

saved = "Save this password in your password manager: it is shown once."

# The sign-up form shows the name and address as typed and the problem with
# each field, if any.
fn opened req name email problems code
  heading = "Make an account"
  to = routes/path_to "registration/create"
  page = views/door_view heading to "Make it" name email problems true false
  views/answer req code "Make an account · Guestbook" page
