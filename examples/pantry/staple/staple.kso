import "../../../pg"

# Whether an item is a staple, one the pantry keeps stocked. The state is the
# item's id and its flag, and the action writes the flag to the database, so
# it runs on the server: it asks for a database session, which only the
# server has.
pub fn toggled db s
  next = put s "staple" (not staple? s["staple"])
  pg/query db marked ["{next["staple"]}" "{s["id"]}"] .> (_ -> effect next)

fn staple? none
  false

fn staple? true
  true

fn staple? _
  false

marked = "update items set staple = $1::boolean where id = $2::integer"
