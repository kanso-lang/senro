import "../../../models"
import "../../../web"
import "../item"

# Whether an item is a staple, one the pantry keeps stocked. The state is the
# item's id and its flag. The action asks for a database session, so it runs
# on the server, and it writes the flag through the item's model, whose
# policy decides whether the viewer the session asks for may.
pub fn toggled db s
  next = not staple? s["staple"]
  flagged db s["id"] next .> (w -> settled s next w)

# A state that names no item writes nothing, as a row that is not there.
fn flagged _ none _
  effect web/absent

fn flagged db id next
  item/update db id { "staple":"{next}" }

fn settled s next w
  if (models/refused? w) w (put s "staple" next)

fn staple? none
  false

fn staple? true
  true

fn staple? _
  false
