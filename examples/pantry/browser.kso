import "../../browser"
import "../../data"
import "../../kata"
import "../../models"
import "./item"
import "./migrations"
import "./planner"
import "./views"

# `models/tables` runs first: it declares `item` in item.kso, and a
# module's derived file is written in the order the derivations run, so the
# record goes ahead of the provider `data/providers` writes there.
derive models/tables
derive data/providers
derive kata/views

# The pantry's planner and its pages, compiled for the browser with
# `kanso build browser.kso --wasm`.
planned = browser/component planner/act planner/view

browser/answer_pages { "planner":planned } views/rendered
