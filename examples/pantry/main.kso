import "../../app"
import "../../pg"
import "../../web"
import "./home"
import "./item"
import "./items"
import "./migrations"
import "./planner"
import "./staple"
import "./views"

derive app/conventions

# The components whose actions run on the server. The planner runs in the
# browser, from browser.kso.
served = [staple/component]

# The planner asks the server for the staples the week runs short of, through
# the provider in item.kso.
answering = web/components routes served
served_with_data = web/providers answering item/provided

connected = pg/from_env

app/run "pantry" served_with_data connected derived
