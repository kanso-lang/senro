import "../../data"
import "../../kata"
import "../../models"
import "../../pg"
import "../../routes"
import "../../web"
import "./home"
import "./items"
import "./migrations"
import "./planner"
import "./staple"
import "./stock"
import "./views"

derive data/providers
derive kata/views
derive models/tables
derive routes/rest

# The pantry has no sign-in, so its sessions carry no viewer; a development
# secret signs them all the same.
secret = "the pantry's development secret"

# The components whose actions run on the server. The planner runs in the
# browser, from browser.kso.
served = { "staple":(web/component staple/act staple/view) }

# The planner asks the server for the staples the week runs short of, through
# the provider in stock.kso.
answering = web/components routes secret served
served_with_data = web/providers answering secret stock/provided

connected = pg/connect "127.0.0.1" 54329 "postgres" "postgres" ""

connected
  .> (db -> models/migrated db "pantry" migrations/all)
  .> (db -> models/compared db schema)
  .> (db -> pg/close db)
  .> (_ -> web/serve 3001 served_with_data connected)
