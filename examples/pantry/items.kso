import "../../models"
import "../../routes"
import "../../web"
import "./item"
import "./planner"
import "./staple"
import "./views"
import "std/list"
import "std/text"

pub fn index req db
  shelf req db ""

# The shelf with one item's name open for editing.
pub fn edit req db id:int
  shelf req db "{id}"

pub fn create req db
  name = web/value (web/input req) "name"
  item/create db { "name":name "quantity":"0" } .> (_ -> back)

# Two forms update an item: one renames it, and the plus and minus buttons
# send `by`, which moves its count and never below zero.
pub fn update req db id:int
  f = web/input req
  moved db id (web/value f "name") (text/to_int (web/value f "by"))

fn moved db id name none
  changed db id { "name":name }

fn moved db id _ by
  item/find db id .> (i -> stepped db id i by)

pub fn destroy _ db id:int
  item/destroy db id .> (_ -> back)

fn stepped _ _ none _
  back

fn stepped db id i by
  left = i.quantity + by
  changed db id { "quantity":"{if (left > 0) left 0}" }

fn changed db id changes
  item/update db id changes .> (_ -> back)

back = effect (web/redirect (routes/path_to "home/index"))

fn shelf req db editing
  item/all db .> (items -> shown req items editing)

# The shelf goes out as HTML to a browser that asked for it, and as data to
# senro's page script, which renders it with the views compiled for the
# browser.
fn shown req items editing
  total = list/fold items 0 (n i -> n + i.quantity)
  stars = list/fold items {} (m i -> put m "{i.id}" (starred i))
  plan = planner/view (planner/planned 3)
  page = views/shelf_view items editing total plan stars
  effect (views/answer req 200 "Pantry" page)

# Each item's staple star, a component whose state is the item's id and flag.
# senro/pg reads a boolean column as true or false.
fn starred i
  staple/view { "id":i.id "staple":i.staple }
