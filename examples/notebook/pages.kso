import "../../models"
import "../../routes"
import "../../web"
import "./note"
import "./page"
import "./views"
import "std/list"
import "std/net/http"

# A row of `pages` belongs to a note, so each action takes the note's id and
# the routes nest under it: `index` answers GET /notes/:note_id/pages. A row
# is found only under its own note, and a note that is not there has none to
# list or make.
pub fn index req db note_id:int
  number = models/page_number (web/value (web/query req) "page")
  asked = page/paged db "note_id" note_id number per_page
  listing_of = (p -> effect (listing req note_id p))
  within db note_id (asked .> listing_of)

# How many rows a page of the list shows.
per_page = 25

pub fn show req db note_id:int id:int
  under db note_id id .> (r -> effect (shown req r))

pub fn new req db note_id:int
  path = listed_path note_id
  within db note_id (effect (form req path "POST" blank {} 200))

pub fn create req db note_id:int
  given = put (picked (web/input req)) "note_id" "{note_id}"
  making = page/create db given
  made_of = (w -> effect (made req note_id w))
  within db note_id (making .> made_of)

pub fn edit req db note_id:int id:int
  under db note_id id .> (r -> effect (editing req note_id id r))

pub fn update req db note_id:int id:int
  given = picked (web/input req)
  under db note_id id
    .> (r -> updating db id given r)
    .> (w -> effect (changed req note_id id w))

pub fn destroy _ db note_id:int id:int
  under db note_id id
    .> (r -> removing db id r)
    .> (w -> effect (gone note_id w))

# `then` when the note is there, and a 404 when it is not.
fn within db id then
  note/find db id .> (found -> held found then)

fn held none _
  effect http/not_found

fn held _ then
  then

# The row with this id under this note, or none.
fn under db note_id id
  page/find db id .> (r -> effect (owned note_id r))

fn owned _ none
  none

fn owned note_id r
  if ("{r.note_id}" == "{note_id}") r none

# A write to a row under another note finds nothing.
fn updating _ _ _ none
  effect web/absent

fn updating db id given _
  page/update db id given

fn removing _ _ none
  effect web/absent

fn removing db id _
  page/destroy db id

fn listed_path note_id
  routes/path_to "pages/index" note_id

fn shown_path note_id id
  routes/path_to "pages/show" note_id id

fn listing req note_id p
  as_json = page/page_attributes
  mapped = list/to_list (list/map p.rows as_json)
  return web/json 200 mapped if web/wants_json? req
  page = views/pages_index_view note_id p.rows p.number p.more
  views/answer req 200 "Pages" page

fn shown _ none
  http/not_found

fn shown req record
  attributes = page/page_attributes record
  return web/json 200 attributes if web/wants_json? req
  page = views/pages_show_view record
  views/answer req 200 "Page" page

fn editing _ _ _ none
  http/not_found

fn editing req note_id id record
  form req (shown_path note_id id) "PATCH" (filled record) {} 200

fn made req note_id w:models/invalid
  path = listed_path note_id
  form req path "POST" (filled w.record) w.problems 422

fn made _ _ w:web/denied
  web/refusal w

fn made _ note_id w
  web/redirect (shown_path note_id w.id)

fn changed req note_id id w:models/invalid
  path = shown_path note_id id
  form req path "PATCH" (filled w.record) w.problems 422

fn changed _ _ _ w:web/denied
  web/refusal w

fn changed _ _ _ w:web/absent
  web/refusal w

fn changed _ note_id id _
  web/redirect (shown_path note_id id)

fn gone _ w:web/denied
  web/refusal w

fn gone _ w:web/absent
  web/refusal w

fn gone note_id _
  web/redirect (listed_path note_id)

# The form a page is made and changed with: its fields as typed, and the
# problem with each, if any.
fn form req path method fields problems code
  page = views/pages_form_view path method fields problems
  views/answer req code "Page" page

blank = { "body":"" }

fn filled r
  { "body":"{r.body}" }

fn picked f
  { "body":(web/value f "body") }
