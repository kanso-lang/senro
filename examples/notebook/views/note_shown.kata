takes row
header
  h1 Note {row.id}
  p.lede
    a href="/notes" All notes
dl
  dt title
  dd = row.title
  dt pages
  dd = row.pages
  dt cover
  dd
    if row.cover != ""
      a href="/senro/blobs/{row.cover}" open
p
  a href="/notes/{row.id}/edit" Edit
form method="post" action="/notes/{row.id}"
  input type="hidden" name="_method" value="DELETE"
  button Delete
