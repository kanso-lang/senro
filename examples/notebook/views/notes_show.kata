takes row
header
  h1 Note {row.id}
  p.lede
    a href=(path_to "notes/index") All notes
dl
  dt title
  dd = row.title
  dt pages
  dd = row.pages
  dt cover
  dd
    if row.cover != ""
      a href=(blob_path row.cover) open
p
  a href=(path_to "notes/edit" row.id) Edit
form method="post" action=(path_to "notes/destroy" row.id)
  input type="hidden" name="_method" value="DELETE"
  button Delete
