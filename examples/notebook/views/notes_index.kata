takes rows number more
header
  h1 Notes
  p.lede
    a href=(path_to "notes/new") New note
ul.notes
  each rows r ->
    li
      a href=(path_to "notes/show" r.id) = r.title
nav.pages
  if number > 1
    a href="?page={number - 1}" Previous page
  if more
    a href="?page={number + 1}" Next page
