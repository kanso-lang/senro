takes row
header
  h1 Page {row.id}
  p.lede
    a href=(path_to "pages/index" row.note_id) All pages
dl
  dt body
  dd = row.body
p
  a href=(path_to "pages/edit" row.note_id row.id) Edit
form method="post" action=(path_to "pages/destroy" row.note_id row.id)
  input type="hidden" name="_method" value="DELETE"
  button Delete
