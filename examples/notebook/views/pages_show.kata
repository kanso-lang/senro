takes row
p.mb-2
  a.text-secondary href=(path_to "pages/index" row.note_id) All pages
h1.mb-4 Page {row.id}
dl.row.mb-4
  dt.col-sm-3.text-secondary body
  dd.col-sm-9 = row.body
div.d-flex.gap-2
  a.btn.btn-outline-secondary href=(path_to "pages/edit" row.note_id row.id) Edit
  form method="post" action=(path_to "pages/destroy" row.note_id row.id)
    input type="hidden" name="_method" value="DELETE"
    button.btn.btn-link.text-secondary Delete
