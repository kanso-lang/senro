import "../../models"
import "../../web"
import "./note"
import "./views"
import "std/list"
import "std/net/http"

pub fn index req db
  number = models/page_number (web/value (web/query req) "page")
  note/paged db number per_page .> (p -> effect (listing req p))

# How many rows a page of the list shows.
per_page = 25

pub fn show req db id:int
  note/find db id .> (r -> effect (shown req r))

pub fn new req _
  effect (form req "/notes" "POST" blank {} 200)

pub fn create req db
  given = sent (web/form req.body)
  note/create db given .> (w -> effect (made req w))

pub fn edit req db id:int
  note/find db id .> (r -> effect (editing req id r))

pub fn update req db id:int
  given = picked (web/form req.body)
  note/update db id given .> (w -> effect (changed req id w))

pub fn destroy _ db id:int
  note/destroy db id .> (w -> effect (gone w))

fn listing req p
  as_json = note/note_attributes
  mapped = list/to_list (list/map p.rows as_json)
  return web/json 200 mapped if web/wants_json? req
  page = views/notes_index_view p.rows p.number p.more
  views/answer_as req 200 (views/layout_view "Notes" page)

fn shown _ none
  http/not_found

fn shown req record
  attributes = note/note_attributes record
  return web/json 200 attributes if web/wants_json? req
  page = views/notes_show_view record
  views/answer_as req 200 (views/layout_view "Note" page)

fn editing _ _ none
  http/not_found

fn editing req id record
  form req "/notes/{id}" "PATCH" (filled record) {} 200

fn made req w:models/invalid
  form req "/notes" "POST" (filled w.record) w.problems 422

fn made _ w:web/denied
  web/refusal w

fn made _ w
  web/redirect "/notes/{w.id}"

fn changed req id w:models/invalid
  form req "/notes/{id}" "PATCH" (filled w.record) w.problems 422

fn changed _ _ w:web/denied
  web/refusal w

fn changed _ _ w:web/absent
  web/refusal w

fn changed _ id _
  web/redirect "/notes/{id}"

fn gone w:web/denied
  web/refusal w

fn gone w:web/absent
  web/refusal w

fn gone _
  web/redirect "/notes"

# The form a note is made and changed with: its fields as typed, and the
# problem with each, if any.
fn form req path method fields problems code
  page = views/notes_form_view path method fields problems
  views/answer_as req code (views/layout_view "Note" page)

blank = { "cover":"" "pages":"" "title":"" }

fn filled r
  { "cover":"{r.cover}" "pages":"{r.pages}" "title":"{r.title}" }

fn picked f
  without_empty_files (sent f) ["cover"]

fn sent f
  {
    "cover":(web/value f "cover")
    "pages":(web/value f "pages")
    "title":(web/value f "title")
  }

fn without_empty_files given names
  list/fold names given (m n -> if (m[n] == "") (delete m n) m)
