import "../../app"
import "../../pg"
import "../../web"
import "./home"
import "./migrations"
import "./note"
import "./notes"
import "./page"
import "./pages"
import "./reading"
import "./readings"
import "./registration"
import "./resets"
import "./session"
import "./user"
import "./views"

derive app/conventions

# The database comes from PGHOST, PGPORT, PGUSER, PGDATABASE and
# PGPASSWORD, as libpq reads them, so the app runs wherever its host
# sets them.
connected = pg/from_env

# Every action asks for a sign-in unless its module lists it in
# `without_sign_in`.
signed = web/requiring_sign_in routes session/secret session/signed_against

app/run "notebook" signed connected derived
