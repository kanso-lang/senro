import "../../jobs"
import "../../kata"
import "../../mail"
import "../../models"
import "../../pg"
import "../../routes"
import "../../web"
import "./home"
import "./migrations"
import "./note"
import "./notes"
import "./page"
import "./pages"
import "./registration"
import "./resets"
import "./session"
import "./user"
import "./views"

derive jobs/performers
derive kata/views
derive models/tables
derive routes/rest

# The database comes from PGHOST, PGPORT, PGUSER, PGDATABASE and
# PGPASSWORD, as libpq reads them, so the app runs wherever its host
# sets them.
connected = pg/from_env

# Every action asks for a sign-in unless its module lists it in
# `without_sign_in`.
signed = web/requiring_sign_in routes session/secret session/signed_against

# Two workers run beside the server. One sends the mail the app queues,
# and the other does the jobs its `_job` modules perform.
serving = web/serve 3000 signed connected

working = jobs/beside connected jobs/default_queue performers serving

connected
  .> (db -> models/migrated db "notebook" migrations/all)
  .> (db -> models/compared db schema)
  .> (db -> pg/close db)
  .> (_ -> jobs/beside connected "mail" mail/performers working)
