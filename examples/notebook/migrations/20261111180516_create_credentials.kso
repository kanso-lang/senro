import "../../../models"

pub create_credentials = [
  credentials_table
  (models/add_foreign_key "credentials" "user_id" "users")
  (models/add_unique_index "credentials" "key_id")
]

credentials_table = models/create_table "credentials" [
  (models/column "user_id" "integer not null")
  (models/column "key_id" "text")
  (models/column "x" "text")
  (models/column "y" "text")
  (models/column "counter" "integer")
]
