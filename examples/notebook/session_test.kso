import "../../jobs"
import "../../models"
import "../../visit"
import "./credential"
import "./unconfirmed_job"
import "./user"
import "std/expect"
import "std/list"
import "std/spec"
import "std/text"

# A visit just after making an account: the address, and the password the
# page showed.
type newcomer
  visit
  email
  password

# Signing in, asked for as a browser asks. `signed` is the app as the entry
# serves it, with the sign-in requirement around its routes, so an example
# meets the door a visitor meets. A visit keeps the cookies the app sets:
# the examples under "with an account" begin signed in, since `joined` makes
# the account, follows the link mailed to confirm its address, and signs in.
# The app chooses each password and shows it once, so an example reads it
# from the page that made the account.
test_signing_in = describe "signing in" [
  around (visit/within signed connected)
  it "is asked of a stranger" turned_back
  it "waits for the address to be confirmed" held_back
  it "is not begun by a program that fills every field" trapped
  it "is begun again at an address nobody confirmed for a day" lapsed
  it "is begun again there when that account held a passkey" lapsed_keyed
  context "with an account" [
    before joined
    it "opens the app" opened
    it "is over once the visitor signs out" over
    it "takes the address and password again" returned
    it "refuses a wrong password" refused
    it "is kept once its first day is out" kept
  ]
]

fn turned_back v
  visit/get v "/" .> (v -> effect (expect (visit/location v) . to (equal door)))

# The sign-up form's hidden field, filled as a program fills every field:
# no account is made, so nothing is mailed.
fn trapped v
  visit/post v "/registration" { "email":address "website":"spam.example" }
    .> (v -> visit/mailed v)
    .> (letters -> effect (expect (length letters) . to (equal 0)))

# An account nobody confirms is removed by the job its sign-up queued for a
# day later, and the address can make an account again.
fn lapsed v
  signed_up v address
    .> (m -> day_out m.visit)
    .> (v -> visit/post v "/registration" { "email":address })
    .> (v -> effect (expect v.status . to (equal 200)))

# Its passkeys go with it.
fn lapsed_keyed v
  signed_up v address
    .> (m -> user/find_by m.visit.db "email" address .> (u -> keyed m.visit u))
    .> (v -> day_out v)
    .> (v -> visit/post v "/registration" { "email":address })
    .> (v -> effect (expect v.status . to (equal 200)))

fn keyed v u
  key = { "counter":"0" "key_id":"k" "user_id":"{u.id}" "x":"x" "y":"y" }
  credential/create (models/as_app v.db) key
    .> (_ -> credential/count_of v.db "user_id" u.id)
    .> (n -> held_one v n)

fn held_one v 1
  effect v

fn held_one _ n
  err "the account holds {n} passkeys"

# A confirmed account outlasts that job: its address is still held.
fn kept v
  day_out v
    .> (v -> visit/post v "/registration" { "email":address })
    .> (v -> effect (expect v.status . to (equal 422)))

# The jobs the visit queued, each run as the worker runs it once its day is
# out.
fn day_out v
  jobs/queued_on v.db jobs/default_queue .> (queued -> ran v queued)

fn ran v queued
  return effect v if length queued == 0
  rest = list/to_list (list/drop queued 1)
  unconfirmed_job/perform v.db queued[1] .> (_ -> ran v rest)

fn held_back v
  signed_up v address
    .> (m -> visit/post m.visit "/session" (account_of m))
    .> (v -> effect (expect v.status . to (equal 403)))

fn joined v
  signed_up v address .> signed_in

fn signed_up v email
  visit/post v "/registration" { "email":email }
    .> (v -> effect (newcomer v email (shown_password v.body)))

fn signed_in m
  visit/mailed m.visit
    .> (letters -> confirmed m.visit (list/find letters (l -> l.to == m.email)))
    .> (v -> visit/post v "/session" (account_of m))

fn account_of m
  { "email":m.email "password":m.password }

fn shown_password body
  after = text/split body "<code class=\"password\">"
  return "" if length after < 2
  blank (list/first (text/split after[2] "</code>"))

fn blank none
  ""

fn blank s
  s

# The link opens a page with a button, and the button's form sends a PATCH
# to the same path without `/edit`.
fn confirmed _ none
  err "making the account mailed no link"

fn confirmed v letter
  visit/patch v (text/replace (visit/link_in letter) "/edit" "") {}

fn opened v
  visit/get v "/" .> (v -> effect (expect v.status . to (equal 200)))

fn over v
  visit/remove v "/session"
    .> (v -> visit/get v "/")
    .> (v -> effect (expect (visit/location v) . to (equal door)))

# A second account, made, confirmed and signed in, then signed out and in
# again with the password its page showed.
fn returned v
  visit/remove v "/session"
    .> (v -> signed_up v other)
    .> (m -> signed_in m .> (v -> out_and_in v m))
    .> (v -> visit/get v "/")
    .> (v -> effect (expect v.status . to (equal 200)))

fn out_and_in v m
  again = { "email":m.email "password":m.password }
  visit/remove v "/session" .> (v -> visit/post v "/session" again)

fn refused v
  visit/remove v "/session"
    .> (v -> visit/post v "/session" mistaken)
    .> (v -> effect (expect v.status . to (equal 422)))

address = "ada@example.test"

other = "grace@example.test"

mistaken = { "email":address "password":"another password" }

door = "/session/new"
