import "../../bots"
import "../../jobs"
import "../../models"
import "../../passkeys"
import "../../passwords"
import "../../routes"
import "../../web"
import "./account_mailer"
import "./credential"
import "./user"
import "./views"
import "std/io"
import "std/text"
import "std/time"

# Anyone may make an account, as Devise's registerable lets them, and the
# registration is a singular resource: /registration/new and /registration.
pub without_sign_in = ["create" "new"]

# Each account made sends a letter, so one client makes at most ten an hour,
# told apart by its address (behind a proxy, the one the proxy names).
pub rate_limits = { "create":"10 per hour" }

# And every client together makes at most a hundred a day, so a swarm of
# addresses cannot send more letters than the mail account takes.
pub everyone_limits = { "create":"100 per day" }

# The form offers a passkey first (kanso#2515). `?with=password` offers a
# password instead, which the app chooses, for a visitor whose device has
# no authenticator.
pub fn new req _
  opened req "" {} 200

# An account needs an address nobody holds. With a passkey, the browser has
# already asked the authenticator, and the account is made with the key it
# answered, when the answer checks. Otherwise the app chooses a password,
# three words with a number and symbols, and shows it once. The address is
# looked up first, so a sign-up that cannot succeed costs no hashing.
#
# The form holds a field a person never sees, `website`. A program that
# fills every field fills it too, and is answered as if its account were
# made, with nothing made and nothing mailed. A program that leaves it
# alone still has to pass Turnstile (`bots`), when the app has its keys.
pub fn create req db
  f = web/input req
  return effect (made_with_key req) if web/value f "website" != ""
  email = text/lowercase (text/trim (web/value f "email"))
  bots/verified req f .> (person -> checked req db email f person)

fn checked req _ email _ false
  opened req email { "bot":not_a_person } 422

fn checked req db email f true
  user/find_by db "email" email
    .> (held -> joined req db email (held != none) f)

not_a_person = "We could not tell that a person sent this. Try again."

fn joined req db email taken f
  found = models/problems [
    (models/email_address "email" email)
    (models/rule "email" taken "That address has an account.")
  ]
  return opened req email found 422 if models/problems? found
  return keyed req db email f if web/value f "passkey_id" != ""
  passwords/chosen .> (p -> kept req db email p)

# The authenticator's answer, checked against the challenge the form was
# served with, which the session kept.
fn keyed req db email f
  asked = said (web/session req)["passkey"]
  client = field_bytes f "passkey_client"
  data = field_bytes f "passkey_data"
  passkeys/expected_for req asked
    .> (want -> effect (passkeys/registered want client data))
    .> (c -> with_key req db email c)

fn with_key req _ email r:passkeys/refusal
  told = { "passkey":"That passkey could not be used: {r.reason}." }
  opened req email told 422

fn with_key req db email c
  user/create db (fields_of email "") .> (w -> key_kept req db w c)

fn key_kept req db made:user/user c
  key = {
    "counter":"{c.counter}"
    "key_id":c.id
    "user_id":"{made.id}"
    "x":(passkeys/url_spelled c.x)
    "y":(passkeys/url_spelled c.y)
  }
  credential/create (models/as_app db) key
    .> (_ -> confirming req db made)
    .> (_ -> effect (made_with_key req))

fn key_kept _ _ _ _
  effect web/denied

fn made_with_key req
  heading = "Your account is made"
  page = views/account_made_view heading confirm_then_passkey
  views/answer req 200 heading page

confirm_then_passkey = "{mailed} Follow it, then sign in with your passkey."

mailed = "We have mailed you a link to confirm your address."

fn kept req db email password
  passwords/digested password
    .> (d -> user/create db (fields_of email d))
    .> (w -> made req db w password)

fn fields_of email digest
  { "digest":digest "email":email }

# A new account is mailed a link to confirm its address, and signs in once
# it has followed it, as Devise's confirmable asks. The page that answers
# shows the password the app chose, the only time it is shown.
fn made req db made:user/user password
  confirming req db made .> (_ -> effect (shown req password))

fn made _ _ _ _
  effect web/denied

fn confirming req db made
  removed_later db made .> (_ -> mailed_link req db made)

fn mailed_link req db made
  account_mailer/confirmation req db "{made.id}" made.email
    .? (u -> io/write_err "no confirmation mail: {u.reason}\n")

# An account nobody confirms is removed a day later (`unconfirmed_job`).
fn removed_later db made
  args = { "id":"{made.id}" }
  time/now .> (t -> jobs/perform_at db "unconfirmed" args (t + a_day))

# A day, in the milliseconds `time/now` counts.
a_day = 24 * 60 * 60 * 1000

fn shown req password
  heading = "Your account is made"
  page = views/password_shown_view heading password sent
  views/answer req 200 heading page

sent = """
  Save this password in your password manager: it is shown once. We have
  mailed you a link to confirm your address; follow it, then sign in.
"""

# The bytes a form field holds in base64url, as the page script sends an
# authenticator's answer, or none.
fn field_bytes f name
  or_empty (passkeys/url_read (web/value f name))

fn or_empty none
  []

fn or_empty bytes
  bytes

fn said none
  ""

fn said s
  s

# The sign-up form shows the address as typed and the problem with each
# field, if any. A password is never sent back. Each showing makes a new
# challenge for a passkey, kept in the session for the answer to match.
fn opened req email problems code
  passkeys/challenge
    .> (c -> bots/site_key .> (k -> offered req email problems code c k))

fn offered req email problems code c key
  pw = web/value (web/query req) "with" == "password"
  to = routes/path_to "registration/create"
  page = views/door_view to email problems "" false c pw key
  s = put (web/session req) "passkey" c
  effect (web/kept req (views/answer req code "Make an account" page) s)
