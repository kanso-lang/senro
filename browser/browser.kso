import "../data"
import "../wire"
import "std/json"
import "std/list"
import "std/os"
import "std/text"

# A component as `derive kata/views` records it in its module, which an app
# hands `answer` as `counter/component`: its name, the `act` that takes an
# action's name and the state and answers the next state, the view that
# renders a state, and the modules that lean on it.
type component
  name
  act
  view
  pages

# The page's script runs the app's browser module once for each event, and
# hands it the event in SENRO_EVENT as three lines: the component's name, the
# action's name and the state as the page holds it, its bytes in base64
# (`wire`). The module prints an empty line, then the component rendered in
# its next state, which holds that state in turn.
pub fn answer components
  named = by_name components
  os/env "SENRO_EVENT" .> (e -> print (heard named (said e)))

# A module that renders the app's pages as well, with the `rendered` that
# `derive kata/views` wrote for its views. A page arrives as an event with
# no component and no action, and its bytes, as the server sent them, in a
# file the page's script serves: `/senro/page`, or the file SENRO_PAGE names
# where a spec runs the module outside a browser. The module prints the page
# rendered, or nothing when the bytes are not a page of this app's.
pub fn answer_pages components rendered
  named = by_name components
  os/env "SENRO_EVENT" .> (e -> paged named rendered (said e))

fn by_name components
  list/fold components {} (acc c -> put acc c.name c)

fn paged components rendered event
  parts = text/split event "\n"
  page = length parts >= 3 and parts[1] == ""
  return print (heard components event) if not page
  os/env "SENRO_PAGE"
    .> (named -> os/read_bytes (page_at named))
    .> (bytes -> print (drawn rendered bytes))

fn page_at none
  "/senro/page"

fn page_at named
  named

fn drawn _ none
  ""

fn drawn _ _:os/file_not_found
  ""

fn drawn rendered bytes
  rendered bytes

fn heard components event
  answered components (text/split event "\n")

fn said none
  ""

fn said event
  event

fn answered components parts
  return "" if length parts < 3
  decoded components parts (held (wire/from_text (part parts 3)))

fn held none
  none

fn held bytes
  wire/unpacked bytes

# Text that is not a state's bytes is no state, and the component is left
# alone.
fn decoded _ _ none
  ""

fn decoded components parts state
  rounds = given_rounds (json/decode (part parts 4))
  found components[part parts 1] (part parts 2) state rounds

fn found none _ _ _
  ""

# An action that reads what only the server holds answers what it asks for
# instead of its next state (`data/ask`). The event's fourth line is the
# answers the page has had so far, one list for each round it sent, and the
# action is run through them. While it still asks, the module prints `?` and
# the calls, which the page sends to the server in one request. An answer's
# first line is empty otherwise, so the two cannot be confused.
fn found c action state rounds
  next = data/settled (c.act action state) rounds
  return "?\n{json/encode (data/calls_in next)}" if data/asking? next
  "\n{c.view next}"

fn given_rounds none
  []

fn given_rounds rounds:[]some
  rounds

fn given_rounds _
  []

fn part parts at
  given parts[at]

fn given none
  ""

fn given p
  p
